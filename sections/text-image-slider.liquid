{% style %}
  #shopify-section-{{ section.id }}{
    {% if section.settings.background_on == 'main_section' %}
      {% if section.settings.background_type == 'color'  %}
        background: {% if section.settings.background_gradient != blank%}{{section.settings.background_gradient}} {% else %} {{ section.settings.background_color }}{% endif %};
      {% elsif section.settings.background_type == 'image' and section.settings.background_image != blank %}
        background:{% if section.settings.background_gradient != blank%}{{section.settings.background_gradient}},{% endif %}url('{{ section.settings.background_image | image_url }}') no-repeat {{' '}}{{ section.settings.background_position }};
        background-size: {{ section.settings.background_size }};
      {% endif %};
    {% endif %};

    && .slick-dotted.slick-slider{
      margin-bottom:0;
    }
  }

  #shopify-section-{{ section.id }} .wrapper{
    color:{{ section.settings.content_color }};
    padding: {{ section.settings.section_padding }};
    margin: {{ section.settings.section_margin }};
    max-width:{{ section.settings.section_width }};
  {% if section.settings.background_on == 'content_part' %}
    {% if section.settings.background_type == 'color' and section.settings.background_color %}
      background: {{ section.settings.background_color }};
    {% elsif section.settings.background_type == 'image' and section.settings.background_image %}
      background: url('{{ section.settings.background_image  | image_url }}') no-repeat {{ section.settings.background_position }};
      background-size: {{ section.settings.background_size }};

    {% else %}
    ''
    {% endif %};
  {% endif %};
}



  @media(max-width:768px){
    #shopify-section-{{ section.id }} .wrapper.wrapper{
      padding: {% render 'mobile_spacing'  padding: section.setting.section_padding %};
    }
  }
{% endstyle %}

<div
  id="{{section.settings.custom_id}}"
  class="wrapper {{section.settings.custom_class}} text-image-slider p-4 flex items-center justify-center"
  style=""
>
  <div
    class="content-wrapper flex flex-col gap-32 items-center justify-center  sm:max-w-[100%!important] "
    style="width:100%; max-width: {{ section.settings.section_width }}; min-height: {{ section.settings.section_min_height }}"
  >
    <!-- Main Section Heading and Description -->
    {% if section.settings.main_heading != blank or section.settings.main_content != blank %}
      <div
        class="main-content mb-8 sm:max-w-[100%!important]"
        style="text-align: {{ section.settings.content_alignment }}; width:100%; max-width: {{ section.settings.content_part_width }}; "
      >
        <h2 class="text-tertiary">{{ section.settings.main_heading }}</h2>
        <p class="text-base mt-2">{{ section.settings.main_content }}</p>
      </div>
    {% endif %}

    <!-- Slides Container -->
    <div class="slider-container relative" id="slider-container-{{section.id }}" style="width:100%;">
      <!-- Slider Navigation -->
      <div
        class="prev nav-btn absolute z-[1] left-0 top-1/2 -translate-y-1/2"
      >
        <svg style="width:4rem; height:auto;" viewBox="0 0 42 43" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="21" cy="21.2656" r="21" fill="#68453D" fill-opacity="0.2"/>
          <path d="M24 27.2656L18 21.2656L24 15.2656" stroke="#68453D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div
        class="next nav-btn absolute z-[1] right-0 top-1/2 -translate-y-1/2"
      >
        <svg style="width:4rem; height:auto;" viewBox="0 0 42 43" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="21" cy="21" r="21" transform="matrix(-1 0 0 1 42 0.265625)" fill="#68453D" fill-opacity="0.2"/>
          <path d="M18 27.2656L24 21.2656L18 15.2656" stroke="#68453D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="slides slick-slider">
        {% for block in section.blocks %}
          <div
            class="
                slide items-center gap-20
              {% if block.settings.image_layout == 'left' %}
                 flex-row
              {% elsif block.settings.image_layout == 'right' %}
                  flex-row-reverse
              {% elsif block.settings.image_layout == 'top' %}
                   flex-col
              {% else %}
                    flex-col-reverse
              {% endif %}
                 sm:flex-col
            "
            style="display:flex!important;"
          >
            <!-- Slide Image -->
            <div class="slide-image flex-1">
              <img
                src="{{ block.settings.image | img_url: 'large' }}"
                alt="{{ block.settings.image.alt | default: block.settings.heading }}"
                class="w-full h-auto"
                width="558"
                height="400"
              >
            </div>

            <!-- Slide Content -->
            <div
              class="slide-content flex-1 text-center flex flex-col gap-6"
              style="text-align: {{ block.settings.slider_content_alignment }};"
            >
              <h2 class="text-tertiary ">{{ block.settings.heading }}</h2>
              <h3 class="tracking-[2%] richText" style="color:{{ section.settings.content_color }};">
                {{ block.settings.subheading }}
              </h3>
              <p class="text-base">{{ block.settings.paragraph }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% comment %}
  <!-- Slick JS -->
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
{% endcomment %}
<script defer type="text/javascript">
  document.addEventListener('DOMContentLoaded', function () {
    $('#slider-container-{{section.id }} .slides').slick({
      infinite: true,
      slidesToShow: 1,
      slidesToScroll: 1,
      arrows: true,
      prevArrow: $('#shopify-section-{{ section.id }} .prev'),
      nextArrow: $('#shopify-section-{{ section.id }} .next'),
      dots: true,
      draggable: true,
      autoplay: true,
      autoplaySpeed: 2000,
      speed: 500,
      useCSS: true,
      fade: true,
      cssEase: 'ease',
      pauseOnHover: true,
    });
  });
</script>

{% schema %}
{
  "name": "Text Image Slider",
  "class": "text-image-slider",
  "settings": [
    {
      "type": "header",
      "content": "Contents"
    },
    {
      "type": "richtext",
      "id": "main_heading",
      "label": "Section Heading"
    },
    {
      "type": "richtext",
      "id": "main_content",
      "label": "Section Description"
    },
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "text",
      "id": "content_part_width",
      "label": "Content Part Width"
    },
    {
      "type": "text",
      "id": "section_padding",
      "label": "Section Padding"
    },
    {
      "type": "text",
      "id": "section_margin",
      "label": "Section Margin"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    },
    {
      "type": "text",
      "id": "section_width",
      "label": "Section Width",
      "info": "eg: 50% | 50rem | 50px"
    },
    {
      "type": "text",
      "id": "section_min_height",
      "label": "Section Min Height"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background Type",
      "options": [
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content Color",
      "default": "#000"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "select",
      "id": "background_on",
      "label": "Choose Background on",
      "default": "content_part",
      "options": [
        {
          "value": "content_part",
          "label": "Content Part"
        },
        {
          "value": "main_section",
          "label": "Main Section"
        }
      ]
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background Position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "background_size",
      "label": "Background Size",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "richtext",
          "id": "paragraph",
          "label": "Paragraph"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_layout",
          "label": "Image Layout",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            },
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            }
          ]
        },
        {
          "type": "select",
          "id": "slider_content_alignment",
          "label": "Content Alignment",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text Image Slider"
    }
  ]
}
{% endschema %}
