                                                                      <content >
                                                                        <span class="font-sans bolder-500 text-[#000] text-[14px] font-medium">
                                                                          {{ grandchildlink.title | escape }}
                                                                        </span>
                                                                        <p class="font-sans font-normal text-[12px] ">
                                                                          {{ menuitem.settings[excerpt] }}
                                                                        </p>
                                                                      </content>
                                                                    </item>
                                                                  </a>
                                                                </li>
                                                              {% endcapture %}        
                                                              {%assign found = true %}
                                                              {% break %}        

                                                            {% else %}
                                                              {%  capture menuitem_element_icon %} 
                                                                <li>
                                                                  <a href="{{ grandchildlink.url }}" class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                                                    {{ grandchildlink.title | escape }}
                                                                  </a>
                                                                </li>
                                                              {% endcapture %}        
                                                            {% endif %}
                                                        {% endfor %}
                                                        {% else %}
                                                          {%  capture menuitem_element_icon %} 
                                                            <li>
                                                              <a href="{{ grandchildlink.url }}" class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                                                {{ grandchildlink.title | escape }}
                                                              </a>
                                                            </li>
                                                          {% endcapture %}
                                                      {% endcase %}
                                                      {% if found == true %}
                                                        {% break %}
                                                      {% endif %}
          
                                                    {% endfor %}
          
                                                    {{menuitem_element_icon}}
          
                                                  {%- endfor -%} {% endcomment %}
                                                  {% assign splitter = "[-]"%}
                                                  {% assign final_items = grandchildrenItems  | split: splitter  %} 
                                                  {{ final_items[forloop.index0] }}

                                              </ul>
                                            </div>
                                          </details>
                                        {%- endif -%}
                                      </li>
                                                  {% assign loopcounter = loopcounter | plus: 1 %}
                                    {%- endfor -%}
                                  {% endif %}
                                </ul>
                              </div>
                            </div>
                          </details>
                        {%- else -%}
                          <{% if link.url == "#coming-soon"  %}span{% else %}a href="{{ link.url }}"{% endif %} class="relative menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"{% if link.current %} aria-current="page"{% endif %}>
                            {{ link.title | escape }}
                            {% if link.url == "#coming-soon"  %}
                              <span style="font-size: 10px; top: -8px; left: 100%; width: max-content; color: red;" class="absolute">{{ link.url | remove: "#" | replace:'-', ' '}}</span>
                            {% endif %}
                          </{% if link.url == "#coming-soon"  %}span{% else %}a{% endif %}>
                        {%- endif -%}
