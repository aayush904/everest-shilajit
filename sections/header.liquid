{% assign isnavsliderStyle = true %}
{% assign mbimagesBlock = '' %}
{% assign mbproductBlock = '' %}
{% assign imagesBlock = '' %}
{% assign imageBlock = '' %}
{% assign productBlock = '' %}

<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-items.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-mega-menu.css' | asset_url | stylesheet_tag }}</noscript>
{%- endif -%}
{%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
  <link rel="stylesheet" href="{{ 'component-localization-form.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if settings.cart_type == "drawer" -%}
  <link rel="stylesheet" href="{{ 'component-cart-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'component-cart.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'component-totals.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'component-discounts.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<noscript>{{ 'component-search.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}</noscript>

{% style %}
  .mega-menu ul{
    padding-left:0;
  }
  
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  .mega-menu__link:hover {
    *{
    color:#9f5601;
  }
    img {
    filter: sepia(1) saturate(5) brightness(1.05);
  }
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 1024px) {
      header-drawer {
        display: none;
      }
      .js .menu-drawer__menu-item .icon-caret,
  .no-js .menu-drawer .icon-arrow {
    display: none;
  }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size:
  }

  .menu-drawer__menu li:not(.toplevel) {
    margin: 12px 0;
  }

  .menu-drawer__menu li:last-of-type {
    margin-bottom: 0;
  }


  .menu-drawer__menu.has-submenu .toplevel {
    padding-bottom:13px;
    padding-top:20px;
    border-bottom: 1px solid #372320;
    && summary, > a{
    font-weight:700;
  }}

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  .navslider-wrapper img{
    background:#E4E4E4;
  }
  
  @media screen and (min-width: 768px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  @media screen and (max-width: 767px) {
    .header {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      min-height: 8.6rem;
    }

    .header__heading,
    .header__heading-link {
      order: 1;
      justify-self: start;
      text-align: left;
    }

    .header__icons {
      order: 2;
      margin-left: auto;
      align-items: center;
    }

    header-drawer {
      order: 3;
      margin-left: 0;
    }

    .header__icons .header__icon--cart,
    .header__icon--account {
      display: none !important;
    }

    .section-header.menu-open .header__heading {
      display: none;
    }

    .section-header.menu-open .header__icons {
      order: 1;
      margin-left: 0;
      margin-right: auto;
    }

    .section-header.menu-open .header__icons .header__icon--search,
    .section-header.menu-open .header__icons .header__icon--account {
      display: none;
    }

    .section-header.menu-open .header__icons .header__icon--cart {
      display: flex !important;
    }

    .menu-drawer__account-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.8rem;
      background: #68453d;
      color: #fff;
      border-radius: 999px;
      padding: 1.4rem 2rem;
      margin: 2rem 0;
      text-decoration: none;
      font-weight: 600;
    }

    .menu-drawer__account-button .icon {
      width: 1.8rem;
      height: 1.8rem;
      fill: #fff;
      stroke: #fff;
    }

    {% if request.page_type == 'index' %}
      #MainContent > .shopify-section:first-child {
        margin-top: calc(-1 * var(--header-height, 8.6rem));
        position: relative;
        z-index: 0;
      }

      .section-header {
        z-index: 2;
      }

      .section-header:not(.scrolled-past-header) {
        background: transparent;
        border-bottom-color: transparent;
      }

      .section-header:not(.scrolled-past-header) .header__icon {
        color: #fff;
      }

      .section-header:not(.scrolled-past-header) .header__icon svg {
        stroke: #fff;
      }
    {% endif %}
  }
{% endstyle %}


{%- style -%}
  .header {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 768px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 1024px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
{%- if settings.cart_type == "drawer" -%}
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
  <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<svg xmlns="http://www.w3.org/2000/svg" class="hidden">
  <symbol id="icon-search" viewbox="0 0 18 19" fill="none">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm.26 1.12a6.78 6.78 0 11.72-.7l5.4 5.4a.5.5 0 11-.71.7l-5.41-5.4z" fill="currentColor"/>
  </symbol>

  <symbol id="icon-reset" class="icon icon-close"  fill="none" viewBox="0 0 18 18" stroke="currentColor">
    <circle r="8.5" cy="9" cx="9" stroke-opacity="0.2"/>
    <path d="M6.82972 6.82915L1.17193 1.17097" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
    <path d="M1.22896 6.88502L6.77288 1.11523" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
  </symbol>

  <symbol id="icon-close" class="icon icon-close" fill="none" viewBox="0 0 18 17">
    <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor">
  </symbol>
</svg>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

      
<{% if section.settings.sticky_header_type != 'none' %}sticky-header  data-sticky-type="{{ section.settings.sticky_header_type }}"{% else %}div{% endif %}  class="{% if request.page_type != 'index' %} block {% endif %}border-b border-[#D4CDCD]  color-{{ section.settings.color_scheme }} gradient  {% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  <header id="header_wrap_basmil" class="font-sans header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}">
    {%- if section.settings.menu != blank -%}
      <header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
        <details id="Details-menu-drawer-container" class="menu-drawer-container">
          <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
            <span>
              {% render 'icon-hamburger' %}
              {% render 'icon-close' %}
            </span>
          </summary>
          <div id="menu-drawer" class="gradient menu-drawer motion-reduce" tabindex="-1">
            <div class="menu-drawer__inner-container">
              <div class="menu-drawer__navigation-container">
                <nav class="menu-drawer__navigation">
                  <ul class="menu-drawer__menu has-submenu list-menu" role="list">
                    {%- for link in section.settings.menu.links -%}
                      <li class="toplevel">
                        {%- if link.links != blank -%}
                          <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                            <summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}">
                              {{ link.title | escape }}
                              {% comment %} {% render 'icon-arrow' %} {% endcomment %}
                              {% render 'icon-caret' %}
                            </summary>
                            
                            {% assign menuCounter = 0 %}
                            {%- for childlink in link.links -%}
                              {%- if childlink.links != blank -%}
                                {% assign menuCounter = menuCounter | plus: 1 %}
                              {%- endif -%}
                            {%- endfor -%}

                            <div id="link-{{ link.handle | escape }}" class="{% if menuCounter > 1 %} leftPadding {% endif %}menu-drawer__submenu has-submenu gradient motion-reduce" tabindex="-1">
                              <div class="menu-drawer__inner-submenu">
                                <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                  {% render 'icon-arrow' %}
                                  {{ link.title | escape }}
                                </button>

                                {% capture sliderstyle %}
                                  {% style %}
                                      nav-slider {
                                        display: block;
                                        position: relative;
                                        overflow: hidden;
                                      }

                                      nav-slider .slider-track {
                                        display: flex;
                                        transition: transform 0.5s ease;
                                        margin: 0 -1rem;
                                      }

                                      nav-slider .navslide {
                                        flex: 0 0 33.3333%;
                                        padding: 0 1.7rem;
                                        box-sizing: border-box;
                                        text-align: center;
                                      }

                                      nav-slider button {
                                        position: absolute;
                                        top: 50%;
                                        transform: translateY(-50%);
                                        background: #f5f2ec;
                                        color: #161616;
                                        border: none;
                                        font-size: 2rem;
                                        padding: 0.5rem 1rem;
                                        cursor: pointer;
                                        z-index: 10;
                                        border-radius: 50%;
                                        height: 38px;
                                        aspect-ratio: 1/1;
                                      }

                                      nav-slider .prev { left: 10px; }
                                      nav-slider .next { right: 10px; }
                                    {% endstyle %}
                                {% endcapture %}

                                {% capture mbimages_menu %}
                                  {% assign megagap = true%}

                                  {%  for block in section.blocks %}
                                      {% if block.settings.menu-title == link.title and block.type == "megamenu-images" %}
                                        {%  if mbimagesBlock != block.settings.menu-title %}
                                          {% assign total_slides = 3 %}
                                          <div class="flex flex-col gap-[3.2rem] scroll-container">
                                            {% comment %} {% if block.settings.image-title != blank %}
                                              <span style="margin:0;padding:0;" class="mega-menu__link mega-menu__link--level-2 link">{{block.settings.image-title}}</span>
                                            {% endif %} {% endcomment %}

                                            <{% if total_slides > 2 %}nav-slider{% else %}div{% endif %} style="gap:3.4rem;" class="navslider-wrapper {% if total_slides > 2 %}block{% else %}flex{% endif %} h-full items-end justify-between">
                                            {%  for i in (1..5) %}
                                              
                                                {% assign image = "image" | append: i %}
                                                {% assign title = "title" | append: i %}
                                                {% assign slidelink = "link" | append: i %}
                                                {% if  block.settings[image] != blank  %}
                                                  <{% if  block.settings[slidelink] !=blank %}a  href="{{  block.settings[slidelink] | default: 'javascript:void(0)'}}"{% else %}span{% endif %} class="navslide grid-item text-center flex flex-col gap-[0.8rem] w-full max-w-[calc(100%-0.4rem)]">
                                                    <img loading="lazy" src="{{ block.settings[image] | image_url }}" width="{{ block.settings[image].width }}" height="{{ block.settings[image].height }}" alt="{{ block.settings[image].alt }}" class="w-full h-auto aspect-square object-contain object-center mb-[0.4rem]"/>
                                                    <span class="capitalize text-start text-[2rem] leading-[1.3]  text-black">{{  block.settings[title] }}</span>
                                                  </{% if  block.settings[slidelink] %}a{% else %}span{% endif %}>
                                                {% endif %}
                                              {% endfor %}
                                            </{% if total_slides > 2 %}nav-slider{% else %}div{% endif %}>
                                          </div>
                                        {% endif %}
                                          {% assign mbimagesBlock = block.settings.menu-title %}
                                      {% endif %}
                                  {% endfor %}

                                  {%  if isnavsliderStyle == true and total_slides > 3 %}
                                    {{ sliderstyle }}
                                  {% assign isnavsliderStyle = false %}
                                  {% endif %}
                                {% endcapture %}


                                {% capture mbproduct_menu %}
                                  {% assign megagap = true%}

                                  {%  for block in section.blocks %}
                                      {% if block.settings.menu-title == link.title and block.type == "megamenu-product" %}
                                        {%  if mbproductBlock != block.settings.menu-title %}
                                          {% assign total_slides = collections[block.settings.collection].products.size %}
                                          
                                          <div class="flex flex-col gap-[3.2rem]">
                                            {% comment %} {% if block.settings.image-title != blank %}
                                              <span style="margin:0;padding:0;" class="mega-menu__link mega-menu__link--level-2 link">{{block.settings.image-title}}</span>
                                            {% endif %} {% endcomment %}
                                            <{% if total_slides > 3 %}nav-slider{% else %}div{% endif %} style="gap:3.4rem;" class="navslider-wrapper {% if total_slides > 3 %}block{% else %}flex{% endif %} h-full items-end justify-between">
                                            {%  for product in collections[block.settings.collection].products %}
                                                  <a  href="{{ product.url }}" class="navslide grid-item text-center flex flex-col gap-[0.8rem] w-full max-w-[calc(100%-0.4rem)]" style="flex: 0 0 {% if total_slides > 3 %}33.33% {% else %}calc(33.3333% - (2*3.4rem)){% endif %};">
                                                    <img loading="lazy" src="{{ product.featured_image | image_url }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" alt="{{ product.featured_image.alt | escape }}" class="w-full h-auto aspect-square object-contain object-center mb-[0.4rem]"/>
                                                    <span class="capitalize text-start text-[2rem] leading-[1.3]  text-black">{{ product.title }}</span>
                                                  </a>
                                              {% endfor %}
                                            </{% if total_slides > 3 %}nav-slider{% else %}div{% endif %}>
                                          </div>
                                        {% endif %}
                                          {% assign mbproductBlock = block.settings.menu-title %}
                                      {% endif %}
                                  {% endfor %}
                                  {%  if isnavsliderStyle == true and total_slides > 3 %}
                                    {{ sliderstyle }}
                                  {% assign isnavsliderStyle = false %}
                                  {% endif %}
                                {% endcapture %}

                                {% if megagap == true %}
                                  <style>
                                    .mega-menu-inages{
                                      gap:12.8rem;
                                    }

                                    @media(max-width:1480px){
                                      .mega-menu-inages{
                                        gap:6rem;
                                      }

                                      .mega-menu__list.max-w-1\/2{
                                      gap:16px!important;}
                                    }
                                  </style>
                                {%- endif -%}

                                <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">


                                  {% capture grandchildrenItems %}
                                    {%- for childlink in link.links -%}
                                      {%- for grandchildlink in childlink.links -%}
                                        {% for menuitem in section.blocks %}
                                          {% case menuitem.type %}
                                            {% when "menuitems-with-icons" %}
                                              {%assign found = false %}

                                              {% for i in (1..5) %}
                                                {%assign excerpt = "excerpt-" |  append: i %}
                                                {%assign title = "menu-title-" |  append: i %}
                                                {%assign image = "icon-" |  append: i %}
                                                {% if menuitem.settings[title] == grandchildlink.title %}
                                                  {%  capture menuitem_element_icon %} 
                                                    <li >
                                                      <{% if  grandchildlink.url == "#coming-soon"  %}span style="width:max-content;"{% else %}a href="{{  grandchildlink.url }}"{% endif %} 
                                                        class="relative menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                                      
                                                        <item class="flex font-sans" style="gap:10px;">
                                                          <img class="w-[4rem] h-[4rem] mr-[10px]" loading="lazy" src="{{ menuitem.settings[image] | image_url }}" width="{{ menuitem.settings[image].width }}" height="{{ menuitem.settings[image].height }}" alt="{{ menuitem.settings[image].alt }}" class="w-full h-auto aspect-[25/14.1] object-contain object-center mb-[0.8rem]"/>
                                                          <content >
                                                            <span class="font-sans bolder-500 text-[#000] text-[14px] font-medium">
                                                              {{ grandchildlink.title | escape }}
                                                            </span>
                                                            <p class="font-sans font-normal text-[12px] ">
                                                              {{ menuitem.settings[excerpt] }}
                                                            </p>
                                                          </content>
                                                        </item>
                                                        {% if grandchildlink.url == "#coming-soon"  %}
                                                          <span style="font-size: 10px; top: -8px; left: 100%; width: max-content; color: red;" class="absolute">{{ grandchildlink.url | remove: "#" | replace:'-', ' '}}</span>
                                                        {% endif %}
                                                      </{% if  grandchildlink.url == "#coming-soon"  %}span{% else %}a{% endif %}>
                                                    </li>
                                                  {% endcapture %}        
                                                  {%assign found = true %}
                                                  {% break %}        

                                                {% else %}
                                                  {%  capture menuitem_element_icon %} 
                                                    <li>
                                                      <{% if  grandchildlink.url == "#coming-soon"  %}span style="width:max-content;"{% else %}a href="{{  grandchildlink.url }}"{% endif %} class="relative menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                                      
                                                        {{ grandchildlink.title | escape }}
                                                        {% if grandchildlink.url == "#coming-soon"  %}
                                                          <span style="font-size: 10px; top: -8px; left: 100%; width: max-content; color: red;" class="absolute">{{ grandchildlink.url | remove: "#" | replace:'-', ' '}}</span>
                                                        {% endif %}
                                                      </{% if  grandchildlink.url == "#coming-soon"  %}span{% else %}a{% endif %}>
                                                    </li>
                                                  {% endcapture %}        
                                                {% endif %}
                                            {% endfor %}
                                            {% else %}
                                              {%  capture menuitem_element_icon %} 
                                                <li>
                                                  <{% if  grandchildlink.url == "#coming-soon"  %}span style="width:max-content;"{% else %}a href="{{  grandchildlink.url }}"{% endif %} class="relative menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                                  
                                                    {{ grandchildlink.title | escape }}
                                                    {% if grandchildlink.url == "#coming-soon"  %}
                                                      <span style="font-size: 10px; top: -8px; left: 100%; width: max-content; color: red;" class="capitalize absolute">{{ grandchildlink.url | remove: "#" | replace:'-', ' '}}</span>
                                                    {% endif %}
                                                  </{% if  grandchildlink.url == "#coming-soon"  %}span{% else %}a{% endif %}>
                                                </li>
                                              {% endcapture %}
                                          {% endcase %}
                                          {% if found == true %}
                                            {% break %}
                                          {% endif %}

                                        {% endfor %}

                                        {{menuitem_element_icon}}

                                      {%- endfor -%}
                                      {%- if menuCounter > 1 -%}[-]{% endif %}
                                    {%- endfor -%}
                                  {% endcapture %}
                                  {% if menuCounter == 1 %}
                                    {{ grandchildrenItems }}
                                    {% if mbimages_menu != blank %}
                                        <li class="menu-drawer__menu-item">{{mbimages_menu}}</li>
                                    {% endif %}
                                    
                                    {% if mbproduct_menu != blank %}
                                      <li class="menu-drawer__menu-item">{{mbproduct_menu}}</li>
                                    {% endif %}
                                  {% else %}
                                    {% assign loopcounter = 1 %}
                                    {%- for childlink in link.links -%}
                                      <li>
                                        {%- if childlink.links == blank -%}
                                          <{% if  childlink.url == "#coming-soon"  %}span style="width:max-content;"{% else %}a href="{{  childlink.url }}"{% endif %} class="relative menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                                            {{ childlink.title | escape }}
                                            
                                            {% if childlink.url == "#coming-soon"  %}
                                              <span style="font-size: 10px; top: -8px; left: 100%; width: max-content; color: red;" class="absolute">{{ childlink.url | remove: "#" | replace:'-', ' '}}</span>
                                            {% endif %}
                                          </{% if  childlink.url == "#coming-soon"  %}span{% else %}a{% endif %}>
                                        {%- else -%}
                                          <details id="Details-menu-drawer-submenu-{{ forloop.index }}">
                                            <summary class="menu-drawer__menu-item link link--text list-menu__item focus-inset">
                                              {{ childlink.title | escape }}
                                              {% render 'icon-arrow' %}
                                              {% render 'icon-caret' %}
                                            </summary>
                                            <div id="childlink-{{ childlink.handle | escape }}" class="menu-drawer__submenu has-submenu gradient motion-reduce">
