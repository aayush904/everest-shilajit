<script defer="defer">
  const toggleNavList = (selector) =>{
    document.querySelectorAll(selector).forEach(item => {
      const summary = item.querySelector('summary');

      summary.addEventListener('click', function (event) {
        event.preventDefault(); // Prevent default summary click behavior

        // Check if the clicked item is already open
        const isOpen = item.hasAttribute('open');

        // Close all details elements
        document.querySelectorAll(selector).forEach(el => {
          el.removeAttribute('open');
        });

        // If the clicked item was not open, open it
        if (!isOpen) {
          item.setAttribute('open', '');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    toggleNavList('details[id^="Details-menu-drawer-submenu-"],details[id^="Details-HeaderSubMenu-"]');
