{% if section.settings.enabled %}
  <style>
    #promo-popup-{{ section.id }} {
      position: fixed;
      inset: 0;
      z-index: 999999;
      display: none;
      align-items: center;
      justify-content: center;
      background: {{ section.settings.overlay_color }};
      padding: 1.6rem;
    }

    #promo-popup-{{ section.id }}.is-open {
      display: flex;
    }

    #promo-popup-{{ section.id }} .promo-popup__card {
      position: relative;
      display: flex;
      width: 100%;
      max-width: 72rem;
      background: {{ section.settings.card_color }};
      border-radius: 1.6rem;
      overflow: hidden;
      transform: translateY(2rem);
      opacity: 0;
      transition: transform 0.35s ease, opacity 0.35s ease;
    }

    #promo-popup-{{ section.id }}.is-open .promo-popup__card {
      transform: translateY(0);
      opacity: 1;
    }

    #promo-popup-{{ section.id }} .promo-popup__image {
      flex: 0 0 45%;
      max-width: 45%;
    }

    #promo-popup-{{ section.id }} .promo-popup__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      padding:16px;
    }

    #promo-popup-{{ section.id }} .promo-popup__content {
      flex: 1 1 auto;
      padding: 3.2rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.6rem;
    }

    #promo-popup-{{ section.id }} .promo-popup__heading {
      font-size: 2.4rem;
      line-height: 1.3;
      margin: 0;
      font-weight: 400;
      color: {{ section.settings.text_color }};
    }
        #promo-popup-{{ section.id }} .promo-popup__heading p{
          font-size:4rem;
        }

    #promo-popup-{{ section.id }} .promo-popup__heading b,
    #promo-popup-{{ section.id }} .promo-popup__heading strong {
      font-weight: 700;
    }

    #promo-popup-{{ section.id }} .promo-popup__description {
      font-size: 1.5rem;
      line-height: 1.5;
      margin: 0;
      color: {{ section.settings.text_color }};
      opacity: 0.85;
    }

    #promo-popup-{{ section.id }} .promo-popup__description b,
    #promo-popup-{{ section.id }} .promo-popup__description strong {
      font-weight: 700;
      opacity: 1;
    }

    #promo-popup-{{ section.id }} .promo-popup__button {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      align-self: flex-start;
      margin-top: 0.8rem;
      padding: 1.4rem 2.4rem;
      background: {{ section.settings.button_color }};
      color: {{ section.settings.button_text_color }};
      border-radius: 999px;
      text-decoration: none;
      font-size: 1.3rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    #promo-popup-{{ section.id }} .promo-popup__close {
      position: absolute;
      top: 1.2rem;
      right: 1.2rem;
      width: 3.2rem;
      height: 3.2rem;
      border: none;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.06);
      color: {{ section.settings.text_color }};
      font-size: 1.8rem;
      line-height: 1;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    @media screen and (max-width: 749px) {
      #promo-popup-{{ section.id }} .promo-popup__card {
        flex-direction: column;
        max-width: 40rem;
      }

      #promo-popup-{{ section.id }} .promo-popup__image {
        flex: 0 0 auto;
        max-width: 100%;
        height: 20rem;
      }

      #promo-popup-{{ section.id }} .promo-popup__content {
        padding: 2.4rem;
      }
    }
  </style>

  <div id="promo-popup-{{ section.id }}" class="promo-popup" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | strip_html | escape }}">
    <div class="promo-popup__card">
      <button type="button" class="promo-popup__close" data-promo-popup-close aria-label="{{ 'accessibility.close' | t }}">&times;</button>
      {%- if section.settings.image != blank -%}
        <div class="promo-popup__image">
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        </div>
      {%- endif -%}
      <div class="promo-popup__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="promo-popup__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="promo-popup__description">{{ section.settings.description }}</div>
        {%- endif -%}
        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="promo-popup__button">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script>
    (function () {
      var popup = document.getElementById('promo-popup-{{ section.id }}');
      if (!popup) return;

      var DISMISS_KEY = 'promoPopupDismissedUntil-{{ section.id }}';
      var SESSION_KEY = 'promoPopupShown-{{ section.id }}';
      var DISMISS_HOURS = {{ section.settings.dismiss_hours | default: 24 }};
      var DELAY_MS = {{ section.settings.delay_seconds | default: 3 | times: 1000 }};

      function isDismissed() {
        var until = localStorage.getItem(DISMISS_KEY);
        return until && Date.now() < parseInt(until, 10);
      }

      function shownThisSession() {
        return sessionStorage.getItem(SESSION_KEY) === 'true';
      }

      function openPopup() {
        popup.classList.add('is-open');
        sessionStorage.setItem(SESSION_KEY, 'true');
      }

      function closePopup(remember) {
        popup.classList.remove('is-open');
        if (remember) {
          var until = Date.now() + DISMISS_HOURS * 60 * 60 * 1000;
          localStorage.setItem(DISMISS_KEY, String(until));
        }
      }

      popup.querySelectorAll('[data-promo-popup-close]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          closePopup(true);
        });
      });

      popup.addEventListener('click', function (event) {
        if (event.target === popup) {
          closePopup(true);
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && popup.classList.contains('is-open')) {
          closePopup(true);
        }
      });

      if (!isDismissed() && !shownThisSession()) {
        setTimeout(openPopup, DELAY_MS);
      }
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Promo Popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Know what's in your <b>Shilajit</b></p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore the <b>texture, sourcing &amp; lab-tested purity</b> of Everest Shilajit in a one quick view.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View Lab Report"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Delay before showing (seconds)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "dismiss_hours",
      "label": "Hide again for (hours) after dismissed",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay background",
      "default": "#00000066"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#F5F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1F1B16"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#68453D"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
