{% if section.settings.enabled %}
  <style>
    #promo-popup-{{ section.id }} {
      position: fixed;
      inset: 0;
      z-index: 999999;
      display: none;
      align-items: center;
      justify-content: center;
      background: {{ section.settings.overlay_color }};
      padding: 1.6rem;
    }

    #promo-popup-{{ section.id }}.is-open {
      display: flex;
    }

    #promo-popup-{{ section.id }} .promo-popup__card {
      position: relative;
      display: flex;
      width: 100%;
      max-width: 72rem;
      background: {{ section.settings.card_color }};
      border-radius: 1.6rem;
      overflow: hidden;
      transform: translateY(2rem);
      opacity: 0;
      transition: transform 0.35s ease, opacity 0.35s ease;
    }

    #promo-popup-{{ section.id }}.is-open .promo-popup__card {
      transform: translateY(0);
      opacity: 1;
    }

    #promo-popup-{{ section.id }} .promo-popup__image {
         flex: 0 0 49%;

    }

    #promo-popup-{{ section.id }} .promo-popup__image img {
      width: 100%;

      object-fit: cover;
      display: block;
      padding:16px 0 16px 16px;

    }

    #promo-popup-{{ section.id }} .promo-popup__content {
      flex: 1 1 auto;
    padding: 60px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    }

    #promo-popup-{{ section.id }} .promo-popup__heading {
      font-size: 2.4rem;
      line-height: 1.3;
      margin: 0;
      font-weight: 400;
      color: {{ section.settings.text_color }};
    }
        #promo-popup-{{ section.id }} .promo-popup__heading p{
          font-size:4rem;
        }

    #promo-popup-{{ section.id }} .promo-popup__heading b,
    #promo-popup-{{ section.id }} .promo-popup__heading strong {
      font-weight: 700;
    }

    #promo-popup-{{ section.id }} .promo-popup__description {
      font-size: 1.5rem;
      line-height: 1.5;
      margin: 0;
      color: {{ section.settings.text_color }};

    }
        #promo-popup-{{ section.id }} .promo-popup__description p {
          color:#767676;
        }


    #promo-popup-{{ section.id }} .promo-popup__description b,
    #promo-popup-{{ section.id }} .promo-popup__description strong {
      font-weight: 700;
      opacity: 1;
    }

    #promo-popup-{{ section.id }} .promo-popup__button {
  display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    margin-top: 1rem;
    padding: 1.2rem 4.4rem;
    background: #68453d;
    color: #ffffff;
    border-radius: 9px;
    text-decoration: none;
    font-size: 1.3rem;
    font-weight: 600;
    text-transform: uppercase;
    }

    #promo-popup-{{ section.id }} .promo-popup__close {
     position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    padding: 3px;
    cursor: pointer;
    }

    @media screen and (max-width: 749px) {
      #promo-popup-{{ section.id }} .promo-popup__card {
        flex-direction: column;
        max-width: 40rem;
      }

      #promo-popup-{{ section.id }} .promo-popup__image {
        flex: 0 0 auto;
        max-width: 100%;
        height: 20rem;
      }

      #promo-popup-{{ section.id }} .promo-popup__content {
        padding: 2.4rem;
      }
    }
  </style>

  <div id="promo-popup-{{ section.id }}" class="promo-popup" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | strip_html | escape }}">
    <div class="promo-popup__card">
      <button type="button" class="promo-popup__close" data-promo-popup-close aria-label="{{ 'accessibility.close' | t }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
<path d="M19.7081 18.2931C19.801 18.386 19.8747 18.4963 19.9249 18.6177C19.9752 18.7391 20.0011 18.8692 20.0011 19.0006C20.0011 19.132 19.9752 19.2621 19.9249 19.3835C19.8747 19.5048 19.801 19.6151 19.7081 19.7081C19.6151 19.801 19.5048 19.8747 19.3835 19.9249C19.2621 19.9752 19.132 20.0011 19.0006 20.0011C18.8692 20.0011 18.7391 19.9752 18.6177 19.9249C18.4963 19.8747 18.386 19.801 18.2931 19.7081L10.0006 11.4143L1.70806 19.7081C1.52042 19.8957 1.26592 20.0011 1.00056 20.0011C0.735192 20.0011 0.480697 19.8957 0.293056 19.7081C0.105415 19.5204 5.23096e-09 19.2659 0 19.0006C-5.23096e-09 18.7352 0.105415 18.4807 0.293056 18.2931L8.58681 10.0006L0.293056 1.70806C0.105415 1.52042 0 1.26592 0 1.00056C0 0.735192 0.105415 0.480697 0.293056 0.293056C0.480697 0.105415 0.735192 0 1.00056 0C1.26592 0 1.52042 0.105415 1.70806 0.293056L10.0006 8.58681L18.2931 0.293056C18.4807 0.105415 18.7352 -5.23096e-09 19.0006 0C19.2659 5.23096e-09 19.5204 0.105415 19.7081 0.293056C19.8957 0.480697 20.0011 0.735192 20.0011 1.00056C20.0011 1.26592 19.8957 1.52042 19.7081 1.70806L11.4143 10.0006L19.7081 18.2931Z" fill="#2C211B"/>
</svg>

      </button>
      {%- if section.settings.image != blank -%}
        <div class="promo-popup__image">
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        </div>
      {%- endif -%}
      <div class="promo-popup__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="promo-popup__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="promo-popup__description">{{ section.settings.description }}</div>
        {%- endif -%}
        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="promo-popup__button">
            {{ section.settings.button_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21" fill="none">
<path d="M4.85938 16.0732L15.0343 5.8983" stroke="white" stroke-width="1.74419" stroke-linecap="square" stroke-linejoin="round"/>
<path d="M7.22656 5.37793H15.5515V13.7029" stroke="white" stroke-width="1.74419" stroke-linecap="square" stroke-linejoin="round"/>
</svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script>
    (function () {
      var popup = document.getElementById('promo-popup-{{ section.id }}');
      if (!popup) return;

      var DISMISS_KEY = 'promoPopupDismissedUntil-{{ section.id }}';
      var SESSION_KEY = 'promoPopupShown-{{ section.id }}';
      var DISMISS_HOURS = {{ section.settings.dismiss_hours | default: 24 }};
      var DELAY_MS = {{ section.settings.delay_seconds | default: 3 | times: 1000 }};

      function isDismissed() {
        var until = localStorage.getItem(DISMISS_KEY);
        return until && Date.now() < parseInt(until, 10);
      }

      function shownThisSession() {
        return sessionStorage.getItem(SESSION_KEY) === 'true';
      }

      function openPopup() {
        popup.classList.add('is-open');
        sessionStorage.setItem(SESSION_KEY, 'true');
      }

      function closePopup(remember) {
        popup.classList.remove('is-open');
        if (remember) {
          var until = Date.now() + DISMISS_HOURS * 60 * 60 * 1000;
          localStorage.setItem(DISMISS_KEY, String(until));
        }
      }

      popup.querySelectorAll('[data-promo-popup-close]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          closePopup(true);
        });
      });

      popup.addEventListener('click', function (event) {
        if (event.target === popup) {
          closePopup(true);
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && popup.classList.contains('is-open')) {
          closePopup(true);
        }
      });

      if (!isDismissed() && !shownThisSession()) {
        setTimeout(openPopup, DELAY_MS);
      }
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Promo Popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Know what's in your <b>Shilajit</b></p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore the <b>texture, sourcing &amp; lab-tested purity</b> of Everest Shilajit in a one quick view.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View Lab Report"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Delay before showing (seconds)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "dismiss_hours",
      "label": "Hide again for (hours) after dismissed",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay background",
      "default": "#00000066"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#F5F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1F1B16"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#68453D"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
