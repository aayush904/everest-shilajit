        a.href = '#' + headingId;
        a.className = `ltoc flex gap-[8px] text-gray-700 font-semibold leading-normal p-[6px] text-[16px] hover:text-honey  block w-full rounded-[5px] ${
          index === 0 ? 'active' : ''
        }`;
        li.appendChild(a);
        toc.appendChild(li);

        // Assign id to heading if not already present
        heading.id = headingId;

        // Store references for scroll tracking
        tocLinks.push(a);
        sections.push(heading);
      });

      // Handle smooth scrolling when clicking TOC links
      toc.addEventListener('click', function (event) {
        if (event.target.tagName === 'A') {
          event.preventDefault();
          const targetId = event.target.getAttribute('href').substring(1);
          const targetElement = document.getElementById(targetId);

          if (targetElement) {
            window.scrollTo({
              top: targetElement.offsetTop + 40,
              behavior: 'smooth',
            });
          }
        }
      });

      // Track scroll position and update active section
      function updateActiveSection() {
        const scrollPosition = window.scrollY + 200; // Adding offset for better highlighting

        let currentSection = sections[0];
        sections.forEach((section) => {
          if (section.offsetTop + 40 <= scrollPosition) {
            currentSection = section;
          }
        });
        tocLinks.forEach((link) => {
          const href = link.getAttribute('href');
          const sectionId = '#' + currentSection.id;

          link.classList.remove('active');

          if (href === sectionId) {
            link.classList.add('active');
          }
        });
      }

      let isScrolling;
      window.addEventListener(
        'scroll',
        function () {
          window.clearTimeout(isScrolling);

          isScrolling = setTimeout(function () {
            updateActiveSection();
          }, 10);
        },
        false
      );

      // Initial update
      updateActiveSection();
    });
  </script>
{% endif %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    (function () {
      const handle = '{{ article.handle | split: "/" | last }}';
      const apiUrl = 'https://api.everestshilajit.com/';
      const sessionKey = 'viewed_articles';

      const data = JSON.parse(localStorage.getItem(sessionKey)) || { posts: [], timestamp: Date.now() };

      const twelveHours = 12 * 60 * 60 * 1000;
      const isExpired = Date.now() - data.timestamp > twelveHours;

      if (isExpired) {
        localStorage.removeItem(sessionKey);
        data.posts = [];
        data.timestamp = Date.now();
      }

      if (!data.posts.includes(handle)) {
        data.posts.push(handle);
        localStorage.setItem(sessionKey, JSON.stringify(data));

        fetch(apiUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-API-KEY': 'sk_everestshilajit_8f9c2dbe-4e5a-47e0-8d14-d7a6bcd29a12',
          },
          body: JSON.stringify({ handle }),
        });
      }
    })();
  });
</script>

<script type="application/ld+json">
