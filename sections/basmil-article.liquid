                alt="Profile Picture for {{ page.title }}"
                class="rounded-full w-[70px] object-cover h-[70px] mb-[20px]"
                width=""
                height=""
              >
            </a>
          {% endif %}

          <a href="{{ shop.url }}/pages/{{ slug }}">
            <author-name class="text-h4 mt-[0!important] block bolder-500 mb-[15px] sm:mb-[9px] lg:text-[2.4rem] xl:text-[2.4rem] md:text-[2rem] sm:text-[1.8rem] leading-[1.3] font-sans font-medium text-black">
              {{ page.title }}
            </author-name>
          </a>
          {% comment %} <p>{{ page.metafields.custom.author_expertise.value }}</p> {% endcomment %}
          <div class="flex mb-[3rem] sm:mb-[15px]">
            {% assign social_links = page.metafields.custom.author_social %}
            {% if social_links and social_links.value.size > 0 %}
              <style>
                .social-icon svg {
                  height: 20px;
                  border-radius: 50%;
                  width: 20px;

                  && rect {
                    fill: #68453d;
                    fill-opacity: 1;
                  }
                }
              </style>
              <ul class="author-social-links m-[0!important] flex gap-[10px]">
                {% for link in social_links.value %}
                  <li class="rounded-full">
                    {% if link contains 'facebook' %}
                      <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
                        {%- render 'icon-facebook' -%}
                      </a>
                    {% elsif link contains 'instagram' %}
                      <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
                        {%- render 'icon-instagram' -%}
                      </a>
                    {% elsif link contains 'youtube' %}
                      <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
                        {%- render 'icon-youtube' -%}
                      </a>
                    {% elsif link contains 'twitter' or link contains 'x.com' %}
                      <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
                        {%- render 'icon-twitter' -%}
                      </a>
                    {% elsif link contains 'snapchat' %}
                      <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
                        {%- render 'icon-snapchat' -%}
                      </a>
                    {% elsif link contains 'pinterest' %}
                      <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
                        {%- render 'icon-pinterest' -%}
                      </a>
                    {% elsif link contains 'tumblr' %}
                      <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
                        {%- render 'icon-tumblr' -%}
                      </a>
                    {% elsif link contains 'vimeo' %}
                      <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
                        {%- render 'icon-vimeo' -%}
                      </a>
                    {% elsif link contains 'medium' %}
                      <a href="{{ link }}" target="_blank" class="social-icon" rel="noopener noreferrer">
                        {%- render 'icon-medium' -%}
                      </a>
                    {% elsif link contains 'linkedin' %}
                      <a href="{{ link }}" target="_blank" class="social-icon" rel="noopener noreferrer">
                        {%- render 'icon-linkedin' -%}
                      </a>
                    {% elsif link contains 'quora' %}
                      <a href="{{ link }}" target="_blank" class="social-icon" rel="noopener noreferrer">
                        {%- render 'icon-quora' -%}
                      </a>
                    {% elsif link contains 'reddit' %}
                      <a href="{{ link }}" target="_blank" class="social-icon" rel="noopener noreferrer">
                        {%- render 'icon-reddit' -%}
                      </a>
                    {% else %}
                      <a href="{{ link }}" target="_blank" rel="noopener noreferrer">{{ link }}</a>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
          <p class="text-[16px]">{{ page.metafields.custom.excerpt.value }}</p>
        </div>
      </author>
    </article>
  </div>
  <style>
    author * {
      line-height: normal !important;
      text-align: center;
    }

    author p {
      margin-bottom: 0 !important;
    }
  </style>
{% endif %}
<div class="main-article">
  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper ">
      <div id="comments" class="page-width page-width--narrow font-sans ">
        <div class="mb-[6rem]">
          {% form 'new_comment', article %}
            {%- liquid
              assign post_message = 'blogs.article.success'
              if blog.moderated? and comment.status == 'unapproved'
                assign post_message = 'blogs.article.success_moderated'
              endif
            -%}
            <h4 class="mb-[3.2rem]">{{ 'blogs.article.comment_form_title' | t }}</h4>
            {%- if form.errors -%}
              <div class="form__message" role="alert">
                <h4
                  class="form-status caption-large text-body"
                  tabindex="-1"
                  autofocus
                >
                  {% render 'icon-error' %}
                  {{ 'templates.contact.form.error_heading' | t }}
                </h4>
              </div>
              <ul class="form-status-list caption-large">
                {%- for field in form.errors -%}
                  <li>
                    <a href="#CommentForm-{{ field }}" class="link">
                      {%- if form.errors.translated_fields[field] contains 'author' -%}
                        {{ 'blogs.article.name' | t }}
                      {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                        {{ 'blogs.article.message' | t }}
                      {%- else -%}
                        {{ form.errors.translated_fields[field] }}
                      {%- endif -%}
                      {{ form.errors.messages[field] }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- elsif form.posted_successfully? -%}
              <div class="form-status-list form__message" role="status">
                <h4
                  class="form-status"
                  tabindex="-1"
                  autofocus
                >
                  {% render 'icon-success' %}
                  {{ post_message | t }}
                </h4>
              </div>
            {%- endif -%}

            <div
              {% if blog.moderated? == false %}
                class="article-template__comments-fields"
              {% endif %}
            >
              <div class="article-template__comment-fields">
                <div class="field field--with-error">
                  <input
                    type="text"
                    name="comment[author]"
                    id="CommentForm-author"
                    class="field__input"
                    autocomplete="name"
                    value="{{ form.author }}"
                    aria-required="true"
                    required
                    {% if form.errors contains 'author' %}
                      aria-invalid="true"
                      aria-describedby="CommentForm-author-error"
                    {% endif %}
                    placeholder="{{ 'blogs.article.name' | t }}"
                  >
                  <label class="field__label" for="CommentForm-author">
                    {{- 'blogs.article.name' | t }}
                    <span aria-hidden="true">*</span>
                  </label>
                  {%- if form.errors contains 'author' -%}
                    <small id="CommentForm-author-error">
                      <span class="form__message">
                        {%- render 'icon-error' -%}
                        {{- 'blogs.article.name' | t }}
                        {{ form.errors.messages.author }}.</span
                      >
                    </small>
                  {%- endif -%}
                </div>
                <div class="field field--with-error">
                  <input
                    type="email"
                    name="comment[email]"
                    id="CommentForm-email"
                    autocomplete="email"
                    class="field__input"
                    value="{{ form.email }}"
                    autocorrect="off"
                    autocapitalize="off"
                    aria-required="true"
                    required
                    {% if form.errors contains 'email' %}
                      aria-invalid="true"
                      aria-describedby="CommentForm-email-error"
                    {% endif %}
                    placeholder="{{ 'blogs.article.email' | t }}"
                  >
                  <label class="field__label" for="CommentForm-email">
                    {{- 'blogs.article.email' | t }}
                    <span aria-hidden="true">*</span>
                  </label>
                  {%- if form.errors contains 'email' -%}
                    <small id="CommentForm-email-error">
                      <span class="form__message">
                        {%- render 'icon-error' -%}
                        {{- 'blogs.article.email' | t }}
                        {{ form.errors.messages.email }}.</span
                      >
                    </small>
                  {%- endif -%}
                </div>
              </div>
              <div class="field field--with-error">
                <textarea
                  rows="5"
                  name="comment[body]"
                  id="CommentForm-body"
                  class="text-area field__input"
                  aria-required="true"
                  required
                  {% if form.errors contains 'body' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-body-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.message' | t }}"
                >{{ form.body }}</textarea>
                <label class="form__label field__label" for="CommentForm-body">
                  {{- 'blogs.article.message' | t }}
                  <span aria-hidden="true">*</span>
                </label>
              </div>
              {%- if form.errors contains 'body' -%}
                <small id="CommentForm-body-error">
                  <span class="form__message">
                    {%- render 'icon-error' -%}
                    {{- 'blogs.article.message' | t }}
                    {{ form.errors.messages.body }}.</span
                  >
                </small>
              {%- endif -%}
            </div>
            {%- if blog.moderated? -%}
              <p class="article-template__comment-warning caption mb-[1rem!important]">
                {{ 'blogs.article.moderated' | t }}
              </p>
            {%- endif -%}
            <input
              type="submit"
              class="button"
              value="{{ 'blogs.article.post' | t }}"
            >
          {% endform %}
        </div>
        {%- if article.comments_count > 0 -%}
          {%- assign anchorId = '#Comments-' | append: article.id -%}

          <h4
            class="mb-[4.8rem]"
            as
            id="Comments-{{ article.id }}"
            tabindex="-1"
          >
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </h4>
          {% paginate article.comments by 3 %}
            <div class="article-template__comments">
              {%- if comment.status == 'pending' and comment.content -%}
                <article
                  id="{{ comment.id }}"
                  class="article-template__comments-comment border-t py-[4.8rem!important] border-[#00000033] border-dashed"
                >
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                  </footer>
                </article>
              {%- endif -%}

              {%- for comment in article.comments -%}
                <article
                  id="{{ comment.id }}"
                  class="flex items-center px-[0!important] gap-[4rem] article-template__comments-comment border-t py-[4.8rem!important] border-[#00000033] border-dashed"
                >
                  <div class="bg-gray-200 aspect-square flex justify-center items-center w-full rounded-full max-w-[15rem] max-h-[15rem] font-bold text-[5rem] md:text-[4rem]   font-sans">
                    {% assign first_letter = comment.author | slice: 0, 1 %}
                    {{ first_letter }}
                  </div>
                  <div class="flex flex-col gap-[1.6rem]">
                    <h4>{{ comment.author }}</h4>
                    {{ comment.content }}
                    <footer class="right">
                      <span class="caption-with-letter-spacing items-center flex gap-[1.2rem]">
                        <svg
                          width="31"
                          height="32"
                          class="w-[3rem] h-[3rem]"
                          viewBox="0 0 31 32"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path d="M13.625 16.625H16.125V24.75M1.75 11H29.25M21.75 6V1M9.25 6V1M4.25 31H26.75C27.413 31 28.0489 30.7366 28.5178 30.2678C28.9866 29.7989 29.25 29.163 29.25 28.5V6C29.25 5.33696 28.9866 4.70107 28.5178 4.23223C28.0489 3.76339 27.413 3.5 26.75 3.5H4.25C3.58696 3.5 2.95107 3.76339 2.48223 4.23223C2.01339 4.70107 1.75 5.33696 1.75 6V28.5C1.75 29.163 2.01339 29.7989 2.48223 30.2678C2.95107 30.7366 3.58696 31 4.25 31Z" stroke="#3A2307" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>

                        {{- comment.created_at | date: '%m/%d/%Y' -}}
                      </span>
                    </footer>
                  </div>
                </article>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: anchorId %}
            </div>
          {% endpaginate %}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const toc = document.getElementById('toc');
    const headings = document.querySelectorAll('article h2');
    const tocLinks = [];
    const sections = [];

    // Create TOC links and track sections
    headings.forEach((heading, index) => {
      // Create TOC item
      const li = document.createElement('li');
      const a = document.createElement('a');
      const headingId = heading.textContent.toLowerCase().replace(/ /g, '-');

      a.textContent = heading.textContent;
      a.href = '#' + headingId;
      a.className = `text-gray-700 hover:text-honey p-[6px] block w-full rounded-[5px] ${
        index === 0 ? 'bg-[#F8F1E8]' : ''
      }`;
      li.appendChild(a);
      toc.appendChild(li);

      // Assign id to heading if not already present
      heading.id = headingId;

      // Store references for scroll tracking
      tocLinks.push(a);
      sections.push(heading);
    });

    // Handle smooth scrolling when clicking TOC links
    toc.addEventListener('click', function (event) {
      if (event.target.tagName === 'A') {
        event.preventDefault();
        const targetId = event.target.getAttribute('href').substring(1);
        const targetElement = document.getElementById(targetId);

        if (targetElement) {
          window.scrollTo({
            top: targetElement.offsetTop + 40,
            behavior: 'smooth',
          });
        }
      }
    });

    // Track scroll position and update active section
    function updateActiveSection() {
      const scrollPosition = window.scrollY + 200; // Adding offset for better highlighting

      // Find the current section
      let currentSection = sections[0];
      sections.forEach((section) => {
        if (section.offsetTop + 40 <= scrollPosition) {
          currentSection = section;
        }
      });

      // Update TOC links' active state
      tocLinks.forEach((link) => {
        const href = link.getAttribute('href');
        const sectionId = '#' + currentSection.id;

        // Remove existing active classes
        link.classList.remove('bg-[#F8F1E8]');

        // Add active classes to current section's link
        if (href === sectionId) {
          link.classList.add('bg-[#F8F1E8]');
        }
      });
    }

    // Add scroll event listener with debouncing for performance
    let isScrolling;
    window.addEventListener(
      'scroll',
      function () {
        // Clear previous timeout
        window.clearTimeout(isScrolling);

        // Set new timeout
        isScrolling = setTimeout(function () {
          updateActiveSection();
        }, 10);
      },
      false
    );

    // Initial update
    updateActiveSection();
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    (function () {
      const handle = '{{ article.handle | split: "/" | last }}';
      const apiUrl = 'https://api.everestshilajit.com/';
      const sessionKey = 'viewed_articles';

      const data = JSON.parse(localStorage.getItem(sessionKey)) || { posts: [], timestamp: Date.now() };

      const twelveHours = 12 * 60 * 60 * 1000;
      const isExpired = Date.now() - data.timestamp > twelveHours;

      if (isExpired) {
        localStorage.removeItem(sessionKey);
        data.posts = [];
        data.timestamp = Date.now();
      }

      if (!data.posts.includes(handle)) {
        data.posts.push(handle);
        localStorage.setItem(sessionKey, JSON.stringify(data));

        fetch(apiUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-API-KEY': 'sk_everestshilajit_8f9c2dbe-4e5a-47e0-8d14-d7a6bcd29a12',
          },
          body: JSON.stringify({ handle }),
        });
      }
    })();
  });
</script>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ request.origin | append: page.url | json }}
    },
    "headline": {{ article.title | json }},
    {% if article.excerpt != blank %}
      "description": {{ article.excerpt | strip_html | json }},
      {% endif %}
      {% if article.image %}
        "image" : [{{ article | image_url: width: 1920 | prepend: "https:" | json }}],
        {% endif %}
        "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
        "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
        "author": {
          "@type": "Person",
          "name": {{ article.author | json }}
        },
        "publisher": {
          "@type": "Organization",
          "name": {{ shop.name | json }}
        }
      }
</script>

