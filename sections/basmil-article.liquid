{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}
<style>
  .card--standard.card--text.article-card > .card__content .card__information,
  .card--standard.card--media .card__inner .card__information,
  .card--standard.card--text:not(.card--horizontal) > .card__content .card__heading,
  .card--standard:not(.card--horizontal) > .card__content .card__badge,
  .card--standard.card--text.article-card > .card__content .card__information,
  .card--standard > .card__content .card__caption {
    display: flex !important;
  }

  article h2 {
    font-size: clamp(20px, 1.986vw, 38px);

    margin-top: 5.4rem;
  }

  .main-article ul,
  .main-article ol,
  .main-article blockquote,
  .main-article table,
  .main-article figure,
  .main-article img {
    margin-bottom: 2.4rem;
  }

  article p a,
  article li a {
    color: #000 !important; /* Resets the text color to the default */
    text-decoration: underline !important; /* Restores default underline behavior */
    display: inline !important; /* Ensures default display behavior */

    &&:hover {
      color: #be935f !important; /* Resets the text color to the default */
    }
  }

  article h2:last-of-type {
    margin-top: 5.4rem;
  }

  #comments .field:after {
    content: none;
  }
</style>

{% assign slug = article.author | downcase | replace: ' ', '-' | replace: '!', '' | replace: "'", '' %}
{% assign page = pages[slug] %}
{% assign profile_pic_metafield = page.metafields.custom.author_profile_picture %}

{% if page.title != blank %}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'title' -%}
        <header
          {{ block.shopify_attributes }}
          class="w-full max-w-[120rem] flex flex-col justify-center items-center m-auto mt-[8rem] mb-[5rem]"
        >
          <h1 class="leading-none text-[3.2rem] sm:text-[18px] font-sans font-medium bolder-500" itemprop="headline">
            {{ article.title | escape }}
          </h1>
          <div class="flex justify-center items-center gap-[1.2rem] mt-[15px]">
            {%- if block.settings.blog_show_author -%}
              {% assign slug = article.author | downcase | replace: ' ', '-' | replace: '!', '' | replace: "'", '' %}
              <p
                class="font-sans w-max block mb-0 text-[#382E2A] text-[16px]"
                itemprop="author"
                itemscope
                itemtype="http://schema.org/Person"
              >
                <a
                  href="{{ shop.url }}/pages/{{ slug }}"
                  class="font-normal w-max flex justify-center items-center gap-[12px] flex-nowrap mb-0"
                  itemprop="name"
                >
                  {% if profile_pic_metafield and profile_pic_metafield.value %}
                    <img
                      src="{{ profile_pic_metafield | file_url }}"
                      alt="Profile Picture for {{ page.title }}"
                      class="rounded-full w-[32px] h-[32px] my-[0rem]"
                      width=""
                      height=""
                    >
                  {% endif %}
                  {{ article.metafields.custom.author_name.value | default: article.author -}}
                </a>
              </p>
            {%- endif -%}
            {%- if block.settings.blog_show_date -%}
              |
              <p
                class="font-sans text-[1.6rem] text-[#382E2A] flex gap-5 justify-start items-center"
                itemprop="dateCreated  datePublished"
              >
                {% comment %}
                  {% assign words_per_minute = 250 %}
                  {% assign word_count = article.content | strip_html | size %}
                  {% assign read_time = word_count | divided_by: words_per_minute %}

                  {% if read_time < 1 %}
                    1 min read.
                  {% else %}
                    {{ read_time | ceil }} min read.
                  {% endif %}
                {% endcomment %}

                {{ article.published_at | date: '%b %d, %Y' }}
              </p>
            {%- endif -%}
          </div>
        </header>
    {%- endcase -%}
  {%- endfor -%}
  <div class="main-article flex page-width sm:max-w-[116.6rem] md:max-w-[116.6rem] xl:max-w-[1400px] gap-[3.69%] mx-auto my-0 pb-[5.4rem] sm:pb[30px] px-[16px]">
    <aside class="max-w-[23.47%] w-full sm:hidden">
      <div class="sticky top-[12rem] mt-[0]">
        <toc-heading class="block text-[16px]  font-normal  border-b border-[#E2E2E2] pb-[2rem] after:bottom-0 relative after:w-[8.6%] after:absolute after:block after:h-[2px] after:bg-[#68453D] after:left-0 after: text-[#647084!important] font-sans leading-[1!important]">
          Table of Content
        </toc-heading>
        <ul id="toc" class="my-[2.4rem] list-disc ml-[1.5em] pt-6  flex flex-col gap-[1.6rem] font-sans "></ul>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'share' -%}
              <div class="my-[3.2rem] justify-start" {{ block.shopify_attributes }}>
                <share-heading class="block text-[16px]  font-normal pb-[15px] text-[#647084!important] font-sans leading-[1!important]">
                  Share Article
                </share-heading>
                {% assign share_url = request.origin | append: article.url %}
                <div class="social-share-buttons  flex gap-[1.2rem]">
                  <a
                    class="hover:scale-105"
                    href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg width="33" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M35.66 0H12C5.37258 0 0 5.37258 0 12V35.66C0 42.2874 5.37258 47.66 12 47.66H35.66C42.2874 47.66 47.66 42.2874 47.66 35.66V12C47.66 5.37258 42.2874 0 35.66 0Z" fill="#68453D"/>
                      <path d="M26.47 39.01V25.73H30.9L31.74 20.24H26.47V16.67C26.47 15.17 27.21 13.7 29.57 13.7H31.97V9.02003C31.97 9.02003 29.79 8.65002 27.72 8.65002C23.38 8.65002 20.54 11.28 20.54 16.04V20.23H15.71V25.72H20.54V39H26.48L26.47 39.01Z" fill="white"/>
                    </svg>
                  </a>

                  <a
                    class="hover:scale-105"
                    href="https://twitter.com/intent/tweet?url={{ share_url }}&text={{ article.title }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg width="33" viewBox="0 0 49 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M36.3099 0H12.6499C6.02249 0 0.649902 5.37258 0.649902 12V35.66C0.649902 42.2874 6.02249 47.66 12.6499 47.66H36.3099C42.9373 47.66 48.3099 42.2874 48.3099 35.66V12C48.3099 5.37258 42.9373 0 36.3099 0Z" fill="#68453D"/>
                      <path d="M26.5001 22.16L34.4001 12.97H32.5301L25.6701 20.95L20.1901 12.97H13.8701L22.1601 25.03L13.8701 34.66H15.7401L22.9901 26.24L28.7801 34.66H35.1001L26.5001 22.15V22.16ZM23.9401 25.14L23.1001 23.94L16.4201 14.38H19.3001L24.6901 22.09L25.5301 23.29L32.5401 33.32H29.6601L23.9401 25.14Z" fill="white"/>
                    </svg>
                  </a>

                  <a
                    class="hover:scale-105"
                    href="https://pinterest.com/pin/create/button/?url={{ share_url | absolute_url }}&media={{ article.image | img_url: 'large' }}&description={{ article.title }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg width="33" viewBox="0 0 48 49" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M35.9598 0.649902H12.2998C5.67239 0.649902 0.299805 6.02249 0.299805 12.6499V36.3099C0.299805 42.9373 5.67239 48.3099 12.2998 48.3099H35.9598C42.5872 48.3099 47.9598 42.9373 47.9598 36.3099V12.6499C47.9598 6.02249 42.5872 0.649902 35.9598 0.649902Z" fill="#68453D"/>
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M22.5 28.7798C22.48 28.8498 22.46 28.9198 22.44 28.9798C21.5 32.6698 21.39 33.4998 20.42 35.2098C19.96 36.0298 19.44 36.7998 18.86 37.5398C18.79 37.6198 18.73 37.7298 18.6 37.7098C18.46 37.6798 18.45 37.5498 18.43 37.4398C18.27 36.3198 18.19 35.1898 18.23 34.0598C18.28 32.5798 18.46 32.0798 20.36 24.0698C20.39 23.9498 20.36 23.8498 20.32 23.7398C19.86 22.5098 19.77 21.2598 20.17 19.9998C21.03 17.2698 24.13 17.0598 24.67 19.3098C25 20.6998 24.12 22.5298 23.44 25.2198C22.88 27.4398 25.5 29.0198 27.73 27.3998C29.79 25.8998 30.59 22.3198 30.44 19.7698C30.14 14.6998 24.58 13.6098 21.05 15.2398C17.01 17.1098 16.09 22.1198 17.91 24.4098C18.14 24.6998 18.32 24.8798 18.24 25.1698C18.12 25.6298 18.02 26.0898 17.89 26.5498C17.8 26.8898 17.51 27.0098 17.17 26.8698C16.5 26.5998 15.94 26.1698 15.48 25.6098C13.93 23.6898 13.49 19.8898 15.54 16.6798C17.81 13.1198 22.03 11.6798 25.89 12.1198C30.5 12.6398 33.41 15.7898 33.95 19.3598C34.2 20.9898 34.02 24.9998 31.74 27.8298C29.11 31.0898 24.86 31.2998 22.89 29.2998C22.74 29.1498 22.62 28.9698 22.47 28.7798H22.5Z" fill="white"/>
                    </svg>
                  </a>
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </aside>

    <article
      class=" w-full sm:max-w-full"
      itemscope
      itemtype="http://schema.org/BlogPosting"
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="page-width page-width--narrow">
              {% render block %}
            </div>
          {%- when 'featured_image' -%}
            {%- if article.image -%}
              <img
                srcset="
                  {% if article.image.width >= 350 %}{{ article.image | image_url: width: 350 }} 350w,{% endif %}
                  {% if article.image.width >= 750 %}{{ article.image | image_url: width: 750 }} 750w,{% endif %}
                  {% if article.image.width >= 1100 %}{{ article.image | image_url: width: 1100 }} 1100w,{% endif %}
                  {% if article.image.width >= 1500 %}{{ article.image | image_url: width: 1500 }} 1500w,{% endif %}
                  {% if article.image.width >= 2200 %}{{ article.image | image_url: width: 2200 }} 2200w,{% endif %}
                  {% if article.image.width >= 3000 %}{{ article.image | image_url: width: 3000 }} 3000w,{% endif %}
                  {{ article.image | image_url }} {{ article.image.width }}w
                "
                sizes="(min-width: 1400px) 1300px, (min-width: 768px) calc(100vw - 10rem), 100vw"
                src="{{ article.image | image_url}}"
                loading="eager"
                fetchpriority="high"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                alt="{{ article.image.alt | escape }}"
                class="w-full aspect-[464/348] object-cover mb-[4.8rem]"
              >
              {% comment %}
                </div>
                </div>
              {% endcomment %}
            {%- endif -%}

          {%- when 'content' -%}
            <div
              {% comment %}
                class="article-template__content page-width page-width--narrow rte "
              {% endcomment %}
              itemprop="articleBody"
              {{ block.shopify_attributes }}
            >
              {{ article.content }}
            </div>
        {%- endcase -%}
      {%- endfor -%}

      {% comment %}
        <div class="article-template__back element-margin-top center">
          <a href="{{ blog.url }}" class="article-template__link link animate-arrow">
            <span class="icon-wrap">{% render 'icon-arrow' %}</span>
            {{ 'blogs.article.back_to_blog' | t: title: blog.title }}
          </a>
        </div>
      {% endcomment %}

      <author class="relative w-full mt-[86.4px] sm:mt-[1.875rem]  block bg-[#F5EADD]">
        <svg
          class="absolute left-0 top-[6.6%] w-[11%]"
          viewBox="0 0 131 203"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
