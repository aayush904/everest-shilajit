{% style %}
  #shopify-section-{{ section.id }} {
    .toc-wrapper{
      margin-right:4.8rem;
      margin-bottom:11rem;
      position:relative;
    }

    .page-width{
      padding:0;
    }

    .main-wrapper{
      position:relative;
      display:grid; gap:0; grid-template-columns:29.8rem 1fr;
      margin-top:7rem;
    }

    .container {
      display: flex;
      padding: 11rem 16px;
      gap: 4.8rem;
      max-width: 1472px;
      margin: 0 auto;
    }

    .toc {
      width: 27rem;
      background: #fff;
      padding: 1.6rem;
      border-radius: 10px;
      position: sticky;
      top: 13rem;
      height: fit-content;
      border: 1px solid #403b39;
      margin-left:16px;
    }

    .toc toc-heading {
      margin-top: 0;
      font-weight: bold;
      font-size: 2.4rem;
    }

    .toc hr {
      width: 65%;
      height: 1px;
      background: #a3a3a3;
      margin: 16px auto;
    }
    ul{
      padding-left:0;
    }
    .toc ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .toc li {
      margin: 0px;
      font-size: 1.6rem;
      letter-spacing: 0;
      line-height: 17px;
    }

    .toc a {
      text-decoration: none;
      color: #333;
      line-height:1.35;
    }

    .main {
      flex-grow: 1;
    }

    .body-wrapper{
      position:relative;
    }

    .chapters, nav-heading {
      width: 100%;
      margin-left: auto;
      display: grid;
    }

    nav-heading {
      font-weight: 700;
      margin-bottom:4rem;
    }

    .chapters {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .chapter-card {
      background: #fff;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      padding: 3.4rem 3.2rem;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .chapter-card *{
      letter-spacing:0;
    }

    .chapter-card span{
      margin-bottom: 12px;
      font-size:16px;
      line-height: 1.3;
      color:#403B3999;
      display:block;
    }

    .chapter-card b {
      margin-bottom: 2.4rem;
      line-height: 1.3;
      font-size:18px;
      color:#68453D;
      text-transform:capitalize;
    }

    .chapter-card p {
      font-size: 0.9rem;
      margin-bottom:3.2rem;
      margin-top:2.4rem;
      font-size:16px;
      color:#68453D;
    }

    .chapter-card .btn {
      /* color:#364639; */
      color:#25252599;
      font-size:1.6rem;
    }

    .chapter-section {
      background: #fff;
      padding: 0;
      margin-bottom: 2rem;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      gap: 24px;
      width: 100%;
      max-width:114.3rem;
      margin-right: auto;
    }

    .chapter-section div {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .chapter-section p {
      line-height: 1.3;
      margin-bottom: 0;
    }

    .chapter-section nav:not(:first-child) {
      margin-top: 2.4rem;
    }

    .chapter-section nav {
      display: flex;
      padding: 3.2rem 5.6rem;
      margin-bottom: 3.2rem;
      flex-direction: column;
      gap: 10px;
      background: #68453d;

      h2,
      p {
        color: #fff;
        line-height: 1.3;
      }

      ancor{
        transform:translateY(-13.5rem);
      }
    }

    highlight {
      display: block;
      padding: 4rem 5.6rem;
      background: #f9f4ed;
    }

    .chapter-section h3 {
      font-family: var(--font-body-family);
      font-weight: 700;
      font-size: 3.2rem;
    }

    .chapter-section h3 {
      margin-top: 8px;
    }

    .chapter-section h4 {
      margin-bottom: -1.8rem;
    }

    .chapter-section .table-container {
      padding-bottom: 8px;
    }

    @media (max-width: 1167px) {
      .chapters, nav-heading {
       width: 100%;
       max-width: 100%;
      }

      nav-heading {
        font-size:24px;
      }
    }

    @media (max-width: 998px) {
      .main-wrapper{
        grid-template-columns:1fr;
        max-width:99vw;
      }

      .toc-wrapper{
        display:none;  
      }

      .toc-wrapper.active{
        position: fixed!important;
        left: 0;
        bottom: 0;
        margin-right:0rem;
        margin-bottom:0rem;
        width:100%;
        height:100%;
        background:#00000080;
        z-index:99;
        display:block;
      }

      .toc-btn{
        position:fixed;
        left:2rem;
        bottom:6rem;
        height:5rem;
        width:5rem;
        border-radius:50%;
        background:#68453d;
        z-index:999;
        display:block;
        overflow:hidden;

        &&.active span{
            &:nth-child(1){
              transform: rotate(45deg) translate(-5%, 450%);
            }

            &:nth-child(2){
              display:none;
            }

            &:nth-child(3){
              transform:rotate(-45deg) translate(-5%,-450%);
            }
          }

        span{
          height:2px;
          background:#fff;
          width:2rem;
          display:block;
          position:absolute;
          top:50%;
          left:50%;
          transform:translate(-50%,-50%);
          transform-origin: center center;
          transition: all 0.5s ease;
          
          &:nth-child(1){
            top: 35%;
          }
          &:nth-child(3){
            top: 65%;
          }

        }
      }

      .toc{
       margin:0;
       top:50%;
       left:50%;
       transform:translate(-50%, -50%);
       width:90%!important;
       max-width:480px;
       position:absolute;
      }

      .body-wrapper{
        max-width:99vw;
        margin:auto;
      }

      .chapter-section,
      .chapter-section div {
        gap: 12px;
      }

      .chapter-section {
        margin-right:0;
        width: 100%;
      }

      highlight {
        padding: 16px;
      }

      .chapter-section h3 {
        font-size: 16px;
      }

      .container {
        gap: 2rem;
      }

      .toc {
        padding: 12px;
        width: 23rem;
      }

      .chapter-section {
        max-width: 100%;
      }
    }

    @media (max-width: 768px) {
      .container {
        padding:40px 16px;
      }

      h2{
        font-size:24px;
      }

      .chapter-section {
        max-width: 100%;
      }

      .chapter-section nav {
        padding: 2.4rem 3.2rem;
        margin-bottom:8px;
      }

      .chapters{
        grid-template-columns: repeat(2, 1fr);
      }

        .chapter-card p {
          font-size:12px;
          margin-top:16px;
          margin-bottom:24px;
        }

      .toc.sm\:hidden{
        display:none;
      }
    }

    @media (max-width: 450px) {
      .chapters {
        grid-template-columns: 1fr;
      }
    }
  }
{% endstyle %}

<div class="page-width main-wrapper">
  <div class="toc-btn hidden sm:block fixed">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <aside class="toc-wrapper">
    <div class="main-section toc" aria-label="Table of contents">
      <toc-heading class="font-sans text-center">Table of Contents</toc-heading>
      <hr>
      <nav>
        <ul>
          {% for block in section.blocks %}
            {% if block.type == 'chapter' %}
              <li>
                <a href="#{{ block.settings.chapter | handleize }}"
                  ><strong>{{- block.settings.chapter }}: </strong>{{ block.settings.subtitle -}}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>
    </div>
  </aside>

  <div class="body-wrapper">
    {% if section.settings.custom_liquid %}
      <div class="custom-html" style="padding:0 16px;">
        {{ section.settings.custom_liquid }}
      </div>
    {% endif %}
    <div class="main-section px-[16px]" style="margin: 0 auto;">
      <nav-heading class="h2 nav-heading">{{ section.settings.navigation_label }}</nav-heading>
      <section id="chapter-cards" class="chapters">
        {% for block in section.blocks %}
          {% if block.type == 'chapter' %}
            <a href="#{{ block.settings.chapter | handleize  }}" class="chapter-card">
              <div>
                <span>
                  {{ block.settings.chapter }}
                </span>
                <b>{{ block.settings.subtitle }}</b>
                <p>{{ block.settings.excerpt }}</p>
              </div>
              <span class="btn">{{ section.settings.navigation_btn_text }}</span>
            </a>
          {% endif %}
        {% endfor %}
      </section>
    </div>
    <div class="container">
      <section class="chapter-section">
        {% for block in section.blocks %}
          {% if block.type == 'chapter' %}
            <nav>
              <ancor class="absolute" id="{{ block.settings.chapter | handleize }}"></ancor>
              <h2>{{ block.settings.chapter }}</h2>
              <p>{{ block.settings.subtitle }}</p>
            </nav>
          {% endif %}

          {% if block.type == 'content' %}
            {% if block.settings.richtext_content != blank %}
              <div class="text-{{ block.id }}">{{ block.settings.richtext_content }}</div>
            {% endif %}
            {% if block.settings.html_content != blank %}
              <div class="html-{{ block.id }}">{{ block.settings.html_content }}</div>
            {% endif %}
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url }}"
                alt="{{ block.settings.image_caption }}"
                height="auto"
                width="auto"
              >
            {% endif %}
          {% endif %}
        {% endfor %}
      </section>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const tocBtn = document.querySelector(".toc-btn");
    const tocWrapper = document.querySelector(".toc-wrapper");
    const tocElement = document.querySelector(".toc");

    tocBtn.addEventListener("click", function (e) {
      e.stopPropagation(); 
        tocBtn.classList.toggle("active");
      tocWrapper.classList.toggle("active");
    });

    tocWrapper.addEventListener("click", function (e) {
      if (!tocElement.contains(e.target) && !tocBtn.contains(e.target)) {
        tocWrapper.classList.remove("active");
        tocBtn.classList.remove("active");
      }
    });

    document.addEventListener("click", function (e) {
      if (!tocWrapper.contains(e.target)) {
        tocBtn.classList.toggle("active");
        tocWrapper.classList.remove("active");
      }
    });
  });
</script>

{% schema %}
{
  "name": "Basmil Mixed Section",
  "settings": [
    {
      "type": "header",
      "content": "Table of Contents"
    },
    {
      "type": "text",
      "id": "toc_heading",
      "label": "Table of Contents Heading"
    },
    {
      "type": "header",
      "content": "Navigation Card"
    },
    {
      "type": "text",
      "id": "navigation_label",
      "label": "Navigation Label"
    },
    {
      "type": "text",
      "id": "navigation_btn_text",
      "label": "Navigation Button Text"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Html/Liquid"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        {
          "type": "html",
          "id": "chapter",
          "label": "Chapter Title(e.g., Chapter 1)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Chapter Subtitle"
        },

        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Chapter Excerpt"
        }
      ]
    },
    {
      "type": "content",
      "name": "Content",
      "settings": [
        {
          "type": "richtext",
          "id": "richtext_content",
          "label": "Rich Text Content"
        },
        {
          "type": "liquid",
          "id": "html_content",
          "label": "HTML Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_caption",
          "label": "Image Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Basmil Mixed Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
