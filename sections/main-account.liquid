          <p class="px-[20px]">
            {{ 'customer.orders.none' | t }}
            <a
              href="{{ routes.all_products_collection_url }}"
              class="mt-[4.8rem] text-[#68453D!important] underlined-link"
            >
              {{- 'general.continue_shopping' | t -}}
            </a>
          </p>
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        {%- if paginate.parts.size > 0 -%}
          <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
            <ul role="list">
              {%- if paginate.previous -%}
                <li>
                  <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                    </svg>
                  </a>
                </li>
              {%- endif -%}

              {%- for part in paginate.parts -%}
                <li>
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                      {{- part.title -}}
                    </a>
                  {%- else -%}
                    {%- if part.title == paginate.current_page -%}
                      <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                        {{- part.title -}}
                      </span>
                    {%- else -%}
                      <span>{{ part.title }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </li>
              {%- endfor -%}

              {%- if paginate.next -%}
                <li>
                  <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                    </svg>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endif -%}
    {% endpaginate %}

    {% comment %}
      <div>
        <h2>{{ 'customer.account.details' | t }}</h2>
        {{ customer.name }}
        {{ customer.default_address | format_address }}

        <a href="{{ routes.account_addresses_url }}">
          {{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})
        </a>
      </div>
    {% endcomment %}
  </div>
</div>

<div id="recover" class="customer font-sans reset-password section-{{ section.id }}-padding">
  <h1 class="font-sans font-[500]" id="reset-password" tabindex="-1">
    {{ 'customer.reset_password.title' | t }}
  </h1>

  <div>
    {%- form 'recover_customer_password', id: 'RecoverPasswordForm' -%}
      <div class="field">
        <label for="RecoverEmail">
          {{ 'customer.recover_password.subtext' | t }}
        </label>
        <input
          type="email"
          name="email"
          id="RecoverEmail"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          placeholder="{{ 'customer.login_page.email' | t }}"
        >
      </div>

      <button type="submit" class="button font-sans w-full">
        {{ 'customer.login_page.submit' | t }}
      </button>

      <p id="recoverSuccessMessage" class="note note--success hidden"></p>
      <p id="recoverErrorMessage" class="note note--error hidden"></p>
    {%- endform -%}
  </div>
</div>

<script>
  function toggleRecoverElements() {
    const hash = window.location.hash;
    const recoverElement = document.querySelector('#recover');
    const hideWithRecoverElement = document.querySelector('.hide-with-recover');

    if (hash === '#recover') {
      recoverElement.style.display = 'block';
      document.querySelector('.active-recover').classList.add('active');
      document.querySelector('.recover-not-active').classList.remove('active');
      hideWithRecoverElement.style.display = 'none';
    } else {
      recoverElement.style.display = 'none';
      document.querySelector('.recover-not-active').classList.add('active');
      document.querySelector('.active-recover').classList.remove('active');
      hideWithRecoverElement.style.display = 'block';
    }
  }

  // Initial check
  toggleRecoverElements();

  // Listen for hash changes
  window.addEventListener('hashchange', toggleRecoverElements);
</script>

<style>
  .hidden {
    display: none;
  }

  .note--success {
    color: green;
    margin-top: 10px;
  }

  .note--error {
    color: red;
    margin-top: 10px;
  }
</style>

