
<section class="resources-hub section-{{ section.id }}">
  <div class="resources-hub__inner page-width">

    <div class="resources-hub__group resources-hub__group--publications">

      <div class="resources-hub__group-header">
        <h2 class="resources-hub__heading h1">
          {{ section.settings.heading }}
        </h2>

        {% if section.settings.button_label != blank %}
          <a
            class="resources-hub__outline-button button--secondary button"
            href="{{ section.settings.button_link }}"
          >
            {{ section.settings.button_label }}
            {% render 'icon-link' %}
          </a>
        {% endif %}
      </div>

      <div class="resources-hub__publication-table">
        {% for block in section.blocks %}
          <article
            class="resources-hub__publication-row"
            {{ block.shopify_attributes }}
          >
            <div class="resources-hub__publication-title-wrap">
              <h3 class="resources-hub__publication-title">
                <a href="{{ block.settings.link }}">
                  {{ block.settings.title }}
                </a>
              </h3>
            </div>

            <div class="resources-hub__publication-date">
              {{ block.settings.subtitle }}
            </div>

            <div class="resources-hub__publication-action">
              <a
                class="resources-hub__publication-link"
                href="{{ block.settings.link }}"
                aria-label="{{ block.settings.title }}"
              >
                {% render 'icon-link' %}
              </a>
            </div>
          </article>
        {% endfor %}
      </div>

    </div>

  </div>
</section>

<style>
.section-{{ section.id }} {
  --section-gap: clamp(56px, 5.75vw, 110px);
  --heading-content-gap: clamp(24px, 2.35vw, 45px);
  --publication-item-padding: clamp(18px, 2.1vw, 40px);
  --border-color: rgba(0, 0, 0, 0.08);
  --text-muted: #A5A5A5;
  --accent-gold: #E9BE5F;

    padding-bottom: 80px;
}

.section-{{ section.id }} .resources-hub__inner {
  display: flex;
  flex-direction: column;
  gap: var(--section-gap);
}

.section-{{ section.id }} .resources-hub__group {
  display: flex;
  flex-direction: column;
  gap: var(--heading-content-gap);
}

.section-{{ section.id }} .resources-hub__group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

@media screen and (max-width: 749px) {
  .section-{{ section.id }} .resources-hub__group {
    display:grid;
    grid-template-areas:
      "heading"
      "cards"
      "button";
    gap:20px;
  }

  .section-{{ section.id }} .resources-hub__group-header {
    display:contents;
  }

  .section-{{ section.id }} .resources-hub__heading {
    grid-area:heading;
  }

  .section-{{ section.id }} .resources-hub__outline-button {
    grid-area:button;
    width:max-content;
  }

  .section-{{ section.id }} .resources-hub__publication-table {
    grid-area:cards;
  }
}
</style>

{% schema %}
{
  "name": "Resources List",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Resources"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "resource",
      "name": "Resource",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Date / Subtitle"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Resources List"
    }
  ]
}
{% endschema %}