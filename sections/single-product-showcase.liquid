      <!-- Right Side: Product Image -->
      <div class=" scale-[1.05] sm:scale-100 {% if section.settings.image_layout == 'right' %}order-2{% else %}order-1{% endif %} w-max  max-w-[36.73%] sm:max-w-[100%] sm:h-auto">
        <img
          src="{{ product.featured_image | img_url: 'master' }}"
          alt="{{ product.title }}"
          id="product-image"
          class="w-full h-auto"
          width="225"
          height="228"
        >
      </div>
    </div>
  </div>

{% else %}
  <p>Please select a product to display.</p>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
      const variants = [
        {% for variant in product.variants %}
        {
          id: {{ variant.id }},
          title: "{{ variant.title | escape }}",
          price: "{{ variant.price | money | replace: '.00', '' }}",
          compare_at_price: "{{ variant.compare_at_price | money | replace: '.00', ''}}",
          grams: "{{ variant.grams }}",
          featured_image: {
            src: "{{ variant.featured_image | default: product.featured_image | image_url }}",
            alt: "{{ variant.featured_image.alt| default: variant.title }}"
          }
        }{% if forloop.last %}{% else %},{% endif %}
        {% endfor %}
      ];
  
      const titleElement = document.getElementById('product-title');
      const priceElement = document.getElementById('product-price');
      const imageElement = document.getElementById('product-image');
      const mobileproductimage = document.getElementById('mobile-product-image');
      const variantIdInput = document.getElementById('variant-id');
      const variantButtons = document.querySelectorAll('.variant-option');
      variantButtons.forEach(function(button) {
          button.addEventListener('click', function() {
              variantButtons.forEach(function(b) {
                  b.classList.remove('active');
              });
              this.classList.add('active');
          });
      });
  
      mobileproductimage.innerHTML = `<img src="${variants[0].featured_image.src}" alt="${variants[0].featured_image.alt}" class="w-[33rem] h-auto" width="225" height="228">`;
  
      document.querySelectorAll('.variant-option').forEach(function(button) {
          button.addEventListener('click', function() {
              const variantId = this.getAttribute('data-variant-id');
              const selectedVariant = variants.find(v => v.id == variantId);
              
              if (selectedVariant) {
                  titleElement.textContent = `${selectedVariant.title}`;
                  priceElement.innerHTML = `<s class="original-price mr-[16px!important]">${selectedVariant.compare_at_price}</s> ${selectedVariant.price}`;
                  imageElement.src = selectedVariant.featured_image.src;
                  variantIdInput.value = selectedVariant.id;
                  mobileproductimage.innerHTML = `<img src="${selectedVariant.featured_image.src}" alt="${selectedVariant.title}" class="w-[33rem] h-auto" width="225" height="228">`;
                }
          });
      });
  
  });
</script>

