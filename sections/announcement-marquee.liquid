<style>
.marquee-container {
  width: 100%;
  overflow: hidden;
  background: rgb(var(--color-foreground));
  padding: 1.4rem 0;
}

.marquee-track {
  display: inline-flex;
  white-space: nowrap;
  animation: marquee-scroll 18s linear infinite;
}

.marquee-item {
  display: inline-block;
  padding: 0 2.5rem;
  color: #fff;
}

.marquee-item-text {
  font-size: 1.4rem;
  color: #fff;
  text-decoration: none;
}

@keyframes marquee-scroll {
  0% {
    transform: translateX(100vw);
  }
  100% {
    transform: translateX(-100%);
  }
}

.marquee-container:hover .marquee-track {
  animation-play-state: paused;
}

@media (max-width: 768px) {
  .marquee-container {
    padding: 0.5rem 0;
    height: 50px;
    display: flex;
    align-items: center;
  }

  .marquee-item {
    padding: 0 1rem;
  }
}
</style>

<div
  class="marquee-container announcement-bar bg-tertiary color-{{ section.settings.color_scheme }}"
  role="region"
  aria-label="{{ 'sections.header.announcement' | t }}"
  {{ section.shopify_attributes }}
  id="popupButton"
>
  <div class="marquee-track">
    {%- for block in section.blocks -%}
      {%- if block.type == 'announcement' and block.settings.text != blank -%}
        <div class="marquee-item">
          {%- if block.settings.link != blank and section.settings.link_type == 'link' -%}
            <a class="marquee-item-text font-sans" href="{{ block.settings.link }}">
              {{ block.settings.text | escape }}
            </a>
          {%- else -%}
            <span class="marquee-item-text font-sans">
              {{ block.settings.text | escape }}
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>