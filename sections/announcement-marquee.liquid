<style>
.marquee-container {
  width: 100%;
  overflow: hidden;
  position: relative;
  background: rgb(var(--color-foreground));
  padding: 1.4rem 0;
}

.marquee-track {
  display: flex;
  width: max-content;
  animation: marquee 25s linear infinite;
  will-change: transform;
}

.marquee-item {
  flex: 0 0 auto;
  padding: 0 2.5rem;
  white-space: nowrap;
}

.marquee-item-text {
  font-size: 1.4rem;
  color: #fff;
  text-decoration: none;
}

.marquee-container:hover .marquee-track {
  animation-play-state: paused;
}

@keyframes marquee {
  from {
    transform: translate3d(0,0,0);
  }
  to {
    transform: translate3d(-33.3333%,0,0);
  }
}

@media screen and (max-width:768px){
  .marquee-container{
    padding:.5rem 0;
    height:50px;
    display:flex;
    align-items:center;
  }

  .marquee-item{
    padding:0 .8rem;
  }
}
</style>

<div
  class="marquee-container announcement-bar bg-tertiary color-{{ section.settings.color_scheme }}"
  role="region"
  aria-label="{{ 'sections.header.announcement' | t }}"
  {{ section.shopify_attributes }}
  id="popupButton"
>
  <div class="marquee-track">

    {%- for i in (1..3) -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'announcement' and block.settings.text != blank -%}

          <div class="marquee-item">

            {%- if block.settings.link != blank and section.settings.link_type == 'link' -%}
              <a
                href="{{ block.settings.link }}"
                class="marquee-item-text font-sans"
              >
                {{ block.settings.text | escape }}
              </a>
            {%- else -%}
              <span class="marquee-item-text font-sans">
                {{ block.settings.text | escape }}
              </span>
            {%- endif -%}

          </div>

        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}

  </div>
</div>