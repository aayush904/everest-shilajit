<style>
  .marquee-container {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 1.4rem 0;
    background: rgb(var(--color-foreground));
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 20s linear infinite;
  }

  .marquee-group {
    display: flex;
    flex-shrink: 0;
  }

  .marquee-item {
    flex-shrink: 0;
    padding: 0 2.5rem;
    white-space: nowrap;
  }

  .marquee-item-text {
    font-size: 1.4rem;
    color: #fff;
    text-decoration: none;
  }

  .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .marquee-container {
      padding: 0.5rem 0;
      height: 50px;
      display: flex;
      align-items: center;
    }

    .marquee-item {
      padding: 0 0.8rem;
    }
  }
</style>

<div
  class="marquee-container announcement-bar bg-tertiary color-{{ section.settings.color_scheme }}"
  role="region"
  aria-label="{{ 'sections.header.announcement' | t }}"
  {{ section.shopify_attributes }}
  id="popupButton"
>
  <div class="marquee-track">

    <div class="marquee-group">
      {%- for block in section.blocks -%}
        {%- if block.type == 'announcement' and block.settings.text != blank -%}
          <div class="marquee-item">
            {%- if block.settings.link != blank and section.settings.link_type == 'link' -%}
              <a class="marquee-item-text font-sans" href="{{ block.settings.link }}">
                {{ block.settings.text | escape }}
              </a>
            {%- else -%}
              <span class="marquee-item-text font-sans">
                {{ block.settings.text | escape }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="marquee-group" aria-hidden="true">
      {%- for block in section.blocks -%}
        {%- if block.type == 'announcement' and block.settings.text != blank -%}
          <div class="marquee-item">
            {%- if block.settings.link != blank and section.settings.link_type == 'link' -%}
              <a class="marquee-item-text font-sans" href="{{ block.settings.link }}">
                {{ block.settings.text | escape }}
              </a>
            {%- else -%}
              <span class="marquee-item-text font-sans">
                {{ block.settings.text | escape }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>