{% schema %}
{
  "name": "Image + Tab Slider",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Side Image"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Section Title",
      "default": "Feel energetic in as little as 7 days"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "Weeks 1 - 2"
        },
        {
          "type": "text",
          "id": "slide_heading",
          "label": "Heading",
          "default": "Enhanced physical performance and health."
        },
        {
          "type": "textarea",
          "id": "slide_text",
          "label": "Description",
          "default": "Your description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image + Tab Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% style %}
  {% assign id =  "#shopify-section-" | append: section.id %}
  /* slick spacing reset */
  {{id}} .slick-dotted.slick-slider{
    margin-bottom:0;
  }

  /* wrapper */
  {{id}} .slider-wrapper{
    display:-webkit-box;
    display:-ms-flexbox;
    display:flex;

    -webkit-box-align:center;
    -ms-flex-align:center;
    align-items:stretch;

    -webkit-box-pack:justify;
    -ms-flex-pack:justify;
    justify-content:space-between;

    gap:24px 40px;
  }

  {{id}} .slider-image{
    max-width:610px;
    width:42.36%;
  }

  {{id}} .slider-image img{
    width:100%;
    -webkit-border-radius:12px;
    border-radius:12px;
    height:100%;
    object-fit:cover;
  }

  {{id}} .slider-content{
    max-width:775px;
    width:53.75%;
  }

  {{id}} .slide{
    background:#F5F2EC;
    height:100%;
    height:-webkit-fill-available;
    min-height:39rem;
  }

  {{id}} .slider-content h2{
    margin-bottom:25px;
    color:#2d2d2d;
  }

  /* tab nav */
  {{id}} .tab-nav{
    display:-webkit-box;
    display:-ms-flexbox;
    display:flex;

    gap:10px;
    list-style:none;
    padding:1.2rem;
    background:#F5F2EC;
    margin-bottom:2rem;
    -webkit-border-radius:10px;
    border-radius:10px;
  }

  /* gap fallback */
  {{id}} .tab-nav li{
    margin-right:10px;
  }
  {{id}} .tab-nav li:last-child{
    margin-right:0;
  }

  {{id}} .tab-nav li{
    padding:10px 20px;
    border:1px solid #dcdcdc;
    cursor:pointer;
    width:100%;
    font-weight:600;
    text-align:center;
    background:#fff;

    -webkit-transition:all .3s ease;
    -o-transition:all .3s ease;
    transition:all .3s ease;
  }

  {{id}} .tab-nav li:first-of-type{
    -webkit-border-top-left-radius:4px;
            border-top-left-radius:4px;
    -webkit-border-bottom-left-radius:4px;
            border-bottom-left-radius:4px;
  }

  {{id}} .tab-nav li:last-of-type{
    -webkit-border-top-right-radius:4px;
            border-top-right-radius:4px;
    -webkit-border-bottom-right-radius:4px;
            border-bottom-right-radius:4px;
  }

  {{id}} .tab-nav li.active{
    background:#9F5601;
    color:#fff;
    border-color:#9F5601;
  }

  /* slick slides */
  {{id}} .slick-slides{
    display:-webkit-box;
    display:-ms-flexbox;
    display:flex;
    width:100%;
    overflow:hidden;

    gap:8px;
    -ms-flex-wrap:nowrap;
        flex-wrap:nowrap;
  }

  {{id}} .slick-slides.slick-initialized{
    display:block;
  }
  {{id}} .slick-slides .slide:not(.slick-slide){
  min-width:100%;
}
  /* slide content */
  {{id}} .slick-slides .slide{
    background:#F5F2EC;
    padding:4rem 4.8rem;
    width:100%;
    width:100%;

    -webkit-border-radius:8px;
            border-radius:8px;

    display:-webkit-box;
    display:-ms-flexbox;
    display:flex;

    -webkit-box-orient:vertical;
    -webkit-box-direction:normal;
        -ms-flex-direction:column;
            flex-direction:column;

    -webkit-box-pack:center;
        -ms-flex-pack:center;
            justify-content:center;

    min-height:39rem;
  }

  {{id}} .slick-slides h3{
    font-weight:700;
    margin-bottom:12px;
  }

  {{id}} .slick-slides p{
    line-height:1.3;
  }

  /* dots */
  {{id}} .slick-slides .slick-dots{
    position:static;
    text-align:start;
  }

  {{id}} .slick-slides .slick-dots li{
    width:2.4rem!important;
    height:2.4rem!important; /* aspect-ratio fallback */
    border:1px solid #68453D;
    background:transparent;
  }

  {{id}} .slick-slides .slick-dots li.slick-active{
    background:#68453D;
  }

  {{id}} .slick-dots{
    padding-top:2.4rem;
  }

  @media(max-width:1280px){
    {{id}} .slider-image,
    {{id}} .slider-content{
      width: 50%;
    }
  }
  /* mobile */
  @media (max-width:998px){
  {{id}} .slick-slides .slide{
    min-height:29rem;
  }
    {{id}} .slider-wrapper{
      -webkit-box-orient:vertical;
      -webkit-box-direction:normal;
          -ms-flex-direction:column;
              flex-direction:column;
    }

    {{id}} .slick-slides .slick-dots{
      text-align:center;
    }

    {{id}} .slick-slides .slick-dots li{
      width:12px!important;
      height:12px!important;
    }

    {{id}} .slider-image,
    {{id}} .slider-content{
      width:100%;
      max-width:100%;
    }

    {{id}} .tab-nav li{
      padding:8px;
      font-size:14px;
    }

    {{id}} .slick-slides .slide{
      padding:12px;
    }

    {{id}} .slick-dots{
      padding-top:8px;
    }
  }
{% endstyle %}

<section class="page-width image-text-tab-slider">
  <div class="slider-wrapper">
    <!-- Left Side Image -->
    <div class="slider-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url }}" alt="Slider Image" width="900" height="900" loading="lazy">
      {% endif %}
    </div>

    <!-- Right Side Content -->
    <div class="slider-content">
      <h2>{{ section.settings.title }}</h2>

      <!-- Tab Nav -->
      <ul class="tab-nav">
        {% for block in section.blocks %}
          <li data-slide="{{ forloop.index0 }}" class="{% if forloop.first %}active{% endif %}">
            {{ block.settings.tab_title }}
          </li>
        {% endfor %}
      </ul>

      <!-- Slick Slider -->
      <div class="slick-slides">
        {% for block in section.blocks %}
          <div class="slide" {{ block.shopify_attributes }}>
            <h3 class="font-sans">{{ block.settings.slide_heading }}</h3>
            <p>{{ block.settings.slide_text }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script defer>
  document.addEventListener('DOMContentLoaded', function () {
    var $slider = $('.slick-slides');

    $slider.slick({
      slidesToShow: 1,
      slidesToScroll: 1,
      arrows: false,
      dots: true,
      adaptiveHeight: true,
      infinite: false,
    });

    // Tab click = change slide
    $('.tab-nav li').on('click', function () {
      var index = $(this).data('slide');
      $slider.slick('slickGoTo', index);
      $('.tab-nav li').removeClass('active');
      $(this).addClass('active');
    });

    // Sync tab when slider changes
    $slider.on('afterChange', function (event, slick, currentSlide) {
      $('.tab-nav li').removeClass('active');
      $('.tab-nav li[data-slide="' + currentSlide + '"]').addClass('active');
    });
  });
</script>
