{% assign sections = section.settings %}
<style>
      #shopify-section-{{ section.id }} {
        {% if sections.background_on == 'main_section' %}
          {% if sections.background_type == 'color'  %}
            background: {% if sections.background_gradient != blank%}{{sections.background_gradient}} {% else %} {{ sections.background_color }}
          {% endif %};
        {% elsif sections.background_type == 'image' and sections.background_image != blank %}
            background:{% if sections.background_gradient != blank%}{{sections.background_gradient}},{% endif %}url('{{ sections.background_image | image_url }}') no-repeat {{' '}}{{ sections.background_position }};
            background-size: {{ sections.background_size }};
      {% endif %};
    {% endif %};
    }

    @media (max-width: 1167px) {
      #shopify-section-{{ section.id }} .main-wrapper {
        max-width: 100% !important;
        margin: 0 auto!important;
        width:100%!important;
      }
    }

    @media (max-width: 767px) {
      #shopify-section-{{ section.id }} .main-wrapper {
        padding-left: 0 16px 4rem 16px !important;
        max-width: 100% !important;
      }
    }

    #shopify-section-{{ section.id }} .wrapper{
      width:{{ sections.width }};
      min-height:{{ sections.minheight }};
    margin:{{sections.margin}};
    padding: {{sections.padding}};
    {% if sections.background_on == 'content_part' %}
      {% if sections.background_type == 'color' and sections.background_color %}
        background: {{ sections.background_color }};
      {% elsif sections.background_type == 'image' and sections.background_image %}
        background: url('{{ sections.background_image  | image_url }}') no-repeat {{ sections.background_position }};
        background-size: {{ sections.background_size }};
      {% else %}
      ''
      {% endif %};
    {% endif %};
  }


    @media(max-width:768px){
        #shopify-section-{{ section.id }} .wrapper.wrapper{
          padding: {% render 'mobile_spacing'  padding: section.settings.padding %};
        }
    }

      #shopify-section-{{ section.id }} .main-wrapper .imagepart{
    width:{{ sections.image_width }};

  }

  #shopify-section-{{ section.id }} .contentside .text-tertiary,
  #shopify-section-{{ section.id }} #{{ sections.custom_id }} h2.text-tertiary,
  #{{ sections.custom_id }} h2.text-tertiary {
    font-family: var(--font-heading-family), "Instrument Sans", sans-serif !important;
    font-weight: 400 !important;
    font-size: 5.8rem !important;
    line-height: 110% !important;
    letter-spacing: 0% !important;
  }
</style>

{% capture icon_items %}
  {% assign has_icon_items = false %}
  {% for block in section.blocks %}
    {% if block.type == 'icon_item' %}
      {% assign has_icon_items = true %}
    {% endif %}
  {% endfor %}
  {% if has_icon_items %}
    <div class="icon-items-grid">
      {% for block in section.blocks %}
        {% if block.type == 'icon_item' %}
          <div class="icon-item" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <span class="icon-item__icon">
                {{ block.settings.icon | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.text }}
              </span>
            {% endif %}
            {% if block.settings.text != blank %}
              <span class="icon-item__text">{{ block.settings.text }}</span>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
{% endcapture %}

<style>
  #shopify-section-{{ section.id }} .icon-items-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 3.2rem 2.4rem;
    width: 100%;
    margin: 0.8rem 0;
  }
  #shopify-section-{{ section.id }} .icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.8rem;
    width: calc((100% - 4.8rem) / 3);
    max-width: 16rem;
  }
  #shopify-section-{{ section.id }} .icon-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 16rem;
  }
  #shopify-section-{{ section.id }} .icon-item__icon img {
    width: 100%;
    max-width: 16rem;
    height: auto;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .icon-item__text {
    font-family: var(--font-heading-family), "Instrument Sans", sans-serif !important;
    font-weight: 400 !important;
    font-size: 5.8rem !important;
    line-height: 110% !important;
    letter-spacing: 0% !important;
    color: #1f1b16;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .icon-items-grid {
      gap: 2.4rem 1.6rem;
    }
    #shopify-section-{{ section.id }} .icon-item {
      width: calc((100% - 3.2rem) / 3);
    }
  }
</style>

{% for block in section.blocks %}
  {% case block.type %}
    {% when 'content' %}
      {% capture contents %}
        {% if block.settings.subtitle != blank %}
          <span class="subtitle">
            {{ block.settings.subtitle }}
          </span>
        {% endif %}
        {% if block.settings.title != blank %}
          {% assign tag = '<' | append: sections.heading_size %}
          {% if section.settings.heading_color != blank%}
            {% assign style = 'style="color:' |append: section.settings.heading_color | append: ';"' %}
          {% else %}
            {% assign style = '' %}
          {%endif%}
          {% if sections.heading_size == 'h3' %} {% assign extra_class =  'bigger' %}{% endif %}
          {% assign tag_attributes = ' class="text-tertiary -mb-[0.8rem] ' | append:extra_class | append: ' ' | append: sections.alignment |append: ' sm:text-center" ' | append: style %}
          {% if block.settings.title contains tag %}
            {% assign final_tag = tag | append: tag_attributes %}
            {{ block.settings.title | replace: tag, final_tag }}
          {% else %}
            <{{ sections.heading_size }} {{ tag_attributes }}>
              {{ block.settings.title }}
            </{{ sections.heading_size }}>
          {% endif %}
        {% endif %}

        {{ icon_items }}

        {% if block.settings.description  != blank  %}
          <div class="{{sections.alignment}} sm:text-center description">{{ block.settings.description }}</div>
        {% endif %}
        {% if block.settings.button_text !=blank or block.settings.button_text_2 !=blank %}
          <div class="flex 
            {% if block.settings.button_text !=blank and block.settings.button_text_2 !=blank  %}
              justify-between
            {% else %}
              {{sections.alignment}}
            {% endif %}
            w-[85%] sm:w-full buttons-section gap-[2.4rem]">
            {% if block.settings.button_text !=blank %}
              {% assign linkurl = block.settings.button_link  %}
              <a class=" button border-none flex items-center sm:w-full justify-center sm:text-center" href="{{ block.settings.button_link }}">
                {{- block.settings.button_text  -}}
              </a>
            {% endif %}
            {% if block.settings.button_text_2 !=blank  %}
              <a class=" alternative sm:w-full font-sans hover:text-tertiary border-none flex items-center sm:border sm:border-solid border-[#000] justify-center sm:text-center" href="{{ block.settings.button_link_2 }}">
                {{- block.settings.button_text_2 -}}
              </a>
            {% endif %}
          </div>
      {% endif %}
      {% endcapture %}

    {% when 'image' %}
      {% capture image %}

        {% if block.settings.image != blank or block.settings.svg != blank%}
<style>

          #shopify-section-{{ section.id }} .main-wrapper .imagepart{
            width:{{ block.settings.image_width }};

          }

          @media (max-width: 767px) {
            #shopify-section-{{ section.id }} .main-wrapper .imagepart.imagepart {
              width: 100% ;
            }
          }
        </style>


        {% if block.settings.image_type == 'image'%}

          {% if block.settings.image != blank %}
            {% if sections.image_clickable == false or linkurl == blank %}
              {% assign clickable_class = ' imagepart ' %}
            {% else %} 
              {% assign clickable_class = ' w-full ' %}
            {% endif %}
            
            {% assign img_class = sections.image_clickable| append: ' ' | append: clickable_class | append: sections.alignment | append: ' object-contain sm:max-w-[100%]' %}
            {% assign image_alt = block.settings.image.alt | default: block.settings.image_alt  %}  
            {% if section.index == 1 %}
              {% assign loading = 'eager' %}
              {% assign fetch_priority = 'high' %}
            {% else %}
              {% assign loading = 'lazy' %}
              {% assign fetch_priority = 'auto' %}
            {% endif %}

            {{ block.settings.image
              | image_url: width: 1200
              | image_tag:
                widths: '320, 450, 600, 750, 980, 1200',
                sizes: '(max-width: 767px) 100vw, 50vw',
                class: img_class,
                alt: image_alt,
                width: block.settings.image.width,
                height: block.settings.image.height,
                loading: loading,
                fetchpriority: fetch_priority
            }}
          {% endif %}


        {% elsif  block.settings.image_type == 'svg' %}
            {% if block.settings.svg != blank %}
                {% if block.settings.svg contains "<svg" %}
                  
                  {% assign svgwidth = '<svg class="imagepart h-auto  sm:max-w-[100%]"'  %}
                  {{ block.settings.svg | strip_newlines | replace: '<svg', svgwidth }}                
                  {% else %}
                  <svg class="imagepart" xmlns="http://www.w3.org/2000/svg"  fill="none" class="h-auto sm:max-w-[100%]">
                    <use xlink:href="{{'main.svg' | asset_url }}#{{block.settings.svg | strip_newlines | escape}}"></use>
                  </svg>                 
                {% endif %}
            {% endif %}
        {% else %}
            <div class="imagepart h-auto  sm:max-w-[100%]">
              {% assign code = block.settings.svg %}
              {% if code and code contains '[' and code contains ']' %}
                {% assign first_bracket = code | split: '[' | last %}
                {% assign content_inside_brackets = first_bracket | split: ']' | first %}
                {% if content_inside_brackets != code %}
                  {% include  content_inside_brackets %}
                {% else %}
                  {{ block.settings.svg | strip_newlines}}
                {% endif %}
              {% else %}
                {{ block.settings.svg | strip_newlines}}                
            {% endif %}


            </div>
        {% endif %}
      {% endif %}

        {% endcapture %}
  {% endcase %}
{% endfor %}

<div
  {% if sections.custom_id %}
    id="{{ sections.custom_id }}"
  {% endif %}
  class="main-wrapper wrapper flex justify-center w-full {{ sections.custom_class }}"
>
  <div
    class="
      contain-wrapper
      flex {{ sections.layout }} flex-nowrap

      {% if sections.valignment == "top"  %}
        items-start
      {% elsif sections.valignment == "center" %}
        items-center
      {% else %}
        items-end
      {% endif %}
      {% if image %}
      justify-between
      {% else %}
      justify-center
      {% endif %}
      w-[100%] sm:gap-[4rem!important] md:gap-[2.5rem!important] sm:flex-col sm:justify-center sm:text-center sm:items-center
    "
    style="gap: {{sections.gapimage}};"
  >
    <div
      class="
        contentside flex {{sections.alignment}} gap-[3.2rem] sm:gap-[2rem]  sm:relative flex-col items-start   md:p-6 sm:max-w-[100%!important] sm:text-center sm:items-center w-full max-content-width
        {% comment %} md:max-w-[50%!important] {% endcomment %}
      "
      style="max-width:{{ sections.content_width }}; color:{{ sections.content_color }};"
    >
      {{ contents }}
    </div>
    {% if sections.image_clickable and linkurl != blank %}
      <a href="{{linkurl }}" class="imagepart" style="cursor: pointer;">
        {{ image }}
      </a>
    {% else %}
      {{ image }}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Basmil Image Text",
  "class": "basmilTextImage",
  "settings": [
    {
      "type": "header",
      "content": "Heading Tag"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ]
    },
    {
      "type": "header",
      "content": "Image Layout"
    },
    {
      "type": "checkbox",
      "id": "image_clickable",
      "label": "Make the Image Clickable",
      "default": false
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Layout",
      "default": "imagelast",
      "options": [
        {
          "value": "imagefirst",
          "label": "Left"
        },
        {
          "value": "imagelast",
          "label": "Right"
        },
        {
          "value": "imagetop",
          "label": "Top"
        },
        {
          "value": "imagebottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content alignment"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content Alignment",
      "default": "contentstart",
      "options": [
        {
          "value": "contentstart",
          "label": "Left"
        },
        {
          "value": "contentcenter",
          "label": "Center"
        },
        {
          "value": "contentend",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "valignment",
      "label": "Content Verticle Alignment",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "bottom"
        }
      ]
    },
    {
      "type": "text",
      "id": "gapimage",
      "label": "Content and Image Gap",
      "default": "5.3rem"
    },
    {
      "type": "header",
      "content": "Content Part Width"
    },
    {
      "type": "text",
      "id": "content_width",
      "label": "Content Width",
      "default": "50%"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "text",
      "id": "padding",
      "label": "Padding",
      "default": "12rem 16px",
      "info": "eg: 16px 16px 16px 16px"
    },
    {
      "type": "text",
      "id": "margin",
      "label": "Margin",
      "default": "0",
      "info": "eg: 16px 16px 16px 16px"
    },
    {
      "type": "header",
      "content": "Custom Class/id"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    },
    {
      "type": "header",
      "content": "Section Width"
    },
    {
      "type": "text",
      "id": "width",
      "label": "Width",
      "default": "116.6rem",
      "info": "eg: 116.6rem"
    },
    {
      "type": "header",
      "content": "Section Height"
    },
    {
      "type": "text",
      "id": "minheight",
      "label": "Min Height",
      "default": "auto",
      "info": "eg: 116.6rem"
    },
    {
      "type": "header",
      "content": "Section Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "text",
      "id": "background_gradient",
      "label": "Background Gradient",
      "info": "eg: linear-gradient(90deg, rgba(2,0,36,1) 0%, rgba(9,9,121,1) 35%, rgba(0,212,255,1) 100%)"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "select",
      "id": "background_on",
      "label": "Choose Background on",
      "default": "content_part",
      "options": [
        {
          "value": "content_part",
          "label": "Content Part"
        },
        {
          "value": "main_section",
          "label": "Main Section"
        }
      ]
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background Position",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "background_size",
      "label": "Background Size",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content Color"
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Contents",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Heading"
        },
        {
          "type": "liquid",
          "id": "title",
          "label": "Title",
          "default": "Title Here"
        },
        {
          "type": "header",
          "content": "Sub Heading"
        },
        {
          "type": "liquid",
          "id": "subtitle",
          "label": "Sub Title"
        },

        {
          "type": "header",
          "content": "Paragraph"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Paragraphs Here</p>"
        },
        {
          "type": "header",
          "content": "Buttons"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Link Here"
        },
        {
          "type": "url",
