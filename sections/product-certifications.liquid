{%- comment -%}
  Product Certifications
  - One heading setting (section.settings.heading)
  - One product per block (block.settings.product) — certifications are pulled from the
    product's metafields exactly like the "Lab Tested Quality" section
    (product.metafields.custom.certifications.value -> list of metaobjects).
  - Each product renders as an accordion item. Each certification renders as a card
    whose "View Report" link opens the report file in a new tab/target.
{%- endcomment -%}

{%- style -%}
  .product-certs-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .product-certs__inner {
    max-width: 147.2rem;
    margin: 0 auto;
    padding-left: 1.6rem;
    padding-right: 1.6rem;
  }

  .product-certs__breadcrumb {
    font-family: var(--font-body-family);
    margin: 0 0 26px;
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1;
  }

  .product-certs__breadcrumb a,
  .product-certs__breadcrumb span {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 1;
    color: #A5A5A5;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .product-certs__breadcrumb a:hover {
    color: #382E2A;
  }

  .product-certs__breadcrumb span[aria-current] {
    color: #382E2A;
  }

  .product-certs__heading {
    font-family: 'Instrument Sans';
    color: #382E2A;
    font-size: 64px;
    font-weight: 600;
    line-height: 100%;
    margin: 0 0 25px;
  }

  .product-certs__item {
    border-bottom: 1px solid #37232033;
  }

  .product-certs__summary {
    width: 100%;
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 40px 0;
  }

  .product-certs__summary span {
    font-size: 26px;
    font-weight: 500;
    line-height: 125%;
    color:#2B2B2B;
    font-family: 'Instrument Sans';
  }

  .product-certs__sign {
    position: relative;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .product-certs__sign::before,
  .product-certs__sign::after {
    content: '';
    position: absolute;
    background-color: #382E2A;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .product-certs__sign::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    transform: translateY(-50%);
  }

  .product-certs__sign::after {
    left: 50%;
    top: 0;
    width: 1.5px;
    height: 100%;
    transform: translateX(-50%) rotate(0deg);
  }

  .product-certs__item.is-open .product-certs__sign::after {
    opacity: 0;
    transform: translateX(-50%) rotate(90deg);
  }

  /* Smooth height animation: 0fr -> 1fr on a grid wrapper, no JS height measuring needed. */
  .product-certs__content {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.4s ease, opacity 0.4s ease;
  }

  .product-certs__content > * {
    overflow: hidden;
    min-height: 0;
  }

  .product-certs__item.is-open .product-certs__content {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .product-certs__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 25px;
    padding-bottom: 36px;
  }

  /* Fallback when JS is unavailable: show all content. */
  .no-js .product-certs__content {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .product-certs__card {
    display: flex;
    flex-direction: column;
    background-color: {{ section.settings.card_background }};
    border: 1px solid #37232033;
    border-radius: 14px;
    overflow: hidden;
  }

  .product-certs__card-body {
    padding: 25px 22px 30px;
    flex: 1 1 auto;
  }

  .product-certs__icon {
    width: 62px;
    height: 62px;
    object-fit: contain;
    margin-bottom: 12px;
    display: block;
  }

  .product-certs__card-text {
    font-family: 'Instrument Sans';
    color: #000000;
    font-size: 19px;
    line-height: 130%;
    margin: 0;
    letter-spacing: normal;
    font-weight: 400;
  }

  .product-certs__report {
    display: flex;
    align-items: center;
    justify-content: start;
    gap: 5px;
    padding: 18px 21px;
    border-top: 1px solid #37232033;
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: unset;
    text-transform: uppercase;
    color: #3D3733;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .product-certs__report span {
    color: #A5A5A5;
  }

  .product-certs__report svg {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
  }

  .product-certs__report:hover,
  .product-certs__report:focus-visible {
    background-color: #68453D;
    color: #ffffff !important;
  }

  .product-certs__report:hover span,
  .product-certs__report:focus-visible span {
    color: #fff !important;
  }

  .product-certs__empty {
    font-family: var(--font-body-family);
    color: #A5A5A5;
    font-size: 1.5rem;
    padding-bottom: 30px;
  }

  @media screen and (min-width: 750px) {
    .product-certs-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 768px) {
    .product-certs-{{ section.id }} {
      padding-top: 32px;
      padding-bottom: 32px;
    }
    .product-certs__summary span{
      font-size:18px;
    }
    .product-certs__breadcrumb {
      margin: 0 0 18px;
    }
    .product-certs__sign {
      width:16px;
      height:16px;
    }
    .product-certs__heading {
      font-size: 32px;
      margin-bottom: 24px;
    }
    .product-certs__summary {
      font-size: 20px;
      padding: 18px 0;
    }
    .product-certs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 15px;
    }
    .product-certs__card-body {
      padding: 22px 14px 10px;
    }
    .product-certs__card-text {
      font-size: 14px;
    }
    .product-certs__icon {
      width: 46px;
      height: 46px;
    }
    .product-certs__report {
      padding: 14px;
    }
    .product-certs__report span {
      font-size: 10.93px;
    }
    .product-certs__inner {
      padding: 0 20px;
    }
  }
{%- endstyle -%}

<section class="product-certs-{{ section.id }}">
  <div class="product-certs__inner">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="product-certs__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home }}</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">{{ section.settings.heading }}</span>
      </nav>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="product-certs__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- liquid
        assign block_product = block.settings.product
        assign certifications = block_product.metafields.custom.certifications.value
        assign item_title = block.settings.title | default: block_product.title
      -%}
      <div class="product-certs__item" {{ block.shopify_attributes }}>
        <button
          type="button"
          class="product-certs__summary"
          aria-expanded="false"
          aria-controls="product-certs-{{ section.id }}-{{ forloop.index0 }}"
        >
          <span>{{ item_title }}</span>
          <span class="product-certs__sign" aria-hidden="true"></span>
        </button>

        <div class="product-certs__content" id="product-certs-{{ section.id }}-{{ forloop.index0 }}" role="region">
          <div>
        {%- if certifications != blank -%}
          <div class="product-certs__grid">
            {%- for cert in certifications -%}
              {%- liquid
                # Metaobject fields expose their value via .value.
                assign cert_icon = cert.icon.value | default: cert.icon

                # The certificate file lives in the `image` field (a file field that may hold a
                # PDF or an image). Fall back to a `certificate` field if named that way.
                assign cert_file = cert.image.value | default: cert.certificate.value | default: cert.image | default: cert.certificate

                # Icon may be an image file (use image_url) or an SVG/generic file (use .url).
                assign icon_url = cert_icon | image_url: width: 192
                if icon_url == blank
                  assign icon_url = cert_icon.url | default: cert_icon.src
                endif

                # Resolve the report URL + type. PDFs expose .url; image files go through image_url.
                assign report_url = ''
                if cert_file != blank
                  assign raw_file_url = cert_file | file_url
                  if raw_file_url contains '.pdf' or cert_file.url contains '.pdf'
                    assign report_url = cert_file.url | default: raw_file_url
                  else
                    assign report_url = cert_file | image_url: width: 1800
                    if report_url == blank
                      assign report_url = cert_file.url | default: raw_file_url
                    endif
                  endif
                endif
              -%}
              {%- comment -%}
                The metaobject title is an inline rich-text field — it stores JSON, not HTML, and Shopify does
                not auto-render metaobject rich text. Build two values from it: cert_title_plain (for alt/aria)
                and cert_title_html (the displayed title, preserving inline bold/italic/links).
              {%- endcomment -%}
              {%- assign cert_title_plain = '' -%}
              {%- capture cert_title_html -%}
                {%- if cert.title.value.children -%}
                  {%- for blk in cert.title.value.children -%}
                    {%- for child in blk.children -%}
                      {%- if child.type == 'link' -%}
                        {%- assign link_text = '' -%}
                        {%- for sub in child.children -%}{%- assign link_text = link_text | append: sub.value -%}{%- endfor -%}
                        {%- assign cert_title_plain = cert_title_plain | append: link_text -%}
                        <a href="{{ child.url }}"{% if child.title != blank %} title="{{ child.title | escape }}"{% endif %}>{{ link_text | escape }}</a>
                      {%- else -%}
                        {%- assign cert_title_plain = cert_title_plain | append: child.value -%}
                        {%- capture node -%}{{ child.value | escape }}{%- endcapture -%}
                        {%- if child.bold -%}{%- capture node -%}<strong>{{ node }}</strong>{%- endcapture -%}{%- endif -%}
                        {%- if child.italic -%}{%- capture node -%}<em>{{ node }}</em>{%- endcapture -%}{%- endif -%}
                        {{ node }}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- assign cert_title_plain = cert.title -%}
                  {{ cert.title | escape }}
                {%- endif -%}
              {%- endcapture -%}
              {%- assign cert_title_plain = cert_title_plain | strip -%}
              {%- assign cert_title_html = cert_title_html | strip -%}
              <a
                 class="product-certs__card"
                 href="{{ report_url }}"
                    target="{{ section.settings.report_link_target }}"
                >
                <div class="product-certs__card-body">
                  {%- if icon_url != blank -%}
                    <img
                      class="product-certs__icon"
                      src="{{ icon_url }}"
                      alt="{{ cert_title_plain | default: item_title | escape }}"
                      width="48"
                      height="48"
                      loading="lazy"
                    >
                  {%- endif -%}
                  <p class="product-certs__card-text">
                    <span class="product-certs__card-title">{{ cert_title_html | default: cert_title_plain }}</span>
                  </p>
                </div>
                {%- if report_url != blank -%}
                  <div
                    class="product-certs__report"
                    rel="noopener"
                    aria-label="{{ section.settings.report_label }}{% if cert_title_plain != blank %} — {{ cert_title_plain | escape }}{% endif %}"
                  >
                    <span>{{ section.settings.report_label }}</span>
                    <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.5M10.5 3.5V9.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                {%- endif -%}
              </a>
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="product-certs__empty">{{ section.settings.empty_text }}</p>
        {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('.product-certs-{{ section.id }}');
    if (!root) return;

    var items = root.querySelectorAll('.product-certs__item');

    items.forEach(function (item) {
      var btn = item.querySelector('.product-certs__summary');
      if (!btn) return;

      btn.addEventListener('click', function () {
        var isOpen = item.classList.contains('is-open');

        // Close every item (single-open accordion).
        items.forEach(function (other) {
          other.classList.remove('is-open');
          var otherBtn = other.querySelector('.product-certs__summary');
          if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
        });

        // Open the clicked one only if it was closed (clicking an open item collapses it).
        if (!isOpen) {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product Certifications",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Certifications"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_home",
      "label": "Breadcrumb home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "card_prefix",
      "label": "Card prefix text",
      "info": "Text shown before each certification title.",
      "default": "Tested by Certified Laboratories for"
    },
    {
      "type": "text",
      "id": "report_label",
      "label": "Report link label",
      "default": "View Report"
    },
    {
      "type": "select",
      "id": "report_link_target",
      "label": "Report link opens in",
      "options": [
        { "value": "_blank", "label": "New tab" },
        { "value": "_self", "label": "Same tab" }
      ],
      "default": "_blank"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "info": "Shown when the selected product has no certifications.",
      "default": "Certifications coming soon."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Certifications are pulled from this product's metafields."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Accordion title",
          "info": "Optional. Defaults to the product title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Certifications",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
