          "settings": {
            "table_content": "<div>\n<tags>\n<tag>Traditional medicine</tag> <tag>Antioxidant activity</tag> </tags>\n<p>Review on shilajit used in traditional Indian medicine</p>\n<a href=\"https://pubmed.ncbi.nlm.nih.gov/21530631/\">Learn More →</a>\n</div>",
