          "type": "text",
          "settings": {
            "question": "What is shilajit liquid?",
            "answer": "<p><br/>Pure shilajit resin dissolved in Himalayan spring water — two ingredients, three drops per serving, 250 servings per bottle.<br/><br/></p>"
          }
        },
        "text_pX9t9Q": {
          "type": "text",
          "settings": {
            "question": "What are the ingredients in pure Himalayan shilajit liquid drops?",
            "answer": "<p>Just two — pure shilajit resin and Himalayan spring water. Nothing else added.</p>"
          }
        },
        "text_QdG8gm": {
          "type": "text",
          "settings": {
            "question": "How do I take shilajit liquid drops?",
            "answer": "<p>Three drops once or twice daily, held under the tongue for 30 seconds or mixed into lukewarm water, milk, or tea.</p>"
          }
        },
        "text_W4R3QQ": {
          "type": "text",
          "settings": {
            "question": "When is the best time to take shilajit liquid?",
            "answer": "<p>Morning on an empty stomach works best — avoid late evening as it may interfere with sleep for some people.</p>"
          }
        },
        "text_ABT3Qd": {
          "type": "text",
          "settings": {
            "question": "How long before I notice anything?",
            "answer": "<p>Most customers reach out between weeks three and ten — we suggest at least 30 days before evaluating.</p>"
          }
        },
        "text_nPgJ4e": {
          "type": "text",
          "settings": {
            "question": "Can kids take shilajit liquid drops?",
            "answer": "<p>No, this product is not intended for anyone under 18 years of age.</p>"
          }
        }
      },
