        "collapsible_tab_Qz7EyW": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Pure Shilajit. In Its Most Direct Form.",
            "icon": "none",
            "content": "<p>Pure shilajit resin dissolved in Himalayan spring water. No compression, no drying, no additional processing. Fulvic acid, 85+ trace minerals, and Dibenzo-α-Pyrones carried directly into liquid form — three drops, any time, done.<br/><br/>Under the tongue or mixed into any beverage. The format asks almost nothing of you.</p><ul><li>Three drops per serving — 0.2ml, precise every time</li><li>Sublingual option — held under the tongue for direct absorption</li><li>250 servings per 50ml bottle — over 8 months at once daily</li><li>Two ingredients only — nothing added to reach this form</li><li>Unflavored — the natural taste of pure shilajit in water</li></ul>",
            "page": ""
          }
        },
        "collapsible_tab_nXt8Qr": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "What the Resin Carries Into Every Drop",
            "icon": "none",
            "content": "<p>Each serving is 0.2ml — three drops of pure shilajit resin dissolved in Himalayan spring water. Other ingredients: none.</p><p><strong>Ingredients: </strong>Pure Himalayan Shilajit Resin, Himalayan Spring Water.</p><p>50ml bottle. 250 servings based on a 3-drop serving.</p><p>Full lab reports for this batch are available below.</p>",
            "page": ""
          }
        },
        "collapsible_tab_nmRL8A": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "What's in Every Drop. What Isn't.",
            "icon": "none",
            "content": "<p>Each serving is 0.2ml — three drops of pure shilajit resin dissolved in Himalayan spring water. Other ingredients: none.</p><p><strong>Ingredients: </strong>Pure Himalayan Shilajit Resin, Himalayan Spring Water.</p><p>50ml bottle. 250 servings based on a 3-drop serving.</p><p>Full lab reports for this batch are available below.</p>",
            "page": ""
          }
        },
        "collapsible_tab_NbxP3C": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Three Drops. Two Ways to Take It.",
            "icon": "none",
            "content": "<p>Take 3 drops once or twice daily.</p><p>Directly under the tongue — hold for 30 seconds before swallowing. Or mix into water, milk, or any beverage at room temperature. For sensitive stomachs, take with food and plenty of water.</p><p>Do not exceed the recommended dose. Consistency matters more than quantity.</p><p>Store in a cool, dry place away from direct sunlight. Keep out of reach of children. Consult a doctor before use if pregnant, nursing, or on any medication.</p>",
            "page": ""
          }
        },
