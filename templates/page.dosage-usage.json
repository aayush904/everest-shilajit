      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n.counter-list .contentside {\ngap:0;\n}\n.counter-list ol {\n  counter-reset: list;\n  display: flex;\n  flex-direction: column;\n  gap: 4rem;\n  margin-bottom: 4rem;\n  margin-top: 4rem;\nmargin-left:-2em;\n\n}\n.counter-list li {\n  counter-increment: list;\n  gap: 2.5rem;\n  display: flex;\n  text-align: left;\n  align-items: center;\n  margin:0;\n}\n\n.counter-list li:before {\n  content: \"0\"counter(list);\n  margin-right: 6px;\n  font-family:var(--font-body-family);\n  font-size:24px;\n  font-weight:800;\n  color:#fff;\n  border-radius:50%;\n  width:5rem;\n  height:5rem;\n  display:flex;\n  justify-content:center;\n  align-items:center;\n  aspect-ratio:1/1;\n  background:#000;\n}\n\n@media(max-width:768px){\n.counter-list {\n  ol {\n    margin-top: 24px;\n    margin-bottom: 24px;\ngap: 16px;\n  }\n  li {\n    gap: 12px;\n  }\n}\n</style>",
