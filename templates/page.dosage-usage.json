    "basmil_image_text_rqUaWM": {
      "type": "basmil-image-text",
      "blocks": {
        "content_bPhc3T": {
          "type": "content",
          "settings": {
            "title": "Liquid <brown>Everest Shilajit \n</brown>",
            "subtitle": "",
            "description": "<ol><li>Use a dropper lid that comes with the bottle</li><li>The liquid shilajit can be consumed with warm beverages, except tap water </li><li>Take it once or twice a day on an empty stomach </li></ol><p>For optimal absorption, mix liquid shilajit with warm beverages but avoid it with tap water. <strong>Hot milk and ghee </strong>are ideal choices since they enhance the potency of nutrients. Milk is a rich source of calcium, protein, and essential vitamins, while ghee contains healthy fats and fat-soluble vitamins (A, D, E, and K), so they also accelerate nutrient absorption. </p><p>Take it <strong>once or twice a day</strong> on an <strong>empty stomach</strong>, either in the morning or during the day. If it makes you hyperactive then it’s better you don’t consume it in thee evening, it might interfere with your sleep cycle.</p>",
            "button_text": "",
            "button_link": "",
            "button_text_2": "",
            "button_link_2": ""
          }
        },
