    "faq_fFAwqm": {
      "type": "faq",
      "blocks": {
        "text_XEPM9x": {
          "type": "text",
          "settings": {
            "question": "What is shilajit resin? ",
            "answer": "<p>A thick, tar-like substance rich in minerals and fulvic acid, formed from decomposed plant matter in the Himalayas.</p>"
          }
        },
        "text_bJtL4k": {
          "type": "text",
          "settings": {
            "question": "How to take shilajit resin? ",
            "answer": "<p>Dissolve a small amount (pea-sized) in warm water, milk, or tea and drink, except for tap water. </p>"
          }
        },
        "text_cU9Bya": {
          "type": "text",
          "settings": {
            "question": "How to use shilajit resin?",
            "answer": "<p>Take it in the morning or before meals or on empty stomach for better absorption. </p>"
          }
        },
        "text_B7TK9g": {
          "type": "text",
          "settings": {
            "question": "What is shilajit resin used for? ",
            "answer": "<p>Boosting energy, improving stamina, enhancing brain function, supporting immunity, and all in all wellness. </p>"
          }
        },
        "text_UzHYFV": {
          "type": "text",
          "settings": {
            "question": "How much shilajit resin per day?",
            "answer": "<p>300–500 mg (pea-sized amount) once or twice daily.</p>"
          }
        },
        "text_6JXXi9": {
          "type": "text",
          "settings": {
            "question": "What are the benefits of shilajit resin?",
            "answer": "<p>Increases energy, enhances brain function, supports testosterone levels, improves digestion, boosts immunity, and promotes anti-aging.</p>"
          }
        },
        "text_agHqcK": {
          "type": "text",
          "settings": {
            "question": "Is shilajit resin safe?",
            "answer": "<p>Yes, when taken in recommended doses. Avoid impure or untested products.</p>"
          }
        },
        "text_wCpPA7": {
          "type": "text",
          "settings": {
            "question": "How to mix shilajit resin?",
            "answer": "<p>Dissolve in warm water, milk, or tea until fully mixed.</p>"
          }
        },
        "text_zXwGBE": {
          "type": "text",
