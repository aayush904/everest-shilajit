        "custom_liquid_MaY6VG": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"badges\">\n<p style=\"margin-bottom: 2.4rem!important;\">Himalayan shilajit gummies — pure shilajit extract from Nepal's Everest region, above 18,000 ft, carried into a plant-based gummy. No artificial additives. No gelatin. No corn syrup. Two gummies a day. 639.73mg fulvic acid per serving, verified by Certified Laboratories.</p>\n\n<img \nstyle=\"max-width:100%;\" src=\"https://cdn.shopify.com/s/files/1/0673/4063/2201/files/badge.svg?v=1758621875\" alt=\"{{product.title}} badges\" width=\"455\" height=\"100\"/></div>\n\n<style>\nproduct-head{\norder:-1;\n}\n.badges{\norder:1;  \n}\n.collapsible_tabs{\norder:2;\n}\n.variant-selection{\norder:0;  \n}\n</style>"
          }
        },
