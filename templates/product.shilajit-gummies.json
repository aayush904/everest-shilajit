    "faq_fFAwqm": {
      "type": "faq",
      "blocks": {
        "text_XEPM9x": {
          "type": "text",
          "settings": {
            "question": "What are Pure Himalayan shilajit gummies?",
            "answer": "<p>Pure shilajit extract from Nepal's Everest region, carried into a plant-based gummy. Two gummies per day, 500mg of shilajit extract per serving, no artificial additives, no gelatin, no corn syrup. No preparation needed.</p>"
          }
        },
        "text_gkjBkw": {
          "type": "text",
          "settings": {
            "question": "Are these genuine pure shilajit gummies?",
            "answer": "<p><br/>Yes. The shilajit extract comes from Nepal's Everest region, above 18,000 ft, hand-collected by Skilled Sherpa collectors. Every batch independently tested by Certified Laboratories, accredited to ISO/IEC 17025:2017. <br/><br/></p>"
          }
        },
        "text_gDQ9Fy": {
          "type": "text",
          "settings": {
            "question": "What makes these the best shilajit gummies to buy?",
            "answer": "<p>Source, ingredients, and proof. The extract comes from a specific place — Everest region, Nepal, 18,000 ft. The gummy base contains no artificial additives, no gelatin, no corn syrup. Three independent lab reports per batch, all from Certified Laboratories, all on this page.</p>"
          }
        },
        "text_hbTCPq": {
          "type": "text",
          "settings": {
            "question": "How many shilajit gummies per day?",
            "answer": "<p>Two. One complete serving of 500mg shilajit extract. Do not exceed the recommended dose. Consistency matters more than quantity.</p>"
          }
        },
        "text_Fmdzq7": {
          "type": "text",
          "settings": {
            "question": "When is the best time to take shilajit gummies?",
            "answer": "<p>Any time of day that fits your routine. No water required. Morning works well for consistency — pick a time and keep it.</p>"
          }
        },
        "text_wU3PWJ": {
          "type": "text",
          "settings": {
            "question": "Are these shilajit gummies suitable for vegans?",
            "answer": "<p>Yes. Plant-based from extract to finish. No gelatin, no animal-derived ingredients of any kind.</p>"
          }
        },
        "text_tWHdpE": {
          "type": "text",
          "settings": {
            "question": "How long before I notice anything?",
            "answer": "<p>Most customers reach out somewhere between weeks three and ten. Pure Himalayan shilajit gummies work cumulatively. We recommend a minimum of 30 days before evaluating. Consistency is the only variable that matters.</p>"
          }
        }
      },
