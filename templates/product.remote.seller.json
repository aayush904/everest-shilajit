        "background_color": "#ffffff",
        "background_gradient": "",
        "background_on": "main_section",
        "background_position": "center",
        "background_size": "cover",
        "heading_color": "",
        "content_color": "#000000",
        "iconbox_style": "<style>\n#custom-icon-box{\n\n\n.iconbox:nth-child(1) {\n  background-color: #F5F2EC;\n  border-radius:8px;\n  padding:2.4rem;\n  position:relative;\n\n}\n.iconbox:nth-child(2) {\n  --custom-color: #aa8077;\n  margin-top: 8px;\n}\n.iconbox:nth-child(3) {\n  --custom-color: #A9523F;\n}\n.iconbox:nth-child(4) {\n  --custom-color: #8F5644;\n}\n.iconbox:nth-child(5) {\n  --custom-color: #68453D;\n  margin-bottom: 8px;\n}\n\n.iconbox-content:has(h3) {\n  width: 100%;\n}\n\n.button{\nbackground:#68453D;\ncolor:#ffffff;\nborder-radius:1rem;\n}\n\n}\n\n@media(max-width:980px){\n\n  #custom-icon-box.wrapper{\n    flex-direction: column!important;\npadding-top:24px!important;\n\n*{\ntext-align:start;\n}\n  \n.iconbox-content,.button{\nwidth:100%;\n}\n.button {\n  margin-top: -0.8px;\n}\n\nimg{\n  aspect-ratio:4/3;\n  object-fit:cover;\n  object-position:75%;\n  border-radius:16px;\n}\n}\n}\n\n</style>\n\n{%comment%}\n\n .iconbox-content:has(h3) h3 {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    cursor: pointer;\n  }\n\n  .iconbox-content:has(h3) h3::after {\n    content: \"+\";\n    font-size: 2.5rem;\n    transition: transform 0.3s ease;\n    margin-left: 8px;\n  }\n\n  .iconbox-content.active:has(h3) h3::after {\n    transform: rotate(-135deg);\n  }\n\n  .iconbox-content:has(h3) .description {\n    display: none;\n    margin-top: 0.5rem;\n  }\n\n  .iconbox-content.active:has(h3) .description {\n    display: block;\n  }\n<script defer>\n  document.addEventListener(\"DOMContentLoaded\", () => {\n    const allBoxes = document.querySelectorAll(\".iconbox-content\");\nallBoxes.forEach((box) => {\n\n    const heading = box.querySelector(\"h3\");\n    const desc = box.querySelector(\".description\");\n\n    if (heading && desc) {\n\nheading.addEventListener(\"click\", () => {\nallBoxes.forEach((other) => {\n          if (other !== box) {\n            other.classList.remove(\"active\");\n          }\n        });\n        box.classList.toggle(\"active\");\n;\n      });\n    }\n  });\n  });\n</script>{%endcomment%}"
