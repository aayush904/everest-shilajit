      "name": "Icon Box Section",
      "settings": {
        "heading_size": "h2",
        "section_title": "",
        "section_description": "<img src=\"https://cdn.shopify.com/s/files/1/0673/4063/2201/files/shilajit_open_banner._800x.webp?v=1758261555\">\n<p>Unique to Shilajit resin, fulvic acid and humic compounds deliver the highest potency. This traditional form is rich in trace minerals and antioxidants, supporting energy, focus, immunity, and overall vitality.</p>",
        "section_image_alt_text": "",
        "box_title_tag": "h3",
        "is_image_link": false,
        "icon_box_slider": "false",
        "content_iconbox_gap": "16px 5.6rem",
