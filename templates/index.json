    "basmil_image_text_b6z6fC": {
      "type": "basmil-image-text",
      "blocks": {
        "content_KDzkFd": {
          "type": "content",
          "settings": {
            "title": "When the Source Is Right. <br>The <brown>Process Becomes</brown> Simple",
            "subtitle": "",
            "description": "<p>A complex process usually means something is being fixed, balanced, or improved. Ours is simple because nothing needs fixing. Pure Shilajit from Nepal's untouched Everest region arrives at the facility as one ingredient, harvested by skilled Sherpa communities. It leaves as one ingredient. The steps in between exist only to remove what does not belong. </p><p>That simplicity is not a compromise. It is the result of getting the source right from the beginning. When the source is authentic, the process does not need to compensate for it.</p>",
            "button_text": "Our Story",
            "button_link": "https://everestshilajit.com/pages/about-us",
            "button_text_2": "",
            "button_link_2": ""
          }
        },
