        "content_V8jCbB": {
          "type": "content",
          "settings": {
            "title": "What Modern Research Has Found About Shilajit.",
            "subtitle": "<img style=\"width:100%; max-width:100%;\"src=\"https://cdn.shopify.com/s/files/1/0673/4063/2201/files/shilajit_wellness.svg\" alt=\"Shilajit Benifits\">\n<style> #goals { .contentside *{ text-align:start; } .contain-wrapper { justify-content: start; background: #f5f2ec; } h2 { order: 1; font-weight: 700; letter-spacing: 0%; } .subtitle { order: 2; display: block; width: 80%; } .contentside div { order: 3; } } </style>",
            "description": "<p>Modern research has examined shilajit's fulvic acid content, trace minerals, and Dibenzo-α-Pyrones in peer-reviewed studies. The science does not replace centuries of traditional use. It adds a layer of verification to what Himalayan communities already knew.</p>",
            "button_text": "",
