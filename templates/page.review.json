    "custom_liquid_bd7V8z": {
      "type": "custom-liquid",
      "custom_css": [
        ".jdgm-rev__prod-link-prefix,.jdgm-medals-wrapper,.jdgm-gallery,.jdgm-spinner {display: none !important;}",
        ".jdgm-rev__icon {font-size: 0;}",
        ".jdgm-all-reviews__summary {width: 30%;}",
        ".jdgm-write-rev-link {width: 30%; height: max-content; order: 1;}",
        ".jdgm-histogram {display: block; width: 40%;}",
        ".jdgm-all-reviews__header {display: flex; gap: 12px; align-items: center; margin-bottom: 24px;}",
        "#judgeme-all-reviews,#judgeme-widget-header {margin: 0 auto; max-width: 120rem !important; padding: 0 16px;}"
      ],
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<h2 class=\"max-w-max m-auto\" style=\"margin-bottom:2.8rem;\">Customer Reviews\n</h2>\n<div id=\"judgeme-widget-header\"></div>\n<div id=\"judgeme-all-reviews\"></div>\n<div id=\"judgeme-pagination\"></div>\n\n<script>\n  // --- Configuration Constants ---\n  const API_TOKEN = 'rSwUeNSgvhRm8EjGDkExBs4I_N0';\n  const SHOP_DOMAIN = 'sanoj333.myshopify.com';\n  const BASE_URL = 'https://judge.me/api/v1/widgets';\n  const REVIEWS_PER_PAGE = 5; // Number of reviews to display per page\n\n  // --- Global State Variables ---\n  let currentPage = 1;\n  let totalReviews = 0;\n\n  // --- Utility Functions ---\n\n  function executeScripts(container) {\n    container.querySelectorAll('script').forEach(oldScript => {\n      const newScript = document.createElement('script');\n      Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));\n      newScript.innerHTML = oldScript.innerHTML;\n      oldScript.replaceWith(newScript);\n    });\n  }\n\n\n  async function getTotalReviewsCount() {\n    try {\n      const res = await fetch(`https://api.judge.me/api/v1/widgets/all_reviews_count?api_token=${API_TOKEN}&shop_domain=${SHOP_DOMAIN}`);\n      if (!res.ok) {\n        throw new Error(`HTTP error! status: ${res.status}`);\n      }\n      const data = await res.json();\n      return data.all_reviews_count;\n    } catch (error) {\n      console.error('Error fetching total reviews count:', error);\n      return 0; // Return 0 on error to prevent division by zero\n    }\n  }\n\n\n  function renderPagination() {\n    const paginationContainer = document.getElementById('judgeme-pagination');\n    if (!paginationContainer) return; // Exit if container doesn't exist\n\n    paginationContainer.innerHTML = ''; // Clear previous pagination\n    const totalPages = Math.ceil(totalReviews / REVIEWS_PER_PAGE);\n\n    if (totalPages <= 1) {\n      return; // No pagination needed for 1 or fewer pages\n    }\n\n    let paginationHTML = '<ul>';\n\n    // --- Previous Button ---\n    paginationHTML += `<li class=\"${currentPage === 1 ? 'disabled' : ''}\">\n                          <a style=\"border:none;\" href=\"#\" data-page=\"${currentPage - 1}\" aria-label=\"Previous Page\">‹</a>\n                       </li>`;\n\n    // --- Page Numbers Logic (e.g., < 1 2 3 ... 6 >) ---\n    const maxVisiblePages = 3; // Number of page buttons to show around the current page, excluding first/last/ellipses\n\n    if (totalPages <= maxVisiblePages + 2) { // If total pages are few, show all numbers directly\n      for (let i = 1; i <= totalPages; i++) {\n        paginationHTML += `<li class=\"${i === currentPage ? 'active' : ''}\">\n                              <a  href=\"#\" data-page=\"${i}\" aria-label=\"Page ${i}\">${i}</a>\n                           </li>`;\n      }\n    } else { // More pages, use ellipsis\n      // Always show first page\n      paginationHTML += `<li class=\"${1 === currentPage ? 'active' : ''}\">\n                            <a href=\"#\" data-page=\"1\" aria-label=\"Page 1\">1</a>\n                         </li>`;\n\n      if (currentPage > maxVisiblePages - 1 && currentPage < totalPages - (maxVisiblePages - 2)) {\n        // Case 1: Current page is in the middle, show ellipsis at both ends\n        paginationHTML += `<li class=\"ellipsis\"><span>...</span></li>`;\n        for (let i = currentPage - 1; i <= currentPage + 1; i++) {\n          paginationHTML += `<li class=\"${i === currentPage ? 'active' : ''}\">\n                                    <a href=\"#\" data-page=\"${i}\" aria-label=\"Page ${i}\">${i}</a>\n                                 </li>`;\n        }\n        paginationHTML += `<li class=\"ellipsis\"><span>...</span></li>`;\n      } else if (currentPage <= maxVisiblePages) {\n        // Case 2: Current page is near the beginning\n        for (let i = 2; i <= maxVisiblePages + 1; i++) { // Show 2, 3, 4, ...\n          paginationHTML += `<li class=\"${i === currentPage ? 'active' : ''}\">\n                                  <a href=\"#\" data-page=\"${i}\" aria-label=\"Page ${i}\">${i}</a>\n                               </li>`;\n        }\n        paginationHTML += `<li class=\"ellipsis\"><span>...</span></li>`;\n      } else {\n        // Case 3: Current page is near the end\n        paginationHTML += `<li class=\"ellipsis\"><span>...</span></li>`;\n        for (let i = totalPages - maxVisiblePages; i < totalPages; i++) { // Show ..., total-2, total-1\n          paginationHTML += `<li class=\"${i === currentPage ? 'active' : ''}\">\n                                  <a href=\"#\" data-page=\"${i}\" aria-label=\"Page ${i}\">${i}</a>\n                               </li>`;\n        }\n      }\n\n      // Always show last page\n      if (totalPages !== 1) { // Avoid showing last page twice if totalPages is 1\n        paginationHTML += `<li class=\"${totalPages === currentPage ? 'active' : ''}\">\n                              <a href=\"#\" data-page=\"${totalPages}\" aria-label=\"Page ${totalPages}\">${totalPages}</a>\n                           </li>`;\n      }\n    }\n\n    // --- Next Button ---\n    paginationHTML += `<li class=\"${currentPage === totalPages ? 'disabled' : ''}\">\n                          <a style=\"border:none;\" href=\"#\" data-page=\"${currentPage + 1}\" aria-label=\"Next Page\">›</a>\n                       </li>`;\n\n    paginationHTML += '</ul>';\n    paginationContainer.innerHTML = paginationHTML;\n\n    // --- Add Event Listeners to Pagination Links ---\n    paginationContainer.querySelectorAll('a').forEach(link => {\n      link.addEventListener('click', (e) => {\n        e.preventDefault(); // *** CRITICAL: Prevents the page from scrolling to the top ***\n        const page = parseInt(e.target.dataset.page);\n\n        // Only proceed if the page number is valid, different from current, and within bounds\n        if (!isNaN(page) && page !== currentPage && page >= 1 && page <= totalPages) {\n          currentPage = page;\n          loadJudgeMeReviews(); // Reload reviews for the new page\n          // Optional: Scroll to the reviews container after loading new reviews\n          // document.getElementById('judgeme-all-reviews').scrollIntoView({ behavior: 'smooth' });\n        }\n      });\n    });\n  }\n\n  /**\n   * Main function to load Judge.me reviews and manage pagination.\n   */\n  async function loadJudgeMeReviews() {\n    try {\n      // 1. Fetch total reviews count if not already done (only on first load)\n      if (totalReviews === 0) {\n        totalReviews = await getTotalReviewsCount();\n        if (totalReviews === 0) {\n          document.getElementById('judgeme-all-reviews').innerHTML = '<p>No reviews available.</p>';\n          renderPagination(); // Still call to clear any old pagination if count is 0\n          return;\n        }\n      }\n\n      // 2. Fetch reviews for the current page\n      const res = await fetch(`${BASE_URL}/all_reviews_page?api_token=${API_TOKEN}&shop_domain=${SHOP_DOMAIN}&page=${currentPage}&per_page=${REVIEWS_PER_PAGE}`);\n      if (!res.ok) {\n        throw new Error(`HTTP error! status: ${res.status}`);\n      }\n      const data = await res.json();\n\n      // 3. Load reviews header\n      const headerContainer = document.getElementById('judgeme-widget-header');\n      if (headerContainer && data.all_reviews_header) {\n        headerContainer.innerHTML = data.all_reviews_header;\n        executeScripts(headerContainer);\n      }\n\n      // 4. Load reviews content\n      const reviewsContainer = document.getElementById('judgeme-all-reviews');\n      if (reviewsContainer && data.all_reviews) {\n        reviewsContainer.innerHTML = data.all_reviews;\n        executeScripts(reviewsContainer);\n      } else if (reviewsContainer) {\n        reviewsContainer.innerHTML = '<p>Unable to load reviews for this page.</p>';\n      }\n\n      // 5. Render (or re-render) pagination after reviews are loaded\n      renderPagination();\n\n      // 6. Initialize Judge.me widgets (their scripts might need to run after content is in DOM)\n      const waitForJudgeMe = (callback, maxAttempts = 100) => {\n        let attempts = 0;\n        const interval = setInterval(() => {\n          attempts++;\n          if (window.jdgm) {\n            clearInterval(interval);\n            if (typeof window.jdgm.customWidget === 'function') {\n              window.jdgm.customWidget();\n            } else {\n              console.warn('Judge.me jdgm.customWidget function not found.');\n            }\n          } else if (attempts >= maxAttempts) {\n            clearInterval(interval);\n            console.warn('Judge.me (jdgm) object not found after max attempts.');\n          }\n        }, 100);\n      };\n      waitForJudgeMe();\n\n    } catch (error) {\n      console.error('Error loading Judge.me reviews:', error);\n      const reviewsContainer = document.getElementById('judgeme-all-reviews');\n      if (reviewsContainer) {\n        reviewsContainer.innerHTML = '<p>Unable to load reviews. Please try again later.</p>';\n      }\n      renderPagination(); // Attempt to render pagination even on error, might show nothing\n    }\n  }\n\n  // --- Initialize when DOM is ready ---\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', loadJudgeMeReviews);\n  } else {\n    loadJudgeMeReviews(); // DOM is already loaded\n  }\n</script>\n\n<style>\n  /* Basic styling for the pagination - customize as needed */\n  #judgeme-pagination ul {\n    list-style: none;\n    padding: 0;\n    margin: 20px 0;\n    /* Add some margin above/below pagination */\n    display: flex;\n    flex-wrap: wrap;\n    /* Allow items to wrap on smaller screens */\n    justify-content: center;\n    font-family: sans-serif;\n  }\n\n  #judgeme-pagination li {\n    margin: 0 4px;\n    /* Slightly reduced margin for tighter look */\n  }\n\n  #judgeme-pagination li a,\n  #judgeme-pagination li span {\n    display: block;\n    padding: 8px 12px;\n    border: 1px solid #68453d;\n    text-decoration: none;\n    color: #333;\n    border-radius: 4px;\n    transition: background-color 0.2s ease-in-out, border-color 0.2s ease-in-out, color 0.2s ease-in-out;\n    min-width: 30px;\n    /* Ensure buttons have a minimum width */\n    text-align: center;\n  }\n\n  #judgeme-pagination li a:hover:not(.active) {\n    background-color: #f0f0f0;\n    border-color: #bbb;\n  }\n\n  #judgeme-pagination li.active a {\n    background: #68453d66;\n    color: #68453d;\n    border-color: #68453d;\n    cursor: default;\n    /* Indicate it's the current page */\n  }\n\n  #judgeme-pagination li.disabled a,\n  #judgeme-pagination li.disabled span {\n    color: #ccc;\n    pointer-events: none;\n    /* Disable click events */\n    border-color: #eee;\n    opacity: 0.5;\n  }\n\n  #judgeme-pagination li.ellipsis span {\n    border: none;\n    background-color: transparent;\n    cursor: default;\n    padding: 8px 4px;\n    /* Adjust padding for ellipsis */\n  }\n\n  @media(max-width:768px){\n      .jdgm-histogram,.jdgm-all-reviews__summary,.jdgm-write-rev-link{\n    width: 90% !important;\n  }\n        .jdgm-all-reviews__header {\n    flex-direction:column!important;\n  }\n  }\n</style>\n\n\n\n\n<style>\n  .jdgm-write-rev-link {\n    display: inline-block !important;\n  }\n\n  .review-popup-overlay {\n    display: none;\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: rgba(0, 0, 0, 0.5);\n    z-index: 9999;\n    justify-content: center;\n    align-items: center;\n  }\n\n  .review-popup-overlay.active {\n    display: flex;\n  }\n\n  .review-popup {\n    background: white;\n    border-radius: 8px;\n    padding: 30px;\n    max-width: 500px;\n    width: 90%;\n    max-height: 90vh;\n    overflow-y: auto;\n    position: relative;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);\n  }\n\n  .review-popup-close {\n    position: absolute;\n    top: 15px;\n    right: 15px;\n    font-size: 28px;\n    font-weight: bold;\n    color: #999;\n    cursor: pointer;\n    background: none;\n    border: none;\n    line-height: 1;\n  }\n\n  .review-popup-close:hover {\n    color: #333;\n  }\n\n  .review-popup h2 {\n    margin-top: 0;\n    margin-bottom: 20px;\n    font-size: 24px;\n  }\n\n  .review-form-group {\n    margin-bottom: 20px;\n  }\n\n  .review-form-group label {\n    display: block;\n    margin-bottom: 5px;\n    font-weight: 600;\n    color: #333;\n    font-size: 1.6rem;\n  }\n\n  .review-form-group input,\n  .review-form-group select,\n  .review-form-group textarea {\n    width: 100%;\n    padding: 10px;\n    border: 1px solid #ddd;\n    border-radius: 4px;\n    font-size: 14px;\n    box-sizing: border-box;\n  }\n\n  .review-form-group textarea {\n    min-height: 100px;\n    resize: vertical;\n  }\n\n  .review-form-group select {\n    cursor: pointer;\n  }\n\n  .review-rating {\n    display: flex;\n    gap: 5px;\n    margin-top: 5px;\n  }\n\n  .review-star {\n    font-size: 30px;\n    cursor: pointer;\n    color: #ddd;\n    transition: color 0.2s;\n  }\n\n  .review-star:hover,\n  .review-star.active {\n    color: #ffc107;\n  }\n\n  .review-file-input {\n    padding: 8px;\n  }\n\n  .review-submit-btn {\n    width: 100%;\n    padding: 12px;\n    background: #000;\n    color: white;\n    border: none;\n    border-radius: 4px;\n    font-size: 16px;\n    font-weight: 600;\n    cursor: pointer;\n    transition: background 0.3s;\n  }\n\n  .review-submit-btn:hover {\n    background: #333;\n  }\n\n  .review-submit-btn:disabled {\n    background: #ccc;\n    cursor: not-allowed;\n  }\n\n  .review-message {\n    padding: 10px;\n    margin-bottom: 15px;\n    border-radius: 4px;\n    display: none;\n  }\n\n  .review-message.success {\n    background: #d4edda;\n    color: #155724;\n    border: 1px solid #c3e6cb;\n  }\n\n  .review-message.error {\n    background: #f8d7da;\n    color: #721c24;\n    border: 1px solid #f5c6cb;\n  }\n\n  .review-message.active {\n    display: block;\n  }\n\n  .required {\n    color: red;\n  }\n</style>\n\n<!-- Review Popup HTML -->\n<div class=\"review-popup-overlay\" id=\"reviewPopup\">\n  <div class=\"review-popup\">\n    <button class=\"review-popup-close\" onclick=\"closeReviewPopup()\">&times;</button>\n    <h2>Write a Review</h2>\n\n    <div class=\"review-message\" id=\"reviewMessage\"></div>\n\n    <form id=\"reviewForm\">\n      <div class=\"review-form-group\">\n        <label for=\"reviewProduct\">Select Product <span class=\"required\">*</span></label>\n        <select id=\"reviewProduct\" name=\"product\" required>\n          <option value=\"\">-- Select a Product --</option>\n          {% for product in collections.all.products limit: 50 %}\n          <option value=\"{{ product.id }}\" data-handle=\"{{ product.handle }}\">\n            {{ product.title }}\n          </option>\n          {% endfor %}\n        </select>\n      </div>\n\n      <div class=\"review-form-group\">\n        <label for=\"reviewName\">Your Name <span class=\"required\">*</span></label>\n        <input type=\"text\" id=\"reviewName\" name=\"name\" required placeholder=\"Enter your name\">\n      </div>\n\n      <div class=\"review-form-group\">\n        <label for=\"reviewEmail\">Your Email <span class=\"required\">*</span></label>\n        <input type=\"email\" id=\"reviewEmail\" name=\"email\" required placeholder=\"Enter your email\">\n      </div>\n\n      <div class=\"review-form-group\">\n        <label>Rating <span class=\"required\">*</span></label>\n        <div class=\"review-rating\" id=\"reviewRating\">\n          <span class=\"review-star\" data-rating=\"1\">★</span>\n          <span class=\"review-star\" data-rating=\"2\">★</span>\n          <span class=\"review-star\" data-rating=\"3\">★</span>\n          <span class=\"review-star\" data-rating=\"4\">★</span>\n          <span class=\"review-star\" data-rating=\"5\">★</span>\n        </div>\n        <input type=\"hidden\" id=\"reviewRatingValue\" name=\"rating\" required>\n      </div>\n\n      <div class=\"review-form-group\">\n        <label for=\"reviewTitle\">Review Title <span class=\"required\">*</span></label>\n        <input type=\"text\" id=\"reviewTitle\" name=\"title\" required placeholder=\"Give your review a title\">\n      </div>\n\n      <div class=\"review-form-group\">\n        <label for=\"reviewBody\">Review <span class=\"required\">*</span></label>\n        <textarea id=\"reviewBody\" name=\"body\" required placeholder=\"Write your review here...\"></textarea>\n      </div>\n\n      <!-- <div class=\"review-form-group\">\n        <label for=\"reviewPicture\">Upload Picture (Optional)</label>\n        <input type=\"file\" name=\"media\" class=\"jdgm-media-fieldset__input\" multiple=\"\" accept=\"image/gif,image/jpeg,image/jpg,image/png,image/webp\" aria-label=\"Choose a review picture/video (optional)\">\n        <input type=\"file\" id=\"reviewPicture\" name=\"picture\" accept=\"image/*\" class=\"review-file-input\">\n      </div> -->\n\n      <button type=\"submit\" class=\"review-submit-btn\" id=\"reviewSubmitBtn\">Submit Review</button>\n    </form>\n  </div>\n</div>\n\n<script>\n  // Get shop domain\n  const shopDomain = \"{{ shop.permanent_domain }}\";\n\n  // Open popup when write review button is clicked\n  document.addEventListener('click', function (e) {\n    if (e.target.classList.contains('jdgm-write-rev-link') ||\n      e.target.closest('.jdgm-write-rev-link')) {\n      e.preventDefault();\n      openReviewPopup();\n    }\n  });\n\n  function openReviewPopup() {\n    document.getElementById('reviewPopup').classList.add('active');\n    document.body.style.overflow = 'hidden';\n  }\n\n  function closeReviewPopup() {\n    document.getElementById('reviewPopup').classList.remove('active');\n    document.body.style.overflow = '';\n    document.getElementById('reviewForm').reset();\n    document.querySelectorAll('.review-star').forEach(star => star.classList.remove('active'));\n    hideMessage();\n  }\n\n  // Close popup when clicking outside\n  document.getElementById('reviewPopup').addEventListener('click', function (e) {\n    if (e.target === this) {\n      closeReviewPopup();\n    }\n  });\n\n  // Star rating functionality\n  const stars = document.querySelectorAll('.review-star');\n  const ratingInput = document.getElementById('reviewRatingValue');\n\n  stars.forEach(star => {\n    star.addEventListener('click', function () {\n      const rating = this.getAttribute('data-rating');\n      ratingInput.value = rating;\n\n      stars.forEach(s => {\n        if (s.getAttribute('data-rating') <= rating) {\n          s.classList.add('active');\n        } else {\n          s.classList.remove('active');\n        }\n      });\n    });\n\n    star.addEventListener('mouseenter', function () {\n      const rating = this.getAttribute('data-rating');\n      stars.forEach(s => {\n        if (s.getAttribute('data-rating') <= rating) {\n          s.style.color = '#ffc107';\n        } else {\n          s.style.color = '#ddd';\n        }\n      });\n    });\n  });\n\n  document.getElementById('reviewRating').addEventListener('mouseleave', function () {\n    const currentRating = ratingInput.value;\n    stars.forEach(s => {\n      if (currentRating && s.getAttribute('data-rating') <= currentRating) {\n        s.style.color = '#ffc107';\n      } else {\n        s.style.color = '#ddd';\n      }\n    });\n  });\n\n  // Form submission\n  document.getElementById('reviewForm').addEventListener('submit', async function (e) {\n    e.preventDefault();\n\n    const submitBtn = document.getElementById('reviewSubmitBtn');\n    const productSelect = document.getElementById('reviewProduct');\n    const selectedOption = productSelect.options[productSelect.selectedIndex];\n\n    if (!ratingInput.value) {\n      showMessage('Please select a rating', 'error');\n      return;\n    }\n\n    submitBtn.disabled = true;\n    submitBtn.textContent = 'Submitting...';\n\n    // Create FormData\n    const formData = new FormData();\n    formData.append(\"url\", shopDomain);\n    formData.append(\"shop_domain\", shopDomain);\n    formData.append(\"platform\", \"shopify\");\n    formData.append(\"name\", document.getElementById('reviewName').value);\n    formData.append(\"email\", document.getElementById('reviewEmail').value);\n    formData.append(\"rating\", ratingInput.value);\n    formData.append(\"title\", document.getElementById('reviewTitle').value);\n    formData.append(\"body\", document.getElementById('reviewBody').value);\n    formData.append(\"id\", selectedOption.value);\n\n    // Add picture if uploaded\n    const pictureInput = document.getElementById('reviewPicture');\n    if (pictureInput.files[0]) {\n      formData.append(\"picture_keys[0]\", pictureInput.files[0]);\n    }\n\n    try {\n      const response = await fetch(\"https://api.judge.me/api/v1/reviews\", {\n        method: \"POST\",\n        headers: {\n          \"accept\": \"*/*\",\n          \"origin\": \"https://\" + shopDomain,\n          \"referer\": \"https://\" + shopDomain + \"/\"\n        },\n        body: formData\n      });\n\n      if (response.status === 201) {\n        const data = await response.json();\n        showMessage('Review submitted successfully! Thank you for your feedback.', 'success');\n        setTimeout(() => {\n          closeReviewPopup();\n        }, 2000);\n      } else {\n        throw new Error('Failed to submit review');\n      }\n\n    } catch (error) {\n      console.error('Error:', error);\n      showMessage('Failed to submit review. Please try again.', 'error');\n    } finally {\n      submitBtn.disabled = false;\n      submitBtn.textContent = 'Submit Review';\n    }\n  });\n\n  function showMessage(message, type) {\n    const messageEl = document.getElementById('reviewMessage');\n    messageEl.textContent = message;\n    messageEl.className = 'review-message ' + type + ' active';\n  }\n\n  function hideMessage() {\n    const messageEl = document.getElementById('reviewMessage');\n    messageEl.className = 'review-message';\n  }\n</script>",
