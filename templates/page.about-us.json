    "basmil_image_text_YGJgwt": {
      "type": "basmil-image-text",
      "blocks": {
        "content_z4YcVE": {
          "type": "content",
          "settings": {
            "title": "Supporting The <brown>Local Communities</brown>",
            "subtitle": "OUR MISSION",
            "description": "<p>Our support to the local communities goes beyond sourcing the raw shilajit, each jar of shilajit sold directly contributes to the livelihoods of the sourcing communities, creating a sustainable source of income and preserving the himalayan region environment.</p><p>Once dearly guarded by the Indigenous community, our shilajit is carefully harvested, bottled, and packed in Nepal, with perfection shining through every step, from the mountains. </p><p>With a mission to bring Nepali shilajit to the world, we are redefining the industry by introducing one of nature’s rarest and most meticulously harvested mineral sources. We respect their culture, traditions, and way of living.</p>",
            "button_text": "",
            "button_link": "",
            "button_text_2": "",
            "button_link_2": ""
          }
        },
