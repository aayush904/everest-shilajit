      }

      .upload-progress {
        width: 100%;
        height: 5px;
        background-color: #f0f0f0;
        margin-top: 10px;
        border-radius: 5px;
        overflow: hidden;
        display: none;
      }

      .upload-progress-bar {
        height: 100%;
