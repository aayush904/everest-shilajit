      }

      input, select, textarea {
        width: 100%;
        padding: 10px;
        border: 1px solid #D4CDCD;
        font-size: 14px;

        &&:hover {
          border-color: #888;
        }
      }

      input:focus, select:focus, textarea:focus {
        outline: none;
      }

      *:focus-visible {
        outline: none;
        outline-offset: 0rem;
        border: none;
      }

      select {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        background-color: transparent;
        appearance: none; /* Remove default arrow */
        -webkit-appearance: none; /* Remove default arrow for Safari */
        -moz-appearance: none; /* Remove default arrow for Firefox */
        cursor: pointer;
      }

      select option[disabled]:checked {
        color: grey;
      }

      /* Black text color for other options */
      select option {
        color: black;
      }

      /* Custom dropdown arrow */
      .select::after {
        content: "";
        position: absolute;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        width: 0;
        height: 0;
        border-left: 6px solid transparent;
        border-right: 6px solid transparent;
        border-top: 6px solid grey; /* Grey arrow */
        pointer-events: none; /* Ensure clicks pass through to the select element */
      }

      /* Hover and focus styles */
      select

      select:focus {
        outline: none;
        border-color: #555;
        box-shadow: 0 0 5px rgba(85, 85, 85, 0.3);
      }

      textarea {
        min-height: 100px;
        resize: vertical;
      }

      .file-upload-section {
        border: 1px solid #D4CDCD;
        padding: 10px;
        text-align: center;
        cursor: pointer;
        width: 100%;
        height: auto;
        min-height: 230px;
        box-sizing: border-box;
        position: relative;
      }

      .file-upload-wrapper {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin: 30px;
        height: auto;
      }

      .file-upload-wrapper input[type="file"] {
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        width: 100%;
        height: 100%;
        cursor: pointer;
      }

      .file-placeholder {
        display: block;
