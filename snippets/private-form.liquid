<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('private-label-enquiryForm');
    const submitButton = form.querySelector('button');
    const responseMessage = document.getElementById('responseMessage');
    const fileInput = document.getElementById('fileUpload');
    const maxFileSizeMB = 10;
    let datafile = null;

    const showError = (input, message) => {
      const error = input.nextElementSibling;
      input.parentElement.style.position = 'relative';
      error.style.fontSize = '1rem';
      error.style.color = '#ef4444';
      error.style.position = 'absolute';
      error.style.top = `${input.offsetHeight + 2}px`;
      error.style.left = '0';
      error.textContent = message;
      error.style.display = 'block';
    };

    const hideError = (input) => {
      const error = input.nextElementSibling;
      error.style.display = 'none';
    };

    const validateField = (input) => {
      if (!input.value.trim() && input.required) {
        showError(input, `${input.name} is required`);
      } else if (input.type === 'email' && !/\S+@\S+\.\S+/.test(input.value)) {
        showError(input, 'A valid email is required');
      } else if (input.type === 'url' && !/^https?:\/\/.+\..+/.test(input.value)) {
        showError(input, 'A valid URL is required');
      } else if (input.type === 'tel' && !/^\d{10,}$/.test(input.value)) {
        // Phone validation
        showError(input, 'A valid phone number is required (at least 10 digits)');
      } else {
        hideError(input);
      }
    };

    const inputs = form.querySelectorAll("input:not([type='hidden']),select");
    inputs.forEach((input) => {
      input.addEventListener('input', () => validateField(input));
      input.addEventListener('blur', () => validateField(input));
    });

    // Simulated upload progress bar animation
    function simulateUploadProgress(progressBar, callback) {
      let width = 0;
      const interval = setInterval(() => {
        if (width >= 100) {
          clearInterval(interval);
          callback();
        } else {
          width += 10;
          progressBar.style.width = width + '%';
        }
      }, 150);
    }

    // Handle file upload progress UI when a file is selected
    const progressBar = form.querySelector('.upload-progress-bar');
    const uploadCompleteMsg = form.querySelector('.upload-complete');
    const uploadProgress = form.querySelector('.upload-progress');

    fileInput.addEventListener('change', function () {
      if (fileInput.files.length > 0) {
        // Show progress bar
        uploadProgress.style.display = 'block';
        uploadCompleteMsg.style.display = 'none';
        progressBar.style.width = '0%';
        
        const file = fileInput.files[0]
        const allowedTypes = ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'];
        if (!allowedTypes.includes(file.type)) {
          showError(fileInput, "Invalid file type. Only PDF, JPEG, PNG, and WebP files are allowed.");
          return;
        }else{
          hideError(fileInput);
        }

        simulateUploadProgress(progressBar, () => {
          uploadCompleteMsg.style.display = 'block';
          progressBar.style.width = '0%';
        });

        // Update file placeholder text
        const fileName = file.name;
        const filePlaceholder = form.querySelector('.file-placeholder');
        if (filePlaceholder) {
          filePlaceholder.textContent = fileName;
        }

        if (file) {
          // Check file size
          const fileSizeMB = file.size / (1024 * 1024); // Convert bytes to MB
          if (fileSizeMB > maxFileSizeMB) {
            showError(fileInput, `File size exceeds ${maxFileSizeMB}MB limit.`);
            return;
          }
        }

        const reader = new FileReader();
        reader.onload = function () {
          const base64File = reader.result.split(',')[1];
          datafile = {
            filename: file.name,
            filetype: file.type,
            filedata: base64File
          };
        };
        reader.readAsDataURL(file);
      } else {
      uploadProgress.style.display = 'none';
      uploadCompleteMsg.style.display = 'none';
      progressBar.style.width = '0%';
      // Reset file placeholder
      const filePlaceholder = form.querySelector('.file-placeholder');
      if (filePlaceholder) {
        filePlaceholder.textContent = 'Choose a file';
      }
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      let isValid = true;
      inputs.forEach((input) => {
        validateField(input);
        if (input.nextElementSibling.style.display === 'block') {
          isValid = false;
        }
      });

      if (!isValid) return;

      
      const captchaResponse = grecaptcha.getResponse();
      if (!captchaResponse) {
        responseMessage.textContent = 'Please complete the reCAPTCHA challenge.';
        responseMessage.className = 'message error';
        responseMessage.style.display = 'block';
        throw new Error('Please complete the reCAPTCHA challenge.');
        return;
      } 
      

      submitButton.disabled = true;
      submitButton.textContent = 'Submitting...';

      const data = Object.fromEntries(formData.entries());
      data.fileUpload = datafile; 
console.log(data);
      // Example AJAX POST (replace URL with your endpoint)
      try {
        const response = await fetch('https://api.medicinalmadhoney.com', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        submitButton.innerHTML = 'Submit';
        submitButton.disabled = false;

        if (response.ok) {
          responseMessage.textContent = 'Form submitted successfully!';
          responseMessage.className = 'message success';
        } else {
          const errorData = await response.json();
          responseMessage.textContent = `Error: ${errorData.error || 'Failed to submit form.'}`;
          responseMessage.className = 'message error';
        }

        if (typeof grecaptcha !== 'undefined') {
          grecaptcha.reset();
        }
      } catch (err) {
        alert('There was an error submitting the form. Please try again later.');
        console.error(err);

        submitButton.disabled = false;
        submitButton.textContent = 'Submit';
        responseMessage.textContent = 'An error occurred. Please try again later.';
        responseMessage.className = 'message error';
      }
      responseMessage.style.display = 'block';

      setTimeout(() => {
        responseMessage.style.display = 'none';
      }, 3000);
    });
  });
</script>
