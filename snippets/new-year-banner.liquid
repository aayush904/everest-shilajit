<style>
        .pop-container {
          --bg: #EDE7C7;
          --label: #4b3a2f;
          --digit: #AF0C07;
        }


     red{
    color:var(--digit);
    }
        .pop-container .countdown {
          display: flex;
          justify-content: center;
          align-items: center;
          flex-wrap: wrap;
          width: 100%;
          margin: 17px auto;
          --gap: clamp(8px,0.9vw,16px);
          gap: var(--gap);
        }

        .pop-container .unit {
          display: flex;
          gap: var(--gap);
          align-items: stretch;
          width: 45%;
        }

        .pop-container .digit-box {
          width: calc(50% - var(--gap)/2);
          height: auto;
          aspect-ratio: 65/80;
          background: #FFFBE5;
          border-radius: 10px;
          display: flex;
          flex-direction: column;
          justify-content: space-evenly;
          align-items: center;
        }

        .pop-container .label {
          font-size: clamp(8px,0.8vw,12px);
          color: var(--label);
        }

        .pop-container .digit {
          font-size: clamp(32px,3.6vw,45px);
          font-weight: 400;
          color: var(--digit);
          line-height: 0.75;
        }

        .pop-container .is-hidden {
          display: none;
        }

        .pop-container {
          display: flex;
          justify-content: space-between;
          padding: 16px;
          background: #FFFBE5;
          gap: 12px;
          max-width: 1277px;
          overflow:hidden;
        }

        .pop_banner {
          width: 65.6%;
          padding:0!important;
        }

        .pop_content {
          width: 33.42%;
          position: relative;
          padding: 6% 0 0 0;
          display: flex;
          background:var(--bg);
          flex-direction: column;
          justify-content:space-between;
          align-items: center;
          border-radius:16px;
          overflow:hidden;
        }

        .pop_star {
          width: 13.5%;
          position: absolute;
          right: -18px;
          top: 26%;
        }

        .pop_button {
          width: 71%;
          background: #FFE100;
          margin: 0 auto;
          margin-top: 4.3%;
          padding: clamp(12px,1.4vw,16px);
          border:none;
          display: flex;
          align-items: center;
          justify-content: center;
          text-decoration: none;
          color: #3A2307;
          border-radius: 32px;
          box-shadow: 0px 2px 5px 0px #0000000D, 0px 9px 9px 0px #0000000A, 0px 20px 12px 0px #00000008, 0px 35px 14px 0px #00000003,
            0px 55px 15px 0px #00000000;
          font-size:clamp(12px,1.4vw,16px)!important;
          line-height:1;
        }

        .pop_button:hover {
          background: #FFE100!important;
            opacity:0.9;
        }

        .pop_bottombg{
          position:absolute;
          bottom:0;
          left:50%;
          transform:translateX(-50%);
          width:150%;
          height:auto;
        }

        .pop_content img{
      padding:0!important;}

      .pop_countdown_wrapper{
      background:#ffffff;
          padding:clamp(8px,1vw,16px) clamp(12px, 1.4vw,20px);
          border-radius:16px;
          margin: 5.7% auto;
          display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

  }
      .pop_content_head{
       max-width:80%;
       margin:0 auto;
      }

      .pop-container p{
        font-size:clamp(10px,1.2vw,16px);
        font-family:var(--font-body-family);
        font-weight:400;
    }
    .pop_content_footer{
        width:100%;
        font-size:clamp(12px,1.4vw,16px);
        background:#EF4000;
        display:flex;
        justify-content:center;
        align-items:center;
        padding:clamp(4px,0.8vw,16px);
        color:#ffffff;
    }
        @media(max-width:980px){
        .pop-container .countdown{
          --gap: 10px;
          }
        }
          @media(max-width:768px){
            #popupOverlay .close-button.close-button{
                background:transparent!important;
                box-shadow:none!important;
                right:16px!important;
                top:8px!important;
                }

          .pop-container{
            max-width:416px;
            width:80vw;
            height:auto;
            max-height:95dvh;
            aspect-ratio:493.28/739.56;
            padding:0;
          }

          .countdown{
          --gap: 12px;
          }

          .pop_banner{
            display:none;
          }
                    .pop_content_head{
                      padding-top:6%;
        max-width:70%;
        }
          .pop_content{
            width:100%;
                        max-width:416px;

          }
        }

          @media(max-width:500px){
            .pop-container{
              max-width:95vw;
            }


            
                .unit{
            width: 45%;
          }

                .countdown{
          --gap: 8px;
          }
        }
</style>
