{% comment %}
  Renders an article card.

  Accepts:
  - article: {Object} Article object (required)
  - show_image: {Boolean} Show article image. Default: true
  - show_date: {Boolean} Show article date
  - show_author: {Boolean} Show article author
  - show_excerpt: {Boolean} Show article excerpt
  - show_badge: {Boolean} Show blog badge
  - lazy_load: {Boolean} Lazy load image. Default: true
  - style: {String} 'video' | 'video_featured' | 'horizontal' | default vertical
  - video_counter: {Number} Pass 0 for the first video to inject modal markup
  - media_height: {String} Image height setting
  - media_aspect_ratio: {Number} Image aspect ratio

  Usage:
  {% render 'article-card', article: article, show_image: true, show_date: true %}
{% endcomment %}

{%- if article and article != empty -%}
  {%- comment -%} ── Resolve YouTube ID & thumbnail ── {%- endcomment -%}
  {%- assign youtube_id = blank -%}
  {%- assign youtube_thumb = blank -%}
  {%- assign vc = article.content -%}

  {%- if vc contains 'youtube.com/embed/' -%}
    {%- assign youtube_id = vc
      | split: 'youtube.com/embed/'
      | last
      | split: '"'
      | first
      | split: "'"
      | first
      | split: '?'
      | first
      | split: '&'
      | first
    -%}
  {%- elsif vc contains 'youtube.com/watch?v=' -%}
    {%- assign youtube_id = vc
      | split: 'youtube.com/watch?v='
      | last
      | split: '"'
      | first
      | split: "'"
      | first
      | split: '&'
      | first
    -%}
  {%- elsif vc contains 'youtu.be/' -%}
    {%- assign youtube_id = vc
      | split: 'youtu.be/'
      | last
      | split: '"'
      | first
      | split: "'"
      | first
      | split: '?'
      | first
      | split: '&'
      | first
    -%}
  {%- endif -%}

  {%- if youtube_id != blank -%}
    {%- assign youtube_thumb = 'https://img.youtube.com/vi/' | append: youtube_id | append: '/hqdefault.jpg' -%}
  {%- endif -%}

  {%- comment -%} ── Determine card variant ── {%- endcomment -%}
  {%- assign is_video_featured = false -%}
  {%- assign is_video = false -%}
  {%- if style == 'video_featured' -%}
    {%- assign is_video_featured = true -%}
  {%- elsif style == 'video' -%}
    {%- assign is_video = true -%}
  {%- endif -%}

  {%- assign is_publication = false -%}
  {%- if style == 'publication' -%}
    {%- assign is_publication = true -%}
  {%- endif -%}
  {%- comment -%}
    ════════════════════════════════════════════════
        VARIANT A — FEATURED VIDEO  (horizontal layout)
    ════════════════════════════════════════════════
  {%- endcomment -%}
  {%- if is_video_featured -%}
    <div
      class="ac-featured-video"
      id="ac-trigger-{{ article.id }}"
      onclick="acOpenModal(this)"
      data-article="{{ article.content | escape }}"
      style="cursor:pointer;"
    >
      <div class="ac-featured-video__media">
        {%- if article.image != blank -%}
          {{
            article.image
            | image_url: width: 1600
            | image_tag:
              class: 'ac-featured-video__img',
              loading: 'lazy',
              widths: '480,720,960,1200,1600',
              alt: article.image.alt
            | default: article.title
          }}
        {%- elsif youtube_thumb != blank -%}
          <img
            src="{{ youtube_thumb }}"
            alt="{{ article.title | escape }}"
            class="ac-featured-video__img"
            loading="lazy"
            width="1200"
            height="675"
          >
        {%- endif -%}
        <span class="ac-play-btn ac-play-btn--lg" aria-hidden="true">
          <svg width="18" height="22" viewBox="0 0 18 22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M17 11L1 1.5V20.5L17 11Z" fill="white" stroke="white" stroke-width="1.2" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>

      <div class="ac-featured-video__body">
        <div>
          {%- if blog.title != blank -%}
            <p class="ac-featured-video__tag">Documentary</p>
          {%- elsif article.tags.size > 0 -%}
            <p class="ac-featured-video__tag">{{ article.tags.first }}</p>
          {%- endif -%}
          <h3 class="ac-featured-video__title">{{ article.title | escape }}</h3>

          {%- if article.excerpt != blank -%}
            <p class="ac-featured-video__excerpt">{{ article.excerpt | strip_html | truncate: 220 }}</p>
          {%- elsif article.content != blank -%}
            <p class="ac-featured-video__excerpt">{{ article.content | strip_html | truncate: 220 }}</p>
          {%- endif -%}
        </div>

        <button class="ac-featured-video__cta" type="button">
          <span class="ac-play-btn ac-play-btn--sm" aria-hidden="true">
            <svg width="9" height="11" viewBox="0 0 9 11" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8.5 5.5L1 1V10L8.5 5.5Z" fill="white"/>
            </svg>
          </span>
          {{ section.settings.video_cta_label | default: 'Play video' }}
          {%- render 'icon-link' -%}
        </button>
      </div>
    </div>

    {%- comment -%}
      ════════════════════════════════════════════════
          VARIANT B — VIDEO GRID CARD
      ════════════════════════════════════════════════
    {%- endcomment -%}
  {%- elsif is_video -%}
    <div
      class="ac-card ac-card--video"
      id="ac-trigger-{{ article.id }}"
      onclick="acOpenModal(this)"
      data-article="{{ article.content | escape }}"
      data-modal-id="ac-modal-{{ blog.id }}"
      style="cursor:pointer;"
    >
      <div class="ac-card__media">
        {%- if youtube_thumb != blank -%}
          <img
            src="{{ youtube_thumb }}"
            alt="{{ article.title | escape }}"
            class="ac-card__img"
            loading="lazy"
            width="800"
            height="450"
          >
        {%- elsif article.image != blank -%}
          {{
            article.image
            | image_url: width: 900
            | image_tag: class: 'ac-card__img', loading: 'lazy', widths: '200,300,400,500', alt: article.image.alt
            | default: article.title
          }}
        {%- endif -%}
        <span class="ac-play-btn ac-play-btn--md" aria-hidden="true">
          <svg width="14" height="17" viewBox="0 0 14 17" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13 8.5L1 1.5V15.5L13 8.5Z" fill="white" stroke="white" stroke-width="1" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>

      <div class="ac-card__body">
        <h3 class="ac-card__title">{{ article.title | escape }}</h3>
      </div>
    </div>

    {%- comment -%}
      ════════════════════════════════════════════════
          VARIANT C — DEFAULT / BLOG CARD  (vertical)
      ════════════════════════════════════════════════
    {%- endcomment -%}

  {%- elsif is_publication -%}
    <article class="resources-hub__publication-row">
      <div class="resources-hub__publication-title-wrap">
        <h3 class="resources-hub__publication-title">
          <a href="{{ article.url }}">{{ article.title }}</a>
        </h3>
      </div>

      <div class="resources-hub__publication-date">
        {%- if show_date and article.published_at -%}
          {{ article.published_at | date: format: 'abbreviated_date' }}
        {%- endif -%}
      </div>

      <div class="resources-hub__publication-action">
        <a
          class="resources-hub__publication-link"
          href="{{ article.url }}"
          aria-label="{{ article.title | escape }}"
        >
          {%- render 'icon-link' -%}
        </a>
      </div>
    </article>
  {%- else -%}
    <a href="{{ article.url }}" class="ac-card ac-card--default" aria-label="{{ article.title | escape }}">
      {%- if show_image != false and article.image != blank -%}
        <div class="ac-card__media">
          {{
            article.image
            | image_url: width: 600
            | image_tag:
              class: 'ac-card__img',
              loading: 'lazy',
              widths: '200,300,400,500,600',
              sizes: '(min-width: 1280px) calc(100vw / 3 - 10px), (min-width: 768px) calc(50vw - 16px), 100vw',
              width: article.image.width,
              height: article.image.height,
              alt: article.image.alt
          }}
        </div>
      {%- endif -%}

      <div class="ac-card__body">
        <div class="ac-card__meta">
          {%- if article.tags.size > 0 -%}
            <span class="ac-card__tag">{{ article.tags.first }}</span>
          {%- endif -%}
          {%- if show_date and article.published_at -%}
            <span class="ac-card__date">{{ article.published_at | date: '%b %d, %Y' }}</span>
          {%- endif -%}
        </div>

        <h3 class="ac-card__title">{{ article.title | escape }}</h3>

        {% comment %}
          {%- if show_excerpt -%}
            {%- if article.excerpt != blank -%}
              <p class="ac-card__excerpt">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
            {%- elsif article.content != blank -%}
              <p class="ac-card__excerpt">{{ article.content | strip_html | truncatewords: 20 }}</p>
            {%- endif -%}
          {%- endif -%}
        {% endcomment %}

        {%- if show_author -%}
          <div class="ac-card__footer">
            <span>{{ article.metafields.custom.author_name.value | default: article.author }}</span>
          </div>
        {%- endif -%}
      </div>
    </a>
  {%- endif -%}

  {%- comment -%} ── Video modal (injected once per blog, when video_counter == 0) ── {%- endcomment -%}
  {%- if is_video or is_video_featured -%}
    {%- if video_counter == 0 -%}
      <div
        id="ac-modal-{{ blog.id }}"
        class="ac-modal-overlay"
        onclick="acCloseModal('{{ blog.id }}')"
      >
        <div class="ac-modal-box" onclick="event.stopPropagation()">
          <button class="ac-modal-close" onclick="acCloseModal('{{ blog.id }}')" aria-label="Close">&times;</button>
          <div id="ac-modal-body-{{ blog.id }}" class="ac-modal-body"></div>
        </div>
      </div>

      <script>
        function acOpenModal(el) {
          var modalId = el.dataset.modalId || 'ac-modal-{{ blog.id }}';
          var bodyId = 'ac-modal-body-{{ blog.id }}';
          document.getElementById(bodyId).innerHTML = el.dataset.article;
          document.getElementById(modalId).classList.add('ac-modal--active');
          document.body.style.overflow = 'hidden';
        }
        function acCloseModal(blogId) {
          var modalId = 'ac-modal-' + blogId;
          var bodyId = 'ac-modal-body-' + blogId;
          document.getElementById(modalId).classList.remove('ac-modal--active');
          document.getElementById(bodyId).innerHTML = '';
          document.body.style.overflow = '';
        }
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') acCloseModal('{{ blog.id }}');
        });
      </script>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
