<style>
  .damage-form-container {
    max-width: 65.2rem;
    margin: 0 auto;
    padding: 20px;
  }
  /* h2 {
          font-size: 1.8rem;
          margin-bottom: 15px;
          color: #382E2A;
          font-weight: 500;
          font-family: "var(--font-body-family)", sans-serif;
      } */

  .damage-form-group {
    margin-bottom: 15px;
    position: relative;
    && div {
      position: relative;
      max-width: calc(50% - 8px);
    }
  }

  label {
    font-size: 1.4rem;
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
    font-family: 'Sans Serif Collection', sans-serif;
    color: #5c5f6a;
    font-weight: 500;
    position: relative;
  }
  placeholder {
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 2.2rem;
    font-family: 'Sans Serif Collection';
  }

  input[type='text'],
  input[type='email'],
  input[type='file'],
  textarea {
    width: 100%;
    padding: 10px;
    margin-bottom: 5px;
    border: 1px solid #d4cdcd;
    box-shadow: none;
  }

  *:focus-visible {
    outline: none;
    outline-offset: 0rem;
    box-shadow: none;
  }

  textarea {
    resize: vertical;
    height: auto;
    min-height: 15rem;
  }

  button {
    width: 30%;
    padding: 10px;
    background-color: #68453d;
    color: #fff;
    border: none;
    cursor: pointer;
  }

  button:hover {
    background-color: #54382f;
  }

  .damage-file-info {
    font-size: 1.2rem;
    color: #777;
  }

  .damage-note {
    margin-top: 2rem;
    font-size: 1.6rem;
    color: #5c5f6a;
    margin-bottom: 2rem;
  }

  .damage-note strong {
    color: #f3aa48;
  }

  .damage-note a {
    color: #0073e6;
    text-decoration: none;
  }

  .damage-note a:hover {
    text-decoration: underline;
  }
  .half-width {
    display: flex;
    flex-wrap: wrap;
    /* flex-direction: row; */
    gap: 12px;
    max-width: 61.2rem;
    width: 100%;
    position: relative;
  }
  .damage-first-name,
  .damage-last-name {
    flex: 1;
    min-width: 30rem;
  }
  .damage-submit {
    font-size: 1.8rem;
    height: 6rem;
    float: right;
    margin-bottom: 2rem;
    margin-top: 4rem;
  }
  .damage-delivery-date {
    flex: 1;
    min-width: 30rem;
  }
  .damage-shipping-address {
    flex: 1;
    min-width: 30rem;
  }
  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .modal-content {
    background-color: white;
    padding: 30px;
    border-radius: 8px;
    max-width: 500px;
    text-align: center;
    position: relative;
  }

  .close-button {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 24px;
    cursor: pointer;
    color: #68453d;
    background: none;
    border: none;
    width: auto;
    padding: 5px 10px;
  }

  .modal img {
    width: 60px;
    height: 60px;
    margin-bottom: 20px;
  }

  .modal h3 {
    color: #68453d;
    font-size: 2rem;
    margin-bottom: 15px;
    font-family: var(--font-body-family), sans-serif;
  }

  .modal p {
    color: #5c5f6a;
    font-size: 1.4rem;
    margin-bottom: 15px;
    font-family: 'Sans Serif Collection', sans-serif;
    line-height: 1.6;
  }

  .modal button.ok-button {
    width: 120px;
    margin-top: 20px;
    height: 40px;
    font-size: 1.6rem;
  }

  .leaf-decoration {
    position: absolute;
    width: 100px;
    opacity: 0.2;
  }

  .leaf-left {
    position: absolute;
    left: 0px;
    top: 30px;
  }
  @media (max-width: 768px) {
    .damage-form-group.half-width {
      && div {
        max-width: 100%;
        width: 100%;
      }
    }
    label {
      text-align: left;
    }
  }
</style>

<div class="damage-form-container">
  <h4>Contact Information</h4>
  <form action="#" method="POST">
    <!-- Contact Information -->
    <div class="damage-form-group half-width">
      <div>
        <label class="damage-first-name" for="first-name">First Name <span style="color: #F36719;">*</span> </label>
        <input type="text" id="first-name" name="first-name" placeholder="First Name" required>
      </div>
      <div>
        <label class="damage-last-name" for="last-name">Last Name <span style="color: #F36719;">*</span> </label>
        <input type="text" id="last-name" name="last-name" placeholder="Last Name" required>
      </div>
    </div>
    <div class="damage-form-group">
      <label for="email">Email <span style="color: #F36719;">*</span> </label>
      <input type="email" id="email" name="email" placeholder="Email" required>
    </div>
    <div class="damage-form-group">
      <label for="order-id">Order ID <span style="color: #F36719;">*</span> </label>
      <input type="text" id="order-id" name="order-id" placeholder="Other Id" required>
    </div>

    <!-- Additional Information -->
    <h4>Parcel Details</h4>

    <div class="damage-form-group half-width">
      <div>
        <label class="damage-delivery-date" for="delivery-date"
          >Expected Delivery Delivery<span style="color: #F36719;">*</span>
        </label>
        <input type="text" id="delivery-date" name="delivery-date" placeholder="Date" required>
      </div>
      <div>
        <label class="damage-shipping-address" for="shipping-address"
          >Shipping Address <span style="color: #F36719;">*</span>
        </label>
        <input type="text" id="shipping-address" name="shipping-address" placeholder="Address" required>
      </div>
    </div>

    <div class="damage-form-group">
      <label for="comments">Comments?</label>
      <textarea id="comments" name="comments" placeholder="Comments"></textarea>
    </div>

    <hr style="border: none; border-top: 1px solid #D4CDCD; margin: 20px 0;">

    <!-- Note -->
    <p class="damage-note">
      <strong>NOTE:</strong> If you do not receive a response within 24 hours, please contact our customer service team
      directly at <a href="mailto:contact@everestshilajit.com">contact@everestshilajit.com</a>.
    </p>

    <!-- Submit -->
    <button class="damage-submit" type="submit">Submit</button>
  </form>
  <div id="successModal" class="modal" style="display: none;">
    <div class="modal-content">
      <button class="close-button">&times;</button>
