  <div class="final-note"><span class="highlight">1.4 mg</span> per pound of body weight once or twice daily.</div>
</div>

<script>
  const adultsTab = document.getElementById('adults-tab');
  const petsTab = document.getElementById('pets-tab');
  const plantTab = document.getElementById('plant-tab');

  const ageInput = document.getElementById('age');
  ageInput.addEventListener('input', () => {
    const activeTab = adultsTab.classList.contains('active')
      ? 'adult'
      : petsTab.classList.contains('active')
      ? 'pet'
      : 'plant';
    calculateDosage(activeTab);
  });

  function showAllFields() {
    document.getElementById('weight').style.display = '';
    document.querySelector('label[for="weight"]').style.display = '';
    const healthLabel = document.querySelector('label[for="health"]');
    healthLabel.textContent = 'Health';
    const healthSelect = document.getElementById('health');
    healthSelect.innerHTML = `
                <option value="general_wellness">General Wellness</option>
                <option value="chronic_fatigue">Chronic Fatigue</option>
                <option value="recovery">Recovery</option>
                <option value="athletic_performance">Athletic Performance</option>
                <option value="cognitive_function">Cognitive Function</option>
            `;
  }

  function showPetFields() {
    const healthLabel = document.querySelector('label[for="health"]');
    healthLabel.textContent = 'Animal';
    const healthSelect = document.getElementById('health');
    healthSelect.innerHTML = `
                <option value="dogs">Dogs</option>
                <option value="cats">Cats</option>
                <option value="horses">Horses</option>
                <option value="cattle">Cattle</option>
            `;
    // Initially hide weight field
    document.getElementById('weight').style.display = 'none';
    document.querySelector('label[for="weight"]').style.display = 'none';

    // Show weight if dogs is selected
    if (healthSelect.value === 'dogs') {
      document.getElementById('weight').style.display = '';
      document.querySelector('label[for="weight"]').style.display = '';
    }
  }

  adultsTab.addEventListener('click', () => {
    adultsTab.classList.add('active');
    petsTab.classList.remove('active');
    plantTab.classList.remove('active');
    showAllFields();
    calculateDosage('adult');
  });

  petsTab.addEventListener('click', () => {
    petsTab.classList.add('active');
    adultsTab.classList.remove('active');
    plantTab.classList.remove('active');
    showPetFields();
    calculateDosage('pet');
  });

  plantTab.addEventListener('click', () => {
    plantTab.classList.add('active');
    adultsTab.classList.remove('active');
    petsTab.classList.remove('active');

    document.getElementById('age').value = 25;
    document.getElementById('weight').value = 62;
    document.getElementById('weight').style.display = 'none';
    document.querySelector('label[for="weight"]').style.display = 'none';

    const healthLabel = document.querySelector('label[for="health"]');
    healthLabel.textContent = 'Size';
    const healthSelect = document.getElementById('health');
    healthSelect.innerHTML = `
                <option id="small" value="small" selected>Small</option>
                <option id="medium" value="medium">Medium</option>
                <option id="large" value="large">Large</option>
            `;

    calculateDosage('plant');
  });

  const weightInput = document.getElementById('weight');
  const healthInput = document.getElementById('health');
  const dropsElement = document.getElementById('drops');
  const resinElement = document.getElementById('resin');
  const madhoneyElement = document.getElementById('madhoney');

  // Add event listener for animal type change
  healthInput.addEventListener('change', function () {
    if (petsTab.classList.contains('active')) {
      if (this.value === 'dogs') {
        document.getElementById('weight').style.display = '';
        document.querySelector('label[for="weight"]').style.display = '';
      } else {
        document.getElementById('weight').style.display = 'none';
        document.querySelector('label[for="weight"]').style.display = 'none';
      }
    }
    const activeTab = adultsTab.classList.contains('active')
      ? 'adult'
      : petsTab.classList.contains('active')
      ? 'pet'
      : 'plant';
    calculateDosage(activeTab);
  });

  function calculateDosage(type) {
    const weight = parseFloat(weightInput.value);
    const health = healthInput.value;
    if (!isNaN(weight)) {
      let dosage, drops, resin, madhoney;
      if (type === 'pet') {
        switch (health) {
          case 'dogs':
            if (weight <= 10) {
              resin = '50-100';
              drops = '1-2';
              madhoney = '2-3';
            } else if (weight <= 30) {
              resin = '100-200';
              drops = '2-3';
              madhoney = '3-5';
            } else {
              resin = '200-300';
              drops = '3-4';
              madhoney = '4-6';
            }
            break;
          case 'cats':
            resin = '50-100';
            drops = '1-2';
            madhoney = '2-3';
            break;
          case 'horses':
            resin = '1000-2000';
            drops = '8-12';
            madhoney = '5-7';
            break;
          case 'cattle':
            resin = '2000-3000';
            drops = '5-8';
            madhoney = '5-7';
            break;
        }
      } else if (type === 'plant') {
        if (health === 'small') {
          dosage = 1;
          drops = 3;
          resin = 200;
          madhoney = 5;
        } else if (health === 'medium') {
          dosage = 2;
          drops = 5;
          resin = '300-500';
          madhoney = 8;
        } else if (health === 'large') {
          dosage = 3;
          drops = 8;
          resin = '1000-2000';
          madhoney = 12;
        }
      } else if (type === 'adult') {
        // [Rest of the adult calculation code remains exactly the same]
        const age = parseInt(document.getElementById('age').value);
        let resinMin, resinMax, dropsMin, dropsMax, madhoneyMin, madhoneyMax;

        if (age < 18) {
          const finalNote = document.querySelector('.final-note');
          finalNote.innerHTML =
            'We do not recommend dosage for individuals under 18. Please consult a medical professional.';
          finalNote.style.display = 'block';
          dropsElement.textContent = '0';
          resinElement.textContent = '0';
          madhoneyElement.textContent = '0';
          document.querySelector('.dosage-row').style.display = 'none';
          weightInput.addEventListener('input', resetFinalNote);
          healthInput.addEventListener('change', resetFinalNote);
          return;
        } else {
          document.querySelector('.dosage-row').style.display = 'flex';
          const finalNote = document.querySelector('.final-note');
          finalNote.innerHTML = '<span class="highlight">1.4 mg</span> per pound of body weight once or twice daily.';
          finalNote.style.display = 'block';
        }

        if (age >= 18 && age <= 30) {
          resinMin = 300;
          resinMax = 500;
          dropsMin = 2;
          dropsMax = 3;
          madhoneyMin = 3;
          madhoneyMax = 4;
        } else if (age >= 31 && age <= 50) {
          resinMin = 400;
          resinMax = 600;
          dropsMin = 3;
          dropsMax = 5;
          madhoneyMin = 4;
          madhoneyMax = 6;
        } else {
          resinMin = 500;
          resinMax = 700;
          dropsMin = 4;
          dropsMax = 5;
          madhoneyMin = 5;
          madhoneyMax = 6;
        }

        if (weight >= 40 && weight <= 60) {
          resinMin += 250;
          resinMax += 400;
          dropsMin += 2;
          dropsMax += 4;
          madhoneyMin += 3;
          madhoneyMax += 4;
        } else if (weight > 60 && weight <= 80) {
          resinMin += 400;
          resinMax += 600;
          dropsMin += 4;
          dropsMax += 6;
          madhoneyMin += 4;
          madhoneyMax += 6;
        } else {
          resinMin += 500;
          resinMax += 700;
          dropsMin += 5;
          dropsMax += 7;
          madhoneyMin += 5;
          madhoneyMax += 7;
        }

        switch (health) {
          case 'general_wellness':
            resinMin += 300;
            resinMax += 500;
            madhoneyMin += 3;
            madhoneyMax += 4;
            break;
          case 'chronic_fatigue':
            resinMin += 500;
            resinMax += 700;
            dropsMin += 5;
            dropsMax += 7;
            madhoneyMin += 4;
            madhoneyMax += 6;
            break;
          case 'recovery':
            resinMin += 600;
            resinMax += 800;
            dropsMin += 6;
            dropsMax += 8;
            madhoneyMin += 4;
            madhoneyMax += 7;
            break;
          case 'athletic_performance':
            resinMin += 500;
            resinMax += 800;
            dropsMin += 5;
            dropsMax += 8;
            madhoneyMin += 5;
            madhoneyMax += 8;
            break;
          case 'cognitive_function':
            resinMin += 400;
            resinMax += 600;
            dropsMin += 4;
            dropsMax += 6;
            madhoneyMin += 4;
            madhoneyMax += 5;
            break;
          default:
            break;
        }

        resin = Math.round((resinMin + resinMax) / (2 * 3));
        drops = Math.round((dropsMin + dropsMax) / (2 * 3));
        madhoney = Math.round((madhoneyMin + madhoneyMax) / (2 * 3));

        if (health === 'bad' || health === 'worst') {
          drops = Math.ceil(drops / 2);
          resin = Math.ceil(resin / 2);
        }
      }
      dropsElement.textContent = drops;
      resinElement.textContent = resin;
      madhoneyElement.textContent = madhoney;
    } else {
      dropsElement.textContent = '0';
      resinElement.textContent = '0';
      madhoneyElement.textContent = '0';
    }
  }

  weightInput.addEventListener('input', () => {
    const activeTab = adultsTab.classList.contains('active')
      ? 'adult'
      : petsTab.classList.contains('active')
      ? 'pet'
      : 'plant';
    calculateDosage(activeTab);
  });

  calculateDosage('adult');
</script>
