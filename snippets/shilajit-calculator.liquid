      <div class="dosage-item">
        <div class="icon-container">
          <svg width="35" height="45" viewBox="0 0 35 45" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_3231_15924)">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M23.6458 13.1199H22.7631V9.01366C22.7631 8.7132 22.5016 8.44613 22.2073 8.44613H19.69V2.23672C19.69 1.00152 18.7093 0 17.4996 0C16.29 0 15.3093 1.00152 15.3093 2.23672V8.44613H12.7919C12.4977 8.44613 12.2362 8.7132 12.2362 9.01366V13.1199H11.3535C10.9285 13.1199 10.6016 13.4537 10.6016 13.8877V15.8907C10.6016 16.3247 10.9285 16.6586 11.3535 16.6586H23.6458C24.0708 16.6586 24.3977 16.3247 24.3977 15.8907V13.8877C24.3977 13.4537 24.0708 13.1199 23.6458 13.1199Z" fill="#866A64"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M21.9788 18.5949V16.6252H13.0538V18.5949C10.7 19.5296 9 21.8331 9 24.5706V41.6298C9 42.9318 10.0135 43.9667 11.2885 43.9667H23.7442C25.0192 43.9667 26.0327 42.9318 26.0327 41.6298V24.5706C26.0327 21.8331 24.3654 19.4963 21.9788 18.5949Z" fill="#866A64"/>
