<style>
  p {
    font-weight: 400;
  }
  .container {
    background-color: #f5eadd;
    width: 100%;
    max-width: 584px;
    height: auto;
    max-height: 531px;
    padding: 24px;
  }

  .tabs {
    display: flex;
    border-bottom: 2px solid #e0d7c6;
    margin-bottom: 24px;
  }

  .tab {
    flex: 1;
    padding: 12px;
    text-align: center;
    cursor: pointer;
    font-weight: 600;
    color: #382E2A;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-direction: column;
  }

  .tab.active {
    color: #d49a5f;
    border-bottom: 2px solid #d49a5f;
    margin-bottom: -2px;
    flex-direction: column;
  }
  .tab svg {
    color: #866a64;
  }

  .tab.active svg {
    color: #f3aa48;
  }
  .tab.active.p {
    font-family: 'Sans Serif Collection', sans-serif;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
  }
  .tab-icon {
    width: 20px;
    height: 20px;
  }

  .form-row {
    display: flex;
    gap: 20px;
    margin-bottom: 24px;
  }

  .form-group {
    flex: 1;
  }

  .form-group label {
    display: block;
    color: #382E2A;
    margin-bottom: 6px;
  }
  *:focus-visible {
    box-shadow: none;
    outline-offset: 0;
    outline: none;
  }
  .form-group input,
  .form-group select {
    width: 100%;
    padding: 10px;
    border: none;
    border-bottom: 1px solid #d9cab8;
    border-radius: 0;
    font-size: 16px;
    outline: none;
    background-color: transparent;
  }

  .form-group input p,
  .form-group select p {
    font-family: 'Sans Serif Collection', sans-serif;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
  }

  .dosage-result {
    margin-top: 24px;
  }

  .dosage-result h3 {
    font-size: 20px;
    margin-bottom: 16px;
    color: #382E2A;
  }
  .label p {
    font-family: var(--font-body-family), sans-serif;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
  }
  .dosage-row {
    display: flex;
    gap: 2rem;
    margin-top: 16px;
  }

  .dosage-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content:center;
    gap: 12px;
    padding: 0;
    background-color: transparent;
    border-radius: 8px;
  }

  .icon-container {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-container svg {
    width: 35px;
    height: auto;
    fill: #d49a5f;
    align-items: center;
  }

  .highlight {
    color: #68453d;
    font-weight: bold;
  }
  .droopdoown {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    justify-content: center;
    margin: 0 auto;

    div:not(.dropss){
      letter-spacing:0;
      width:max-content;
    }
  }
  .dropss {
    display: flex;
    gap: 4px;
    justify-content: center;
  }
  .final-note {
    background-color: #fff9f2;
    padding: 16px;
    border-radius: 8px;
    margin-top: 16px;
    text-align: center;
    color: #68453d;
  }
  .dosage__svg {
    align-items: center;
  }

  @media (max-width: 768px) {
    .container {
      padding: 16px;
      height: auto;
      max-height: fit-content;
    }
    .form-row,
    .dosage-row {
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 8px;
    }

    .dosage-item {
      width: 100%;
    }

  }
</style>

