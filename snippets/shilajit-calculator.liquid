      <div class="dosage-item">
        <div class="icon-container">
          <svg width="35" height="45" viewBox="0 0 35 45" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M32.2912 45.0001H1.8308C0.821992 45.0001 0 44.1875 0 43.1693V23.8899C0 22.8811 0.821992 22.0591 1.8308 22.0591H32.2912C33.3 22.0591 34.122 22.8811 34.122 23.8899V43.1693C34.122 44.1875 33.3 45.0001 32.2912 45.0001Z" fill="#866A64"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M30.7242 21.4919H3.40234V20.7259C3.40234 20.3149 3.73861 19.9786 4.14961 19.9786H29.9676C30.3786 19.9786 30.7149 20.3149 30.7149 20.7259V21.4919H30.7242Z" fill="#866A64"/>
            <path d="M18.6761 23.181L19.4047 22.0508H17.6019L17.3964 22.4151C15.2387 21.537 12.7166 22.3217 11.5023 24.3673C10.1573 26.6278 9.5501 31.84 11.8293 33.2037C14.1084 34.5675 18.4145 31.5504 19.7596 29.2993C20.9739 27.263 20.4695 24.6662 18.6761 23.181ZM30.8378 1.34219C30.0812 0.893831 29.2499 0.88449 28.9883 1.32351L17.9101 21.4903H19.769L31.7345 2.95815C31.9961 2.51913 31.6038 1.79055 30.8378 1.34219Z" fill="#866A64"/>
