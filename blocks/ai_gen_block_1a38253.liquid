{% doc %}
  @prompt
    make a section to make a full width image banner section with just a h1 title in center and image will be half cropped in mobile i.e width will be 180% around and object fit will be cover., Dont add the shadow in the title. Instead making the image position absolute make the content side absolute
    
    , for desktop instead make the min heiight dynamical but for max-height make it adjustable with the image ratio(making image full width and height auto change) but for the mobile make the image center fit max-width of 375px
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    min-height: {{ block.settings.banner_min_height_desktop }}px;
  }

  .ai-banner-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: auto;
  }

  .ai-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-banner-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    min-height: {{ block.settings.banner_min_height_desktop }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-banner-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-banner-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .ai-banner-title-{{ ai_gen_id }} {
    margin: 0;
    padding: 0 20px;
    font-size: {{ block.settings.title_size_desktop }}px;
    color: {{ block.settings.title_color }};
    text-align: center;
    max-width: 100%;
    word-wrap: break-word;
  }

  @media screen and (max-width: 749px) {
    .ai-banner-{{ ai_gen_id }} {
      min-height: auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ai-banner-image-wrapper-{{ ai_gen_id }} {
      max-width: 375px;
      margin: 0 auto;
    }

    .ai-banner-image-{{ ai_gen_id }} {
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    .ai-banner-image-placeholder-{{ ai_gen_id }} {
      min-height: 300px;
      max-width: 375px;
      margin: 0 auto;
    }

    .ai-banner-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-banner ai-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-banner-image-wrapper ai-banner-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.banner_image %}
      <img
        src="{{ block.settings.banner_image | image_url: width: 2000 }}"
        alt="{{ block.settings.banner_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.banner_image.width }}"
        height="{{ block.settings.banner_image.height }}"
        class="ai-banner-image ai-banner-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-banner-image-placeholder ai-banner-image-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-banner-content ai-banner-content-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h1 class="ai-banner-title ai-banner-title-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Full width banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Full Width Banner"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "banner_min_height_desktop",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Minimum height",
      "default": 400
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Full width banner"
    }
  ]
}
{% endschema %}
